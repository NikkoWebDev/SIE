# Vyntra Backend — Environment Variables
# Copy this file to .env and fill in your values

# JWT (REQUIRED — change to a strong random string in production)
JWT_SECRET=change-this-to-a-strong-random-secret

# Supabase (REQUIRED)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# OpenRouter AI API Keys
OPENROUTER_STUDENT_KEY=sk-or-v1-your-student-key
OPENROUTER_TEACHER_KEY=sk-or-v1-your-teacher-key
OPENROUTER_ADMIN_KEY=sk-or-v1-your-admin-key

# Cloudinary (for MD file storage — AI agent reads from here)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google Drive (for original file storage)
GOOGLE_DRIVE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# Google OAuth (for teacher sign-in)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Supabase Auth (for password recovery + Google OAuth)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Optional overrides
JWT_ALGORITHM=HS256
TOKEN_EXPIRY_HOURS=8
OPENROUTER_MODEL=openrouter/free
