# ════════════════════════════════════════════════════════════════
# VYNTRA Academic — Environment Variables Template
# ════════════════════════════════════════════════════════════════
# INSTRUCCIONES DE SEGURIDAD:
# 1. Copia este archivo como `.env` — NUNCA lo edites directamente
# 2. Genera claves fuertes: `openssl rand -hex 32` para JWT_SECRET
# 3. .env está en .gitignore — verifica que NO se suba al repositorio
# 4. Rota (cambia) todas las claves inmediatamente si sospechas exposición
# 5. Usa claves diferentes para desarrollo y producción
# ════════════════════════════════════════════════════════════════

# ── JWT (REQUIRED) ────────────────────────────────────────────
# Genera con: openssl rand -hex 32
JWT_SECRET=change-this-to-a-strong-random-secret-min-32-chars

# ── Supabase (REQUIRED) ───────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# anon key — público, but RLS restricts access
SUPABASE_ANON_KEY=your-anon-key
# service role key — PRIVADO, solo para el backend. Nunca expongas al cliente
SUPABASE_SERVICE_KEY=your-service-role-key

# ── OpenRouter AI API Keys ────────────────────────────────────
# Cada rol usa una key diferente para aislamiento y rate limiting
OPENROUTER_STUDENT_KEY=sk-or-v1-your-student-key
OPENROUTER_TEACHER_KEY=sk-or-v1-your-teacher-key
OPENROUTER_ADMIN_KEY=sk-or-v1-your-admin-key

# ── Cloudinary (file storage) ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Google Drive (teacher material storage) ──────────────────
# Option A: inline JSON env var (use with caution — may leak in logs)
GOOGLE_DRIVE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
# Option B: file path (recommended — JSON too large for env var)
# GOOGLE_DRIVE_CREDENTIALS_FILE=backend/_secrets/service-account.json
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# ── Google OAuth (teacher sign-in) ────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Frontend: same value, define in Netlify UI or .env.local
# PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Sentry (error tracking — optional) ────────────────────────
# SENTRY_DSN=https://xxx@xxx.ingest.us.sentry.io/xxxxxx

# ── Optional overrides with safe defaults ─────────────────────
TOKEN_EXPIRY_HOURS=8
OPENROUTER_MODEL=openrouter/free

# ── Security locks — deshabilitar solo en emergencia ──────────
# ENABLE_RAW_SQL_QUERIES=false

# ── Configuración de auditoría ────────────────────────────────
# AUDIT_LOG_LEVEL=INFO
