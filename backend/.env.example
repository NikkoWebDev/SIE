# Vyntra Backend — Environment Variables
# Copy this file to .env and fill in your values

# JWT (REQUIRED — change to a strong random string in production)
JWT_SECRET=change-this-to-a-strong-random-secret

# Supabase (REQUIRED)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# OpenRouter AI API Keys
OPENROUTER_STUDENT_KEY=sk-or-v1-your-student-key
OPENROUTER_TEACHER_KEY=sk-or-v1-your-teacher-key
OPENROUTER_ADMIN_KEY=sk-or-v1-your-admin-key

# Optional overrides
JWT_ALGORITHM=HS256
TOKEN_EXPIRY_HOURS=8
OPENROUTER_MODEL=openrouter/free
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
