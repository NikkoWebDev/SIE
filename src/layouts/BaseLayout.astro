---
import '../styles/theme.css'

export interface Props {
  titulo: string
  descripcion?: string
  noIndex?: boolean
  withNoise?: boolean
}

const {
  titulo,
  descripcion = 'Plataforma académica VYNTRA — Sogamoso, Boyacá, Colombia',
  noIndex = false,
  withNoise = false,
} = Astro.props

const title = `VYNTRA · ${titulo}`
const apiUrl = (import.meta.env.PUBLIC_API_URL || 'http://localhost:8000').replace(/\/+$/, '')

// CSP is enforced via public/_headers (Netlify) with hash-based script-src.
// Astro.response.headers is a no-op for output:'static' pages — headers must
// live in _headers for the Netlify CDN to apply them.
---

<!doctype html>
<html lang="es-CO">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={descripcion} />
  {noIndex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={`https://colegiociudaddelsol.edu.co${Astro.url.pathname}`} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:url" content={`https://colegiociudaddelsol.edu.co${Astro.url.pathname}`} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://colegiociudaddelsol.edu.co/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:site_name" content="Vyntra Academic" />
  <meta property="og:locale" content="es_CO" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={descripcion} />
  <meta name="twitter:image" content="https://colegiociudaddelsol.edu.co/og-image.png" />
  <meta name="theme-color" content="#6B1A1A" />

  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
  <link rel="icon" type="image/png" href="/icon-512.png" sizes="512x512" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Fraunces:opsz,wght@9..144,700;9..144,900&family=Syne:wght@500;700&family=Azeret+Mono:wght@400;600&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Fraunces:opsz,wght@9..144,700;9..144,900&family=Syne:wght@500;700&family=Azeret+Mono:wght@400;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Fraunces:opsz,wght@9..144,700;9..144,900&family=Syne:wght@500;700&family=Azeret+Mono:wght@400;600&display=swap" rel="stylesheet" /></noscript>

  {!noIndex && (
    <script type="application/ld+json" set:html={JSON.stringify([{
      "@context": "https://schema.org",
      "@type": "School",
      "name": "Colegio Técnico Ciudad del Sol",
      "alternateName": "Vyntra Academic",
      "url": "https://colegiociudaddelsol.edu.co",
      "description": "Institución educativa técnica en Sogamoso, Boyacá, Colombia con plataforma académica VYNTRA Solaris",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Sogamoso",
        "addressRegion": "Boyacá",
        "addressCountry": "CO"
      },
    }, {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Vyntra Academic",
      "url": "https://colegiociudaddelsol.edu.co",
      "description": "Plataforma integral de gestión académica con metodología ABP para el Colegio Técnico Ciudad del Sol",
      "inLanguage": "es-CO",
    }])} />
  )}

  <!-- Phase 1: Synchronous init — must run before paint -->
  <meta name="vyntra-api-url" content={apiUrl}>
  <script is:inline>
    window.__API_URL__ = document.querySelector('meta[name="vyntra-api-url"]').getAttribute('content')
  </script>
  <script is:inline>
    // Theme init — must run sync to avoid FOUC
    (function () {
      var dark = false
      try { dark = localStorage.getItem('vyntra-theme') === 'dark' } catch (_) {}
      if (!dark) {
        try { dark = window.matchMedia('(prefers-color-scheme:dark)').matches } catch (_) {}
      }
      document.documentElement.classList.toggle('dark', dark)
      window.setVyntraTheme = function (d) {
        document.documentElement.classList.toggle('dark', d)
        try { localStorage.setItem('vyntra-theme', d ? 'dark' : 'light') } catch (_) {}
      }
    })()
  </script>
  <script is:inline>
    // Service worker cleanup — prevents stale SW from legacy deployments.
    // Safe to remove if no PWA migration is planned.
    try {
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(function (regs) {
          regs.forEach(function (r) { r.unregister() })
        })
      }
    } catch (_) {}
  </script>

  <!-- Phase 2: Auth check, wakeup, XHR interceptor — early but not sync-critical -->
  <script is:inline>
    (function () {
      var API_URL = window.__API_URL__ || 'http://localhost:8000'

      function httpGet(url, cb) {
        var x = new XMLHttpRequest()
        x.open('GET', url, true)
        x.onload = function () { cb && cb(x.status) }
        x.onerror = function () {}
        x.send()
      }

      function wakeUp() {
        httpGet(API_URL + '/api/health', function () {})
      }

      function checkAuth() {
        try {
          var uid = localStorage.getItem('userId')
          if (!uid) {
            var p = window.location.pathname
            if (p !== '/' && p !== '/login' && p !== '/login/' && !p.startsWith('/api/')) {
              localStorage.clear()
              window.location.href = '/login/'
            }
            return false
          }
          return true
        } catch (_) { return false }
      }

      // XHR interceptor for 401 handling — guard against duplicate listeners
      var origOpen = XMLHttpRequest.prototype.open
      XMLHttpRequest.prototype.open = function () {
        var xhr = this
        if (!xhr._vyntraPatched) {
          xhr._vyntraPatched = true
          xhr.addEventListener('load', function () {
            if (xhr.status === 401) {
              try { if (localStorage.getItem('userId')) { localStorage.clear(); window.location.href = '/login/' } } catch (_) {}
            }
          })
        }
        return origOpen.apply(this, arguments)
      }

      checkAuth()
      wakeUp()

      // Verify cookie auth against backend — catch expired/invalid sessions early
      function verifyCookieAuth() {
        try {
          var uid = localStorage.getItem('userId')
          if (!uid) return
          fetch(API_URL + '/api/auth/verify', { credentials: 'include' })
            .then(function(r) {
              if (r.status === 401) {
                localStorage.clear()
                window.location.href = '/login/'
              }
            })
            .catch(function() {
              // Network error — backend may be cold-starting on Render
              // Don't kick everyone out, just skip silently
            })
        } catch (_) {}
      }
      verifyCookieAuth()

      window.VYNTRA = window.VYNTRA || {}
      window.VYNTRA.isAuthenticated = function () {
        try { return !!localStorage.getItem('userId') } catch (_) { return false }
      }
      window.VYNTRA.getApiUrl = function () { return API_URL }
      window.VYNTRA.getToken = function () { return null }
    })()
  </script>

  <!-- Phase 3: Utility functions + fetch — inline for immediate availability -->
  <script is:inline>
    (function () {
      window.escapeHtml = function (text) {
        var div = document.createElement('div')
        div.appendChild(document.createTextNode(String(text || '')))
        return div.innerHTML
      }
      window.formatNum = function (n, d) {
        var num = parseFloat(n)
        return isNaN(num) ? '--' : num.toFixed(d || 1)
      }
      window.startVyntraClock = function (elId) {
        var el = document.getElementById(elId)
        if (!el) return
        function tick() { if (el) el.textContent = new Date().toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) }
        tick(); setInterval(tick, 1000)
      }
      window.getCurrentBimester = function () {
        var m = new Date().getMonth() + 1
        return m <= 3 ? 'P1' : m <= 6 ? 'P2' : m <= 9 ? 'P3' : 'P4'
      }

      // Primary vfetch — immediately available for page inline scripts.
      // api.ts (Phase 4 module) overwrites it with the typed version once loaded.
      var API_URL = window.__API_URL__ || 'http://localhost:8000'
      window.vfetch = function (baseUrl, path, opts) {
        opts = opts || {}
        var body = opts.body
        var isFormData = body instanceof FormData
        var headers = Object.assign({}, opts.headers || {})
        if (!isFormData) headers['Content-Type'] = 'application/json'
        var ctrl = new AbortController()
        var timer = setTimeout(function () { ctrl.abort() }, 15000)
        var merged = Object.assign({ credentials: 'include', signal: opts.signal || ctrl.signal }, opts, { headers: headers })
        var url = (baseUrl || API_URL).replace(/\/+$/, '') + '/' + path.replace(/^\/+/, '')
        return fetch(url, merged).then(function (r) {
          clearTimeout(timer)
          if (r.status === 401) {
            try { localStorage.clear() } catch (_) {}
            window.VyntraToast && window.VyntraToast.error('Sesión expirada. Redirigiendo al inicio...')
            setTimeout(function () { window.location.href = '/login' }, 1500)
            throw new Error('Sesión expirada')
          }
          return r
        }).catch(function (e) {
          clearTimeout(timer)
          throw e
        })
      }
    })()
  </script>

  <!-- Phase 4: Module imports — sets up richer API, session, and chart utilities on window -->
  <script>
    import '../lib/api'
    import '../lib/session'
    import '../lib/section-router'
    import '../lib/charts'
  </script>

  <slot name="head" />
</head>
<body class="antialiased">
  <a href="#main-content" class="skip-link absolute -top-full left-4 z-[99999] px-4 py-2.5 rounded-lg bg-brand-maroon text-white text-sm font-semibold focus:top-4 transition-[top] duration-200">Saltar al contenido</a>
  {withNoise && <div class="noise-overlay" aria-hidden="true"></div>}
  <slot />
</body>
</html>
