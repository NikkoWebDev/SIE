---
import '../styles/theme.css'

export interface Props {
  titulo: string
  descripcion?: string
  noIndex?: boolean
  withNoise?: boolean
  withThemeScript?: boolean
}

const {
  titulo,
  descripcion = 'Plataforma académica VYNTRA — Sogamoso, Boyacá, Colombia',
  noIndex = false,
  withNoise = false,
  withThemeScript = true,
} = Astro.props

const title = `VYNTRA · ${titulo}`
const scriptSrc = "'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com"
const apiUrl = (import.meta.env.PUBLIC_API_URL || 'http://localhost:8000').replace(/\/+$/, '')
const apiHost = new URL(apiUrl).host
const wsScheme = apiUrl.startsWith('https') ? 'wss' : 'ws'
const connectSrc = `'self' ${apiUrl} ${wsScheme}://${apiHost}`
const CSP = `default-src 'self'; script-src ${scriptSrc}; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com; connect-src ${connectSrc}; frame-src 'self' https:; media-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'`

Astro.response.headers.set('Content-Security-Policy', CSP)
---

<!doctype html>
<html lang="es-CO">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={descripcion} />
  {noIndex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={`https://colegiociudaddelsol.edu.co${Astro.url.pathname}`} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:url" content={`https://colegiociudaddelsol.edu.co${Astro.url.pathname}`} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://colegiociudaddelsol.edu.co/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:site_name" content="Vyntra Academic" />
  <meta property="og:locale" content="es_CO" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={descripcion} />
  <meta name="twitter:image" content="https://colegiociudaddelsol.edu.co/og-image.png" />
  <meta name="theme-color" content="#6B1A1A" />

  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
  <link rel="icon" type="image/png" href="/icon-512.png" sizes="512x512" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Fraunces:opsz,wght@9..144,700;9..144,900&family=Syne:wght@500;700&family=Azeret+Mono:wght@400;600&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Fraunces:opsz,wght@9..144,700;9..144,900&family=Syne:wght@500;700&family=Azeret+Mono:wght@400;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Fraunces:opsz,wght@9..144,700;9..144,900&family=Syne:wght@500;700&family=Azeret+Mono:wght@400;600&display=swap" rel="stylesheet" /></noscript>

  {!noIndex && (
    <script type="application/ld+json" set:html={JSON.stringify([{
      "@context": "https://schema.org",
      "@type": "School",
      "name": "Colegio Técnico Ciudad del Sol",
      "alternateName": "Vyntra Academic",
      "url": "https://colegiociudaddelsol.edu.co",
      "description": "Institución educativa técnica en Sogamoso, Boyacá, Colombia con plataforma académica VYNTRA Solaris",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Sogamoso",
        "addressRegion": "Boyacá",
        "addressCountry": "CO"
      },
    }, {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Vyntra Academic",
      "url": "https://colegiociudaddelsol.edu.co",
      "description": "Plataforma integral de gestión académica con metodología ABP para el Colegio Técnico Ciudad del Sol",
      "inLanguage": "es-CO",
    }])} />
  )}
  <meta name="vyntra-api-url" content={apiUrl}>
  <script is:inline>
    window.__API_URL__ = document.querySelector('meta[name="vyntra-api-url"]').getAttribute('content')
  </script>
  <script is:inline>
    // ── Service Worker cleanup ──
    try { if ('serviceWorker' in navigator) { navigator.serviceWorker.getRegistrations().then(function (a) { a.forEach(function (b) { b.unregister() }) }) } } catch(e){}
  </script>
  {withThemeScript && <script is:inline>(function(){try{if(localStorage.getItem('vyntra-theme')==='dark')document.documentElement.classList.add('dark')}catch(e){}})();</script>}
  <script is:inline>
    // VYNTRA Academic — Session Manager v3.2 (inline)
    (function () {
      var API_URL = window.__API_URL__ || 'http://localhost:8000'
      var origFetch, origOpen

      function getToken() { return null }
      function isAuthenticated() { try { return !!localStorage.getItem('userId') } catch(e) { return false } }

      function wakeUp() {
        fetch(API_URL + '/api/health', { method: 'GET', priority: 'low', signal: AbortSignal.timeout(5000) }).catch(function(){})
      }

      function checkAuth() {
        try {
          var uid = localStorage.getItem('userId')
          if (!uid) {
            var p = window.location.pathname
            if (p !== '/' && p !== '/login' && p !== '/login/' && p !== '/api/health' && !p.startsWith('/api/')) {
              localStorage.clear()
              window.location.href = '/login/'
            }
            return false
          }
          return true
        } catch(e) { return false }
      }

      function setupAuthInterceptor() {
        origOpen = XMLHttpRequest.prototype.open
        XMLHttpRequest.prototype.open = function () {
          this.addEventListener('load', function () {
            if (this.status === 401) {
              var hadSession = false
              try { hadSession = !!localStorage.getItem('userId') } catch(_) {}
              if (hadSession) {
                localStorage.clear()
                if (window.location.pathname !== '/login' && window.location.pathname !== '/login/') window.location.href = '/login/'
              }
            }
          })
          return origOpen.apply(this, arguments)
        }

        origFetch = window.fetch
        window.fetch = function (url, opts) {
          return origFetch(url, opts).then(function (r) {
            if (r.status === 401) {
              var hadSession = false
              try { hadSession = !!localStorage.getItem('userId') } catch(_) {}
              if (hadSession) {
                localStorage.clear()
                if (window.location.pathname !== '/login' && window.location.pathname !== '/login/') window.location.href = '/login/'
              }
            }
            return r
          })
        }
      }

      checkAuth()
      wakeUp()
      setupAuthInterceptor()

      window.VYNTRA = window.VYNTRA || {}
      window.VYNTRA.isAuthenticated = isAuthenticated
      window.VYNTRA.getApiUrl = function () { return API_URL }
      window.VYNTRA.getToken = getToken
      window.VYNTRA.origFetch = origFetch
    })()
  </script>

  <slot name="head" />
</head>
<body class="antialiased">
  <a href="#main-content" class="skip-link absolute -top-full left-4 z-[99999] px-4 py-2.5 rounded-lg bg-brand-maroon text-white text-sm font-semibold focus:top-4 transition-[top] duration-200">Saltar al contenido</a>
  {withNoise && <div class="noise-overlay" aria-hidden="true"></div>}
  <slot />
</body>
</html>
