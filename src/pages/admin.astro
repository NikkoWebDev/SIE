    async function deleteNotice(id){if(!confirm('¿Eliminar este aviso?')) return; await fetch(window.API_URL+'/api/admin/notices/'+id,{method:'DELETE'});toast('Aviso eliminado','success');await loadAllData()}

    async function addSubject() {
      var name = document.getElementById('new-subject-input').value;
      var grade = document.getElementById('new-subject-grade').value;
      var tutor = document.getElementById('subject-tutor-link').value;
      var planner = document.getElementById('subject-planner-link').value;
      if (!name) { toast('El nombre es obligatorio','error'); return; }
      toggleLoading(true);
      try {
        await fetch(window.API_URL+'/api/admin/subjects',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name,grade,tutor_ai:tutor,planner_ai:planner})});
