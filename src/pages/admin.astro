      } else if (type==='docente') {
        document.getElementById('modal-title').textContent = 'Nuevo Docente';
        form.innerHTML = '<input type="hidden" id="form-type" value="docente"><div class="form-group" style="margin-bottom:.75rem"><label style="display:block;font-size:.7rem;font-weight:600;color:var(--text-tertiary);margin-bottom:.35rem;text-transform:uppercase;letter-spacing:.05em">Nombre</label><input type="text" class="input-apple" id="d-name" required></div><div class="form-group" style="margin-bottom:.75rem"><label style="display:block;font-size:.7rem;font-weight:600;color:var(--text-tertiary);margin-bottom:.35rem;text-transform:uppercase;letter-spacing:.05em">ID Usuario (Cédula)</label><input type="text" class="input-apple" id="d-id" required></div><div class="form-group"><label style="display:block;font-size:.7rem;font-weight:600;color:var(--text-tertiary);margin-bottom:.35rem;text-transform:uppercase;letter-spacing:.05em">Clave</label><input type="password" class="input-apple" id="d-pass" value="123456"></div>';
      } else if (type==='assign-subject') {
        document.getElementById('modal-title').textContent = 'Asignar Materia a Docente';
        var subjOpts = (cache.subjects||[]).map(function(s){return '<option value="'+s.id+'">'+s.name+' ('+(s.grade||'-')+')</option>'}).join('');
        form.innerHTML = '<input type="hidden" id="form-type" value="assign-subject"><input type="hidden" id="t-id-assign" value=""><div class="form-group" style="margin-bottom:.75rem"><label style="display:block;font-size:.7rem;font-weight:600;color:var(--text-tertiary);margin-bottom:.35rem;text-transform:uppercase;letter-spacing:.05em">Docente</label><strong id="t-name-display" style="font-size:.85rem"></strong></div><div class="form-group" style="margin-bottom:.75rem"><label style="display:block;font-size:.7rem;font-weight:600;color:var(--text-tertiary);margin-bottom:.35rem;text-transform:uppercase;letter-spacing:.05em">Seleccionar Materia</label><select class="input-apple" id="subj-to-assign">'+subjOpts+'</select></div><div class="form-group"><label style="display:block;font-size:.7rem;font-weight:600;color:var(--text-tertiary);margin-bottom:.35rem;text-transform:uppercase;letter-spacing:.05em">¿Es Director de Grupo?</label><select class="input-apple" id="dir-grade-assign"><option value="">No es director</option>'+window.GRADOS_HTML+'</select></div>';
      }
    }

    function openSubjectAssign(docId, name) { openModal('assign-subject'); document.getElementById('t-id-assign').value=docId; document.getElementById('t-name-display').textContent=name; }

    function closeModal() { document.getElementById('admin-modal').classList.remove('active'); }

    async function saveForm() {
      var type = document.getElementById('form-type').value;
      toggleLoading(true);
      try {
        if (type==='estudiante') {
          var res = await fetch(window.API_URL+'/api/admin/students',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({login_credential:document.getElementById('s-id').value,fullname:document.getElementById('s-name').value,grade:document.getElementById('s-grade').value,password:document.getElementById('s-pass').value,role:'student'})});
          if (!res.ok) { var e=await res.json(); throw new Error(e.detail||'Error'); }
          toast('Estudiante matriculado','success');
        } else if (type==='docente') {
          var res = await fetch(window.API_URL+'/api/admin/assign-teacher',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({document_id:document.getElementById('d-id').value,teacher_name:document.getElementById('d-name').value,password:document.getElementById('d-pass').value})});
          if (!res.ok) { var e=await res.json(); throw new Error(e.detail||'Error'); }
          toast('Docente registrado','success');
        } else if (type==='assign-subject') {
          var docId = document.getElementById('t-id-assign').value;
          var subId = document.getElementById('subj-to-assign').value;
          var dirGrade = document.getElementById('dir-grade-assign').value;
          var res = await fetch(window.API_URL+'/api/admin/teachers/'+docId+'/subjects',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({subject_id:subId})});
          if (!res.ok) { var e=await res.json(); throw new Error(e.detail||'Error'); }
          if (dirGrade) { await fetch(window.API_URL+'/api/admin/teachers/'+docId+'/director',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({grade:dirGrade})}); }
          toast('Materia asignada','success');
        }
        closeModal();
        await loadAllData();
      } catch(e){toast('Error: '+e.message,'error')}
      toggleLoading(false);
    }

