    async function deleteTeacher(docId){if(!confirm('¿Eliminar este docente permanentemente?')) return; toggleLoading(true); try{await fetch(window.API_URL+'/api/admin/teachers/'+docId,{method:'DELETE'});toast('Docente eliminado','success');await loadAllData()}catch(e){toast('Error al eliminar','error')}toggleLoading(false)}
