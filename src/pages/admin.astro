    async function publishNotice() {
      var titulo = document.getElementById('notice-title').value;
      var contenido = document.getElementById('notice-content').value;
      var file = document.getElementById('notice-file').files[0];
      if (!titulo||!contenido) { toast('Título y contenido son obligatorios','error'); return; }
      toggleLoading(true);
      var fd = new FormData(); fd.append('titulo',titulo); fd.append('contenido',contenido); fd.append('categoria','General');
      if (file) fd.append('file',file);
      try {
        await fetch(window.API_URL+'/api/admin/notices',{method:'POST',body:fd});
        document.getElementById('notice-title').value='';document.getElementById('notice-content').value='';document.getElementById('notice-file').value='';
        document.getElementById('file-name-display').textContent='SUBIR IMAGEN O PDF';
        document.getElementById('notice-preview-container').innerHTML='';
        toast('Aviso publicado','success');
        await loadAllData();
      } catch(e){toast('Error al publicar aviso','error')}
      toggleLoading(false);
    }

    function previewNoticeFile(e) {
      var file = e.target.files[0];
      var container = document.getElementById('notice-preview-container');
      var display = document.getElementById('file-name-display');
      if (!file) { container.innerHTML=''; display.textContent='SUBIR IMAGEN O PDF'; return; }
      display.textContent = file.name;
      if (file.type.startsWith('image/')) {
        var reader = new FileReader();
        reader.onload = function(ev) { container.innerHTML='<img src="'+ev.target.result+'" style="max-width:100%;max-height:200px;border-radius:var(--radius-md);border:1px solid var(--border)">'; };
        reader.readAsDataURL(file);
      } else if (file.type==='application/pdf') {
        container.innerHTML='<div style="padding:.5rem;background:var(--maroon-subtle);border-radius:var(--radius-md);font-size:.75rem;color:var(--text)">📄 Documento PDF seleccionado</div>';
      } else { container.innerHTML=''; }
    }
    document.getElementById('notice-file').addEventListener('change', previewNoticeFile);
    document.getElementById('admin-modal').addEventListener('click', function(e) { if (e.target===this) closeModal(); });
  </script>
</body>
</html>
