    function renderNotices(data) {
      var list = document.getElementById('admin-notices-list');
      if (!list) return;
      list.innerHTML = (data||[]).map(function(n){
        var isPDF = n.archivo_url && n.archivo_url.toLowerCase().endsWith('.pdf');
        return '<div class="card-float" style="padding:1rem;margin-bottom:.75rem;border-left:4px solid var(--gold)">'+
          '<div style="display:flex;justify-content:space-between;color:var(--text-tertiary);font-size:.7rem;margin-bottom:.5rem">'+
          '<span><strong style="color:var(--text);font-size:.8rem">'+(n.titulo||'Sin título')+'</strong> · '+(n.fecha?new Date(n.fecha).toLocaleDateString('es-CO'):'')+'</span>'+
          '<button class="btn-apple btn-ghost" style="padding:.15rem .35rem;font-size:.6rem;color:var(--red)" onclick="deleteNotice(\''+n.id+'\')">✕</button></div>'+
          '<p style="font-size:.8rem;color:var(--text-secondary);line-height:1.6;white-space:pre-wrap">'+(n.contenido||'')+'</p>'+
          (n.archivo_url?(isPDF?'<div style="margin-top:.5rem;padding:.5rem;background:var(--maroon-subtle);border-radius:var(--radius-md);display:flex;align-items:center;gap:.5rem;font-size:.75rem"><span>📄</span><a href="'+n.archivo_url+'" target="_blank" style="color:var(--maroon)">Ver Documento PDF</a></div>':'<img src="'+n.archivo_url+'" style="max-width:100%;max-height:200px;border-radius:var(--radius-md);margin-top:.5rem;cursor:pointer" onclick="window.open(this.src)">'):'')+'</div>';
      }).join('') || '<div class="card-float" style="padding:1rem;text-align:center;color:var(--text-tertiary);font-size:.8rem">No hay avisos publicados</div>';
    }

    async function loadElectionChart() {
      try {
        var res = await fetch(window.API_URL + '/api/admin/candidates');
        var data = await res.json();
        var container = document.getElementById('candidates-management-list');
        if (container) {
          container.innerHTML = (data||[]).map(function(c){
            return '<div class="card-float" style="display:flex;align-items:center;gap:.75rem;padding:.75rem;margin-bottom:.5rem">'+
              '<img src="'+(c.photo_url||'')+'" style="width:2.25rem;height:2.25rem;border-radius:50%;object-fit:cover;background:var(--bg-tertiary)" onerror="this.style.display=\'none\'">'+
              '<div style="flex:1"><strong style="font-size:.8rem">'+c.name+'</strong> · <span style="color:var(--text-tertiary);font-size:.7rem">'+c.votes+' votos</span></div>'+
              '<button class="btn-apple btn-ghost" style="padding:.15rem .35rem;font-size:.6rem;color:var(--red)" onclick="deleteCandidate(\''+c.id+'\')">✕</button></div>';
          }).join('') || '<p style="color:var(--text-tertiary);text-align:center;padding:.75rem;font-size:.8rem">No hay candidatos</p>';
        }
        renderElectionChart(data||[]);
      } catch(e){console.error(e)}
    }

    function renderElectionChart(data) {
      if (typeof Chart === 'undefined') { setTimeout(function(){renderElectionChart(data)},500); return; }
      var ctx = document.getElementById('electionResultsChart');
      if (!ctx) return;
      if (electionChart) { electionChart.destroy(); electionChart=null; }
      if (!data.length) return;
      electionChart = new Chart(ctx, {
        type:'bar',
        data:{labels:data.map(function(c){return c.name}),datasets:[{label:'Votos',data:data.map(function(c){return c.votes}),backgroundColor:'#800000',borderRadius:6}]},
        options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,ticks:{stepSize:1}}}}
      });
    }

    async function addCandidate() {
      var name = document.getElementById('cand-name').value;
      var file = document.getElementById('cand-photo').files[0];
      if (!name||!file) { toast('Nombre y foto son obligatorios','error'); return; }
      toggleLoading(true);
      var fd = new FormData(); fd.append('name',name); fd.append('file',file);
      try {
        var res = await fetch(window.API_URL+'/api/admin/candidates',{method:'POST',body:fd});
        if (!res.ok) throw Error();
        document.getElementById('cand-name').value=''; document.getElementById('cand-photo').value='';
        toast('Candidato registrado','success');
        await loadElectionChart();
      } catch(e){toast('Error al registrar candidato','error')}
      toggleLoading(false);
    }

    async function resetElection() { if(!confirm('¿REINICIAR TODOS LOS VOTOS? Esta acción no se puede deshacer.')) return; toggleLoading(true); try{await fetch(window.API_URL+'/api/admin/election-reset',{method:'POST'});toast('Elección reiniciada','success');await loadElectionChart()}catch(e){toast('Error al reiniciar','error')}toggleLoading(false)}

