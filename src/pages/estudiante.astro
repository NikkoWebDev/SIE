    // ── Grades render ──
    function renderGrades(grades) {
      var grid = document.getElementById('metrics-grid')
      if (!grid) return
      if (!grades || grades.length === 0) { grid.innerHTML = '<p class="col-span-full text-sm text-gray-500 py-8 text-center">No hay notas registradas</p>'; return }
      var total = grades.reduce(function (s, g) { return s + g.score }, 0)
      var avg = total / grades.length
      var atRisk = grades.filter(function (g) { return g.score < 3.5 })
      grid.innerHTML = grades.map(function (g) {
        var name = g.subject_name || g.subject_id || g.subject || '-'
        var c = g.score >= 4.0 ? 'text-[#00FF66]' : g.score >= 3.5 ? 'text-[#FFE600]' : 'text-[#FF0055]'
        var bar = g.score >= 4.0 ? 'bg-[#00FF66]' : g.score >= 3.5 ? 'bg-[#FFE600]' : 'bg-[#FF0055]'
        return '<div class="rounded-xl border border-white/[0.06] bg-white/[0.03] p-4 transition-all hover:bg-white/[0.06] hover:border-white/[0.1]"><div class="flex items-center justify-between mb-2"><span class="text-sm font-medium text-gray-300 truncate">' + name + '</span><span class="text-base font-bold ' + c + '">' + g.score.toFixed(1) + '</span></div><div class="h-1.5 rounded-full bg-white/[0.06] overflow-hidden"><div class="h-full rounded-full ' + bar + ' transition-all duration-1000" style="width:' + (g.score / 5 * 100) + '%"></div></div></div>'
      }).join('')
      var display = document.getElementById('avg-score-display')
      display.textContent = avg.toFixed(1)
      var col = avg >= 4.0 ? '#00FF66' : avg >= 3.5 ? '#FFE600' : '#FF0055'
      display.style.color = col
      var circumference = 97.4
      var offset = circumference * (1 - avg / 5)
      var ring = document.getElementById('avg-ring')
      ring.setAttribute('stroke', col)
      ring.setAttribute('stroke-dashoffset', offset.toString())
      var statusEl = document.getElementById('summary-status')
      if (avg >= 4.0) { statusEl.textContent = 'Sobresaliente'; statusEl.style.color = '#00FF66' }
      else if (avg >= 3.5) { statusEl.textContent = 'Aceptable'; statusEl.style.color = '#FFE600' }
      else { statusEl.textContent = 'En Riesgo'; statusEl.style.color = '#FF0055' }
      document.getElementById('summary-subjects').textContent = grades.length.toString()
      var riskEl = document.getElementById('summary-risk')
      riskEl.textContent = atRisk.length > 0 ? atRisk.length + ' área(s)' : 'Ninguna'
      riskEl.style.color = atRisk.length > 0 ? '#FF0055' : '#00FF66'
      if (avg < 3.5) document.getElementById('main-container').classList.add('ambient-risk-active')
    }

