<script define:vars={{ apiUrl, wsUrl }}>
(function(){
  var toastEl = document.createElement('div')
  toastEl.style.cssText = 'position:fixed;top:80px;right:24px;z-index:99999;padding:.75rem 1.25rem;border-radius:14px;font-size:.8rem;font-weight:500;opacity:0;transform:translateX(120px);pointer-events:auto;max-width:320px;background:rgba(29,29,31,.96);color:#fff;box-shadow:0 8px 30px rgba(0,0,0,.25);transition:all .3s cubic-bezier(.34,1.56,.64,1)'
  document.body.appendChild(toastEl)
  function showToast(msg, type){
    if(type==='error'){toastEl.style.background='rgba(186,26,26,.95)'}
    else if(type==='success'){toastEl.style.background='rgba(52,199,89,.95)'}
    else{toastEl.style.background='rgba(29,29,31,.96)'}
    toastEl.textContent = msg
    toastEl.style.opacity='1';toastEl.style.transform='translateX(0)'
    clearTimeout(toastEl._timer)
    toastEl._timer = setTimeout(function(){toastEl.style.opacity='0';toastEl.style.transform='translateX(120px)'}, 4000)
  }

  var token = localStorage.getItem('access_token')
  if (!token) { window.location.href = '/login'; return }
  var studentId = localStorage.getItem('profile_id') || localStorage.getItem('userId')
  var userGrade = localStorage.getItem('userGrade') || ''
  var currentSection = 'inicio'
  var subjectsCache = null

  function apiFetch(path, opts){
    var url = apiUrl.replace(/\/+$/, '') + '/' + path.replace(/^\/+/, '')
    var merged = Object.assign({ headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' } }, opts || {})
    if (merged.body && typeof merged.body === 'object' && !(merged.body instanceof FormData)) merged.body = JSON.stringify(merged.body)
    return fetch(url, merged).then(function(r){
      if (r.status === 401) { localStorage.clear(); window.location.href = '/login' }
      return r.json()
    })
  }

