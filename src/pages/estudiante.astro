<style is:global>
  :root {
    --ease-out-expo: cubic-bezier(0.19, 1, 0.22, 1);
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .glass-card-student {
    background: rgba(255,255,255,0.03);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 1.5rem;
    transition: all 0.3s ease;
  }
  .glass-card-student:hover {
    background: rgba(255,255,255,0.05);
    border-color: rgba(255,255,255,0.1);
  }
  .shimmer-skeleton-student {
    background: linear-gradient(90deg, transparent 0%, rgba(128,0,0,0.08) 50%, transparent 100%);
    background-size: 200% 100%;
    animation: shimmerDash 2s infinite linear;
    border-radius: 0.75rem;
  }
  @keyframes shimmerDash {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }
  .noise-overlay {
    position: fixed; inset: 0; z-index: 1;
    pointer-events: none; opacity: 0.02;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='1'/%3E%3C/svg%3E");
    background-repeat: repeat; background-size: 256px 256px;
  }
  .fade-in-section {
    opacity: 0;
    animation: fadeSlideUp 0.8s var(--ease-out-expo) forwards;
  }
  @keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .solar-glow {
    position: fixed; width: 120vmax; height: 120vmax; left: 50%; top: 50%;
    transform: translate(-50%,-55%);
    background: radial-gradient(ellipse 40% 35% at 50% 50%, rgba(253,192,3,0.06) 0%, rgba(128,0,0,0.04) 30%, transparent 60%);
    animation: pulseSlow 8s ease-in-out infinite;
    pointer-events: none; z-index: 0;
  }
  .solar-ring-bg {
    position: fixed; width: 90vmin; height: 90vmin; left: 50%; top: 45%;
    transform: translate(-50%,-50%); border-radius: 50%;
    background: radial-gradient(circle at 50% 50%, rgba(253,192,3,0.08) 0%, rgba(253,192,3,0.02) 35%, transparent 55%);
    animation: coronaPulse 6s ease-in-out infinite;
    pointer-events: none; z-index: 0;
  }
  .solar-ring-bg::before {
    content: ''; position: absolute; inset: -2px; border-radius: 50%;
    border: 1px solid rgba(253,192,3,0.08);
    animation: ringRotate 20s linear infinite;
  }
  .solar-ring-bg::after {
    content: ''; position: absolute; inset: -20px; border-radius: 50%;
    border: 1px dashed rgba(253,192,3,0.04);
    animation: ringRotate 30s linear infinite reverse;
  }
  @keyframes pulseSlow {
    0%,100% { transform: translate(-50%,-55%) scale(1); opacity: 0.8; }
    50% { transform: translate(-50%,-55%) scale(1.08); opacity: 1; }
  }
  @keyframes coronaPulse {
    0%,100% { transform: translate(-50%,-50%) scale(1); opacity: 0.6; }
    50% { transform: translate(-50%,-50%) scale(1.12); opacity: 1; }
  }
  @keyframes ringRotate { to { transform: rotate(360deg); } }
  .orbit-container {
    position: fixed; left: 50%; top: 45%; width: 70vmin; height: 70vmin;
    transform: translate(-50%,-50%);
    animation: ringRotate 40s linear infinite;
    pointer-events: none; z-index: 0;
  }
  .orbit-dot {
    position: absolute; width: 4px; height: 4px; border-radius: 50%; background: #FDC003; opacity: 0.3;
  }
  .orbit-dot:nth-child(1) { top: 0; left: 50%; transform: translate(-50%,-50%); }
  .orbit-dot:nth-child(2) { top: 50%; right: 0; transform: translate(50%,-50%); }
  .orbit-dot:nth-child(3) { bottom: 0; left: 50%; transform: translate(-50%,50%); }
  .orbit-dot:nth-child(4) { top: 50%; left: 0; transform: translate(-50%,-50%); }
  .orbit-container-2 {
    position: fixed; left: 50%; top: 45%; width: 55vmin; height: 55vmin;
    transform: translate(-50%,-50%);
    animation: ringRotate 25s linear infinite reverse;
    pointer-events: none; z-index: 0;
  }
  .orbit-dot-2 {
    position: absolute; width: 3px; height: 3px; border-radius: 50%; background: #800000; opacity: 0.5;
  }
  .orbit-dot-2:nth-child(1) { top: 0; left: 50%; transform: translate(-50%,-50%); }
  .orbit-dot-2:nth-child(2) { bottom: 15%; right: 0; transform: translate(50%,50%); }
  .orbit-dot-2:nth-child(3) { bottom: 0; left: 25%; transform: translate(0,50%); }
  .glow-orb-maroon {
    position: fixed; top: 10%; right: 5%; width: 400px; height: 400px;
    background: rgba(128,0,0,0.05); filter: blur(120px); border-radius: 50%;
    pointer-events: none;
  }
  .glow-orb-amber {
    position: fixed; bottom: 20%; left: 10%; width: 300px; height: 300px;
    background: rgba(253,192,3,0.05); filter: blur(100px); border-radius: 50%;
