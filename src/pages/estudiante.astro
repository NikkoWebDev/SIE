  .ambient-risk-active { box-shadow: inset 0 0 80px rgba(255,0,85,0.15), inset 0 0 160px rgba(255,0,85,0.08); }

  .abp-tab-btn {
    color: rgba(255,255,255,0.3);
    border-bottom: 2px solid transparent;
  }
  .abp-tab-btn.active {
    color: #FDC003;
    border-bottom-color: #FDC003;
