---
import Layout from '@layouts/Layout.astro'
import FloatingPillNav from '@components/FloatingPillNav.astro'
import WsRiskAlert from '@components/WsRiskAlert.astro'
import ScoreOrbital from '@components/ScoreOrbital.astro'
import PerformanceBadge from '@components/PerformanceBadge.astro'
import MetricCard from '@components/MetricCard.astro'
import DangerAlert from '@components/DangerAlert.astro'
import AIChat from '@components/AIChat.astro'
const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://backend-colegio-hdx7.onrender.com'
---
<Layout titulo="Panel Estudiante · C sol SIE">
  <FloatingPillNav userRole="ESTUDIANTE" />
  <div class="relative z-10 px-4 md:px-6 lg:px-8 pt-4 lg:pt-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 xl:grid-cols-8 gap-3 md:gap-4 auto-rows-min">
      <div class="col-span-2 sm:col-span-4 lg:col-span-6 xl:col-span-8 mb-2">
        <h1 class="text-xl md:text-3xl font-bold text-gray-900 dark:text-white truncate" id="student-name">Cargando...</h1>
        <p class="text-xs md:text-sm text-gray-500 dark:text-gray-400 truncate" id="student-meta">Panel de rendimiento académico</p>
      </div>
      <div class="col-span-2 sm:col-span-2 lg:col-span-2 xl:col-span-3 row-span-2 rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 md:p-6 flex flex-col items-center justify-center" id="orbital-card">
        <div class="relative inline-flex" id="score-orbital-placeholder">
          <div class="h-24 w-24 md:h-32 md:w-32 rounded-full bg-gray-100 dark:bg-gray-800 animate-pulse"></div>
        </div>
        <p class="mt-3 text-xs text-gray-400" id="orbital-label">Promedio general</p>
      </div>
      <div class="col-span-2 sm:col-span-2 lg:col-span-2 xl:col-span-2 rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 flex flex-col justify-center" id="attendance-card">
        <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Asistencia</span>
        <span class="text-2xl md:text-3xl font-bold text-brand-green mt-1" id="attendance-val">--%</span>
        <div class="mt-2 h-2 rounded-full bg-gray-200 dark:bg-gray-700 overflow-hidden">
          <div class="h-full rounded-full bg-brand-green transition-all duration-1000" id="attendance-bar" style="width:0%"></div>
        </div>
        <span class="mt-1 text-xs text-gray-400" id="attendance-grade"></span>
      </div>
      <div class="col-span-2 sm:col-span-2 lg:col-span-2 xl:col-span-3 rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5" id="badge-card">
        <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Estado Actual</span>
        <div class="mt-3 flex items-center gap-3">
          <div class="h-10 w-10 rounded-xl bg-brand-gold/20 flex items-center justify-center">
            <svg class="h-5 w-5 text-brand-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <span id="badge-value" class="text-sm font-semibold text-gray-900 dark:text-white">--</span>
            <p class="text-xs text-gray-400" id="badge-sub">Rendimiento académico</p>
          </div>
        </div>
      </div>
      <div class="col-span-2 sm:col-span-4 lg:col-span-6 xl:col-span-8" id="metrics-section">
        <h2 class="text-sm md:text-lg font-semibold text-gray-900 dark:text-white mb-3">Rendimiento por Área ABP</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-3" id="metrics-grid">
          {[1,2,3,4,5].map(() => (
            <div class="h-24 rounded-xl bg-gray-100 dark:bg-gray-800 animate-pulse"></div>
          ))}
        </div>
      </div>
      <div class="col-span-2 sm:col-span-4 lg:col-span-4 xl:col-span-5">
        <AIChat />
      </div>
      <div class="col-span-2 sm:col-span-4 lg:col-span-2 xl:col-span-3 rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5" id="risk-history">
        <h3 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-3">Alertas Recientes</h3>
        <div id="risk-list" class="space-y-2 text-sm text-gray-500 dark:text-gray-400">
          <p>Cargando historial...</p>
        </div>
      </div>
    </div>
  </div>
  <WsRiskAlert />
</Layout>
<script define:vars={{ apiUrl }}>
  (async function () {
    var token = localStorage.getItem('auth_token')
    var userId = localStorage.getItem('userId')
    var name = localStorage.getItem('userName')
    if (!token || !userId) { window.location.href = '/'; return }
    if (name) document.getElementById('student-name').textContent = name
    document.getElementById('student-meta').textContent = 'ID: ' + userId + ' · Panel de rendimiento'

    try {
      var res = await fetch(apiUrl + '/api/grades/download-pdf?student_id=' + encodeURIComponent(userId), {
        headers: { 'Authorization': 'Bearer ' + token },
      })
      if (res.status === 403) {
        document.getElementById('badge-value').textContent = 'Estatus financiero irregular'
        document.getElementById('badge-value').className = 'text-sm font-semibold text-brand-danger'
        document.getElementById('badge-sub').textContent = 'Descarga restringida'
      }
    } catch (_) {}

    try {
      var gradesRes = await fetch(apiUrl + '/api/grades?student_id=' + encodeURIComponent(userId), {
        headers: { 'Authorization': 'Bearer ' + token },
      })
      if (gradesRes.ok) {
        var grades = await gradesRes.json()
        renderGrades(grades)
      }
    } catch (_) {}

    function renderGrades(grades) {
      var grid = document.getElementById('metrics-grid')
      if (!grid) return
      if (!grades || grades.length === 0) {
        grid.innerHTML = '<p class="col-span-full text-sm text-gray-400 py-8 text-center">No hay notas registradas</p>'
        return
      }
      var avg = grades.reduce(function (s, g) { return s + g.score }, 0) / grades.length
      var atRisk = grades.filter(function (g) { return g.score < 3.5 })

      grid.innerHTML = grades.map(function (g) {
        var c = g.score >= 4.0 ? 'text-brand-green' : g.score >= 3.5 ? 'text-brand-gold' : 'text-brand-danger'
        var bar = g.score >= 4.0 ? 'bg-brand-green' : g.score >= 3.5 ? 'bg-brand-gold' : 'bg-brand-danger'
        return '<div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-4 transition-all hover:shadow-md">' +
          '<div class="flex items-center justify-between mb-2"><span class="text-sm font-medium text-gray-700 dark:text-gray-300 truncate">' + (g.subject_id || g.subject || '-') + '</span><span class="text-lg font-bold ' + c + '">' + g.score.toFixed(1) + '</span></div>' +
          '<div class="h-2 rounded-full bg-gray-200 dark:bg-gray-700 overflow-hidden"><div class="h-full rounded-full ' + bar + ' transition-all duration-1000" style="width:' + (g.score / 5 * 100) + '%"></div></div>' +
          '</div>'
      }).join('')

      var orbPlaceholder = document.getElementById('score-orbital-placeholder')
      if (orbPlaceholder) {
        var pct = (avg / 5) * 100
        var offset = 283 * (1 - avg / 5)
        var col = avg >= 4.0 ? '#4caf50' : avg >= 3.5 ? '#fdc003' : '#ba1a1a'
        var lbl = avg >= 4.0 ? 'Sobresaliente' : avg >= 3.5 ? 'Aceptable' : 'En Riesgo'
        orbPlaceholder.innerHTML =
          '<svg class="h-24 w-24 md:h-32 md:w-32 -rotate-90" viewBox="0 0 100 100">' +
          '<circle cx="50" cy="50" r="45" fill="none" stroke="currentColor" stroke-width="8" class="text-gray-200 dark:text-gray-700" />' +
          '<circle cx="50" cy="50" r="45" fill="none" stroke="' + col + '" stroke-width="8" stroke-linecap="round" stroke-dasharray="283" stroke-dashoffset="' + offset + '" class="transition-all duration-1000 ease-out" style="filter:drop-shadow(0 0 6px currentColor)" />' +
          '</svg><div class="absolute inset-0 flex flex-col items-center justify-center"><span class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">' + avg.toFixed(1) + '</span><span class="text-xs font-medium" style="color:' + col + '">' + lbl + '</span></div>'
      }

      document.getElementById('badge-value').textContent = lbl
      document.getElementById('badge-value').className = 'text-sm font-semibold ' + (avg >= 4.0 ? 'text-brand-green' : avg >= 3.5 ? 'text-brand-gold' : 'text-brand-danger')

      if (atRisk.length > 0) {
        document.getElementById('metrics-section').insertAdjacentHTML('afterbegin',
          '<div class="mb-3 rounded-xl border-2 border-brand-danger/30 bg-brand-danger/5 p-4 animate-slide-down">' +
          '<div class="flex items-start gap-3"><div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-danger/10"><svg class="h-5 w-5 text-brand-danger" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg></div>' +
          '<div><h3 class="text-sm font-semibold text-brand-danger">Alerta de rendimiento crítico</h3><p class="text-sm text-gray-600 dark:text-gray-400">' + atRisk.length + ' área(s) por debajo de 3.5</p></div></div></div>')
      }

      var riskList = document.getElementById('risk-list')
      if (riskList && atRisk.length > 0) {
        riskList.innerHTML = atRisk.map(function (g) {
          return '<div class="flex items-center gap-2"><span class="h-1.5 w-1.5 shrink-0 rounded-full bg-brand-danger"></span><span class="truncate">' + (g.subject_id || g.subject) + '</span><span class="font-semibold text-brand-danger shrink-0">' + g.score.toFixed(1) + '</span></div>'
        }).join('')
      } else if (riskList) {
        riskList.innerHTML = '<p class="text-brand-green">Sin alertas activas</p>'
      }
    }
  })()
</script>
