  [data-theme="alabaster"] .solar-glow,
  [data-theme="alabaster"] .solar-ring-bg,
  [data-theme="alabaster"] .orbit-container,
  [data-theme="alabaster"] .orbit-container-2,
  [data-theme="alabaster"] .glow-orb-maroon,
  [data-theme="alabaster"] .glow-orb-amber { opacity: 0; }
  [data-theme="alabaster"] .grid-bg { opacity: 0.3; }
