  .font-syne { font-family: 'Syne', sans-serif; }
</style>

<script define:vars={{ apiUrl, studentId }}>
  (async function () {
    var token = localStorage.getItem('access_token')
    var userId = localStorage.getItem('userId')
    var name = localStorage.getItem('userName')
    if (!token || !userId) { window.location.href = '/'; return }
    if (name) {
      document.getElementById('student-name').textContent = name
      document.getElementById('student-initial').textContent = name.charAt(0).toUpperCase()
    }
    document.getElementById('student-meta').textContent = 'ID: ' + userId.slice(0, 8) + ' · Panel de rendimiento'

    // ── Theme System ──
    var currentTheme = localStorage.getItem('vyntra-theme') || 'obsidian'
    var themeToggleBtn = document.getElementById('theme-toggle-btn')
    var settingsThemeToggle = document.getElementById('settings-theme-toggle')
    var themeIconSun = document.getElementById('theme-icon-sun')
    var themeIconMoon = document.getElementById('theme-icon-moon')

    function applyTheme(theme) {
      currentTheme = theme
      document.documentElement.setAttribute('data-theme', theme)
      localStorage.setItem('vyntra-theme', theme)
      var isObsidian = theme === 'obsidian'
      themeIconSun.classList.toggle('hidden', !isObsidian)
      themeIconMoon.classList.toggle('hidden', isObsidian)
      if (settingsThemeToggle) settingsThemeToggle.checked = !isObsidian
    }
    applyTheme(currentTheme)

    themeToggleBtn.addEventListener('click', function () {
      applyTheme(currentTheme === 'obsidian' ? 'alabaster' : 'obsidian')
    })
    if (settingsThemeToggle) {
      settingsThemeToggle.addEventListener('change', function () {
        applyTheme(this.checked ? 'alabaster' : 'obsidian')
      })
    }

    // ── Accent Color ──
    document.querySelectorAll('.accent-btn').forEach(function (btn) {
