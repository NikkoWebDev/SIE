  // -- GRADES --
  var lastGradesData = null
  function loadGrades(){
    if(!studentId) return
    apiFetch('/api/grades?student_id='+encodeURIComponent(studentId)+'&limit=200').then(function(data){
      var grades = Array.isArray(data) ? data : []
      lastGradesData = grades
      var subjectMap = {}
      grades.forEach(function(g){
        var sid = g.subject_name || g.subject_id || 'General'
        if(!subjectMap[sid]) subjectMap[sid] = []
        subjectMap[sid].push(parseFloat(g.score)||0)
      })
      var labels = Object.keys(subjectMap)
      var values = labels.map(function(sid){
        var vals = subjectMap[sid]
        return vals.reduce(function(a,b){return a+b},0)/vals.length
      })
      var overallAvg = values.length ? values.reduce(function(a,b){return a+b},0)/values.length : 0
      var atRisk = values.filter(function(v){return v<3.5}).length
      var passing = values.filter(function(v){return v>=3.5}).length

      document.getElementById('stat-avg').textContent = overallAvg ? overallAvg.toFixed(1) : '--'
      document.getElementById('stat-subjects').textContent = labels.length
      document.getElementById('stat-passing').textContent = passing
      document.getElementById('stat-bimestre').textContent = getCurrentBimester()

      document.getElementById('welcome-badge-grade').innerHTML = '📚 ' + (userGrade || 'Cargando...')
      document.getElementById('welcome-badge-avg').innerHTML = '🎯 Promedio: ' + (overallAvg ? overallAvg.toFixed(1) : '--') + ' / 5.0'
      document.getElementById('welcome-badge-risk').innerHTML = '\u2705 ' + passing + ' aprobadas'

      var userName = localStorage.getItem('userName') || 'Estudiante'
      document.getElementById('sb-name').textContent = userName
      document.getElementById('sb-grade').textContent = userGrade || ''
      document.getElementById('sb-avatar').textContent = userName.charAt(0).toUpperCase()

      var perfEl = document.getElementById('perf-list')
      perfEl.innerHTML = labels.slice(0,6).map(function(sid,i){
        var v = values[i]; var pct = Math.min((v/5)*100, 100)
        var barClass = v>=4 ? 'green' : v>=3.5 ? 'gold' : ''
        return '<div class="perf-item"><div class="perf-header"><span class="perf-name">'+sid.substring(0,22)+'</span><span class="perf-score">'+v.toFixed(1)+'</span></div><div class="perf-bar-bg"><div class="perf-bar-fill '+barClass+'" style="width:'+pct+'%"></div></div></div>'
      }).join('') || '<div class="perf-item"><span style="opacity:.3">Sin calificaciones</span></div>'

      var tbody = document.getElementById('grades-table-body')
      tbody.innerHTML = labels.map(function(sid,i){
        var v = values[i]
        var status = v>=4 ? '<span class="badge" style="background:rgba(52,199,89,.12);color:#34C759">Aprobado</span>' : v>=3.5 ? '<span class="badge" style="background:rgba(253,192,3,.12);color:#b38000">En curso</span>' : '<span class="badge" style="background:rgba(186,26,26,.1);color:var(--red)">Riesgo</span>'
        var pct = Math.min((v/5)*100, 100)
        var gradesByPeriod = grades.filter(function(g){ return (g.subject_name||g.subject_id||'General') === sid })
        var p1 = gradesByPeriod.find(function(g){ return g.period==='P1'||g.period==='1' })
        var p2 = gradesByPeriod.find(function(g){ return g.period==='P2'||g.period==='2' })
        var p3 = gradesByPeriod.find(function(g){ return g.period==='P3'||g.period==='3' })
        var p4 = gradesByPeriod.find(function(g){ return g.period==='P4'||g.period==='4' })
        return '<tr><td><strong>'+sid.substring(0,25)+'</strong></td><td>'+(p1?parseFloat(p1.score).toFixed(1):'&mdash;')+'</td><td>'+(p2?parseFloat(p2.score).toFixed(1):'&mdash;')+'</td><td>'+(p3?parseFloat(p3.score).toFixed(1):'&mdash;')+'</td><td>'+(p4?parseFloat(p4.score).toFixed(1):'&mdash;')+'</td><td><strong>'+v.toFixed(1)+'</strong></td><td>'+status+'</td><td class="progress-cell">'+Math.round(pct)+'%<div class="table-progress-bg"><div class="table-progress-fill" style="width:'+pct+'%"></div></div></td></tr>'
      }).join('')

      var pAverages = {}; var pCounts = {}
      grades.forEach(function(g){
        var p = g.period || ''
        if(p && p.match(/^P?\d$/)){
          var key = p.replace('P','')
          if(!pAverages[key]){ pAverages[key]=0; pCounts[key]=0 }
          pAverages[key] += parseFloat(g.score)||0; pCounts[key]++
        }
      })
      for(var pi=1; pi<=4; pi++){
        var avg = pAverages[pi] && pCounts[pi] ? (pAverages[pi]/pCounts[pi]) : 0
        var bar = document.getElementById('bar-p'+pi)
        if(bar){ var pct2 = avg ? Math.min((avg/5)*100,100) : 2; bar.style.height=pct2+'%'; bar.setAttribute('data-val', avg?avg.toFixed(1):'\u2014') }
      }

      document.getElementById('pf-avg').textContent = overallAvg ? overallAvg.toFixed(1) : '--'
      document.getElementById('pf-subjects-count').textContent = labels.length
      document.getElementById('pf-passing').textContent = passing
      document.getElementById('pf-risk').textContent = atRisk
    }).catch(function(){})
  }

  function getCurrentBimester(){
    var m = new Date().getMonth()
    if(m>=1&&m<=3) return 'P1'
    if(m>=4&&m<=6) return 'P2'
    if(m>=7&&m<=9) return 'P3'
    return 'P4'
  }

  // -- CHART --
  var performanceChart = null
  function loadChartData(){
    if(!lastGradesData) return
    var grades = lastGradesData
    var subjectMap = {}
    grades.forEach(function(g){
      var sid = g.subject_name || g.subject_id || 'General'
      if(!subjectMap[sid]) subjectMap[sid] = []
      subjectMap[sid].push(parseFloat(g.score)||0)
    })
    var labels = []; var values = []
    Object.keys(subjectMap).forEach(function(sid){
      var vals = subjectMap[sid]
      labels.push(sid.substring(0,16))
      values.push(vals.reduce(function(a,b){return a+b},0)/vals.length)
    })
    renderChart(labels, values)
  }
  function renderChart(labels, values){
    var ctx = document.getElementById('myGradesChart')
    if(!ctx) return
    if(performanceChart) performanceChart.destroy()
    performanceChart = new Chart(ctx, {
      type:'bar',
      data:{ labels:labels, datasets:[{ label:'Promedio', data:values, backgroundColor:values.map(function(v){return v>=4?'rgba(52,211,153,0.7)':v>=3?'rgba(253,192,3,0.7)':'rgba(186,26,26,0.7)'}), borderColor:values.map(function(v){return v>=4?'#34D399':v>=3?'#FDC003':'#BA1A1A'}), borderWidth:2, borderRadius:4 }] },
      options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{ display:false } }, scales:{ y:{ min:0, max:5, ticks:{ color:'rgba(255,255,255,0.3)', stepSize:1 }, grid:{ color:'rgba(255,255,255,0.04)' } }, x:{ ticks:{ color:'rgba(255,255,255,0.5)', maxRotation:30, font:{ size:10 } }, grid:{ display:false } } } }
    })
  }

  // -- PDF --
  window.generarBoletinPDF = function(){
    if(typeof html2pdf === 'undefined'){
      var s = document.createElement('script'); s.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js'
      s.onload = function(){ window.generarBoletinPDF() }; document.body.appendChild(s); return
    }
    var studentName = document.getElementById('student-name').textContent || 'Estudiante'
    var chartCanvas = document.getElementById('myGradesChart')
    var chartImg = ''
    if(chartCanvas && performanceChart) chartImg = chartCanvas.toDataURL('image/png')
    var options = { margin:10, filename:'Boletin_'+studentName.replace(/\s+/g,'_')+'.pdf', html2canvas:{ scale:2 }, jsPDF:{ unit:'mm', format:'a4', orientation:'portrait' } }
    var el = document.createElement('div')
    el.style.cssText = 'padding:30px;font-family:Arial,sans-serif;color:#333;max-width:800px;margin:auto'
    el.innerHTML = '<div style="text-align:center;margin-bottom:20px;border-bottom:3px solid #800000;padding-bottom:15px"><h1 style="color:#800000;margin:0;font-size:22px">Colegio T\u00e9cnico Ciudad del Sol</h1><p style="font-size:14px;color:#666;margin:5px 0 0">Vyntra Academic &mdash; Bolet\u00edn de Calificaciones</p></div>'+
      '<p style="font-size:14px"><strong>Estudiante:</strong> '+studentName+' &middot; <strong>Grado:</strong> '+userGrade+'</p>'+
      '<table style="width:100%;border-collapse:collapse;margin-top:15px"><thead><tr style="background:#800000;color:#fff"><th style="padding:8px;text-align:left;font-size:13px">Asignatura</th><th style="padding:8px;text-align:center;font-size:13px">Nota</th><th style="padding:8px;text-align:center;font-size:13px">Estado</th></tr></thead><tbody>'+
      (performanceChart&&performanceChart.data?performanceChart.data.labels.map(function(l,i){
        var g = performanceChart.data.datasets[0].data[i]
        var status = g>=4?'\u2705 Sobresaliente':g>=3?'\u26a0\ufe0f Aceptable':'\u274c En Riesgo'
        return '<tr style="border-bottom:1px solid #eee"><td style="padding:8px;font-size:13px">'+l+'</td><td style="padding:8px;text-align:center;font-size:13px;font-weight:700">'+g.toFixed(1)+'</td><td style="padding:8px;text-align:center;font-size:12px">'+status+'</td></tr>'
      }).join(''):'')+
      '</tbody></table>'+
      (chartImg?'<div style="margin-top:20px;text-align:center"><img src="'+chartImg+'" style="max-width:100%;height:auto;max-height:250px"></div>':'')+
      '<p style="margin-top:20px;font-size:11px;color:#999;text-align:center">Generado el '+new Date().toLocaleString('es-CO')+' &middot; Vyntra Academic</p>'
    document.body.appendChild(el)
    html2pdf().set(options).from(el).save().then(function(){ document.body.removeChild(el) })
  }

  // -- PERIOD FILTER --
  window.setPeriod = function(el){
    document.querySelectorAll('.period-filter').forEach(function(f){ f.classList.remove('active') })
    el.classList.add('active')
    showToast('Mostrando '+el.getAttribute('data-period')||el.textContent, 'info')
  }

  // -- EXAMS --
  var currentExam = null; var strikes = 0; var isExamActive = false; var isInitializingExam = false; var timerInterval = null; var tiempoRestante = 0; var autoSaveInterval = null
  function loadExams(){
    var el = document.getElementById('available-exams')
    apiFetch('/api/student/exams').then(function(data){
      if(!Array.isArray(data)||data.length===0){ el.innerHTML='<span style="opacity:.3">No hay ex\u00e1menes disponibles.</span>'; return }
      el.innerHTML = '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:.75rem">'+
        data.map(function(e){ return '<div class="exam-card" onclick="abrirExamen(\''+e.id+'\')"><strong style="font-size:.8125rem;color:#fff">'+(e.title||'Examen')+'</strong><div style="display:flex;gap:.75rem;margin-top:.5rem;font-size:.65rem;opacity:.35"><span>'+(e.duration_minutes||'?')+' min</span><span>'+(e.questions?e.questions.length:0)+' preg</span></div></div>' }).join('')+'</div>'
    }).catch(function(){ showToast('Error al cargar ex\u00e1menes','error'); el.innerHTML='<span style="color:var(--red);font-size:.75rem">Error al cargar ex\u00e1menes</span>' })
  }
  window.abrirExamen = function(examId){
    if(!studentId) return
    apiFetch('/api/student/exam/'+examId).then(function(exam){
      if(!exam||!exam.questions){ alert('Examen no encontrado'); return }
      currentExam = exam; isInitializingExam = true; strikes = 0
      document.getElementById('exam-modal-title').textContent = exam.title||'Examen'
      document.getElementById('strike-badge').style.display = 'none'
      apiFetch('/api/exam/progress/'+studentId+'/'+examId).then(function(progress){
        if(progress&&progress.answers&&Object.keys(progress.answers).length>0) restoreExamProgress(progress)
      }).catch(function(){})
      var html = ''
      exam.questions.forEach(function(q,qi){
        html += '<div class="exam-question-card"><div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.75rem"><span style="width:24px;height:24px;border-radius:50%;background:rgba(253,192,3,.15);color:#FDC003;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.75rem">'+(qi+1)+'</span><strong style="font-size:.8125rem;color:rgba(255,255,255,.9)">'+(q.question_text||'')+'</strong></div>'
        var opts = q.options||['A','B','C','D']
        opts.forEach(function(o,oi){
          var optText = typeof o==='string'?o:(o.text||o.value||'Opci\u00f3n '+String.fromCharCode(65+oi))
          html += '<label class="exam-option"><input type="radio" name="p'+qi+'" value="'+oi+'" style="display:none"><span class="opt-label" style="flex:1">'+optText+'</span></label>'
        })
        html += '</div>'
      })
      document.getElementById('examen-preguntas-render').innerHTML = html
      document.getElementById('exam-modal').classList.add('open')
      document.body.style.overflow = 'hidden'
      activarPantallaCompleta()
      iniciarCronometro(exam.duration_minutes||60)
      setTimeout(function(){ isInitializingExam=false; isExamActive=true }, 2500)
      if(autoSaveInterval) clearInterval(autoSaveInterval)
      autoSaveInterval = setInterval(function(){ if(isExamActive&&currentExam) saveExamProgress() }, 30000)
      setupSecurityListeners()
    }).catch(function(){ showToast('Error al abrir el examen','error') })
  }
  function restoreExamProgress(progress){
    if(!progress.answers||!currentExam) return
    currentExam.questions.forEach(function(q,qi){
      var savedAnswer = progress.answers[String(qi)]
      if(savedAnswer!==undefined&&savedAnswer!==null&&savedAnswer>=0){
        var radio = document.querySelector('input[name="p'+qi+'"][value="'+savedAnswer+'"]')
        if(radio) radio.checked = true
      }
    })
    if(progress.time_elapsed_seconds&&progress.time_elapsed_seconds>0){
      tiempoRestante = Math.max(10, (currentExam.duration_minutes||60)*60 - progress.time_elapsed_seconds)
    }
    showToast('Progreso restaurado','info')
  }
  function saveExamProgress(){
    if(!currentExam||!currentExam.questions) return
    var answers = {}
    var initialDuration = (currentExam.duration_minutes||60)*60
    currentExam.questions.forEach(function(q,qi){
      var selected = document.querySelector('input[name="p'+qi+']:checked')
      if(selected) answers[String(qi)] = parseInt(selected.value)
    })
    apiFetch('/api/exam/save-progress',{ method:'POST', body:{ student_id:studentId, exam_id:currentExam.id, answers:answers, current_question_index:0, time_elapsed_seconds:initialDuration-tiempoRestante }}).catch(function(){})
  }
  function iniciarCronometro(minutos){
    tiempoRestante = Math.max(minutos*60,10)
    if(timerInterval) clearInterval(timerInterval)
    timerInterval = setInterval(function(){
      tiempoRestante--
      var m=Math.floor(tiempoRestante/60);var s=tiempoRestante%60
      var display = document.getElementById('timer-display')
      if(display){
        display.textContent = String(m).padStart(2,'0')+':'+String(s).padStart(2,'0')
        display.className = 'timer-display'+(tiempoRestante<=60?' warning':'')
      }
      if(tiempoRestante<=0){ clearInterval(timerInterval); window.finalizarExamen(true,'TIEMPO AGOTADO') }
    },1000)
  }
  var examSubmitting = false
  window.finalizarExamen = function(auto, motivo){
    if(examSubmitting) return
    if(!auto&&!confirm('\u00bfEnviar respuestas ahora?')) return
    examSubmitting = true
    if(timerInterval) clearInterval(timerInterval)
    isExamActive=false; isInitializingExam=true
    if(!currentExam||!currentExam.questions){ window.cerrarModalExamen(); examSubmitting=false; return }
    var answers = []
    currentExam.questions.forEach(function(q,qi){
      var selected = document.querySelector('input[name="p'+qi+']:checked')
      answers.push(selected?parseInt(selected.value):-1)
    })
    apiFetch('/api/student/submit-exam',{ method:'POST', body:{ exam_id:currentExam.id, student_id:studentId, answers:answers }}).then(function(res){
      alert(motivo?'Examen finalizado: '+motivo:'Examen enviado. Calificaci\u00f3n: '+(res.grade||'\u2014'))
      window.cerrarModalExamen(); loadExams(); loadGrades(); examSubmitting=false
    }).catch(function(e){ showToast('Error al enviar: '+(e.message||'desconocido'),'error'); window.cerrarModalExamen(); examSubmitting=false })
  }
  window.intentarSalirManual = function(){
    if(confirm('\u00bfSalir del examen? Las respuestas se enviar\u00e1n autom\u00e1ticamente.')) window.finalizarExamen(true,'SALIDA VOLUNTARIA')
  }
  function activarPantallaCompleta(){
    var el = document.documentElement
    if(el.requestFullscreen) el.requestFullscreen()
    else if(el.webkitRequestFullscreen) el.webkitRequestFullscreen()
    else if(el.msRequestFullscreen) el.msRequestFullscreen()
  }
  function setupSecurityListeners(){
    document.removeEventListener('visibilitychange', onVisibilityChange)
    document.removeEventListener('fullscreenchange', onFullscreenChange)
    document.addEventListener('visibilitychange', onVisibilityChange)
    document.addEventListener('fullscreenchange', onFullscreenChange)
  }
  function onVisibilityChange(){ if(!isExamActive||isInitializingExam) return; if(document.hidden) sumarStrikes(1,'Cambio de pesta\u00f1a') }
  function onFullscreenChange(){ if(!isExamActive||isInitializingExam||!currentExam) return; if(!document.fullscreenElement) sumarStrikes(1,'Sali\u00f3 de pantalla completa') }
  window.cerrarModalExamen = function(){
    document.removeEventListener('visibilitychange', onVisibilityChange)
    document.removeEventListener('fullscreenchange', onFullscreenChange)
    if(timerInterval) clearInterval(timerInterval)
    if(autoSaveInterval){ clearInterval(autoSaveInterval); autoSaveInterval=null }
    isExamActive=false; currentExam=null
    if(document.fullscreenElement) document.exitFullscreen()
    document.getElementById('exam-modal').classList.remove('open')
    document.body.style.overflow = ''
  }
  function sumarStrikes(cant, motivo){
    if(!currentExam) return; strikes += cant
    document.getElementById('strike-badge').style.display = 'inline-flex'; document.getElementById('strike-val').textContent = strikes
    apiFetch('/api/exams/report-incident',{ method:'POST', body:{ student_id:studentId, exam_id:currentExam.id||currentExam._id, incident_type:motivo, severity:strikes>=3?'high':'low', strikes:strikes }}).catch(function(){})
    if(strikes>=5){ alert('\u26d4 Has superado el l\u00edmite de infracciones de seguridad.'); window.finalizarExamen(true,'M\u00faltiples infracciones de seguridad') }
  }

  // -- VOTING --
