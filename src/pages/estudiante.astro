    // ── AI Skill Quiz ──
    var quizState = { subject: '', questions: [], currentIdx: 0, score: 0, answered: false }

    document.getElementById('quiz-start-btn').addEventListener('click', async function () {
      var subject = document.getElementById('quiz-subject-select').value
      if (!subject) { showToast('Selecciona una materia primero', 'error'); return }
      quizState.subject = subject
      quizState.score = 0
      quizState.currentIdx = 0
      quizState.answered = false
      var btn = this
      btn.disabled = true
      btn.innerHTML = '<svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg> Generando...'
      try {
        var res = await fetch(apiUrl + '/api/ai/student-tutor', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
          body: JSON.stringify({
            message: 'Genera un quiz de 3 a 5 preguntas de opción múltiple sobre la materia "' + subject + '" para un estudiante de grado 11. Devuelve SOLO un array JSON con objetos: {"question": "...", "options": ["A) ...", "B) ...", "C) ...", "D) ..."], "correct": 0} donde correct es el índice de la respuesta correcta (0-3). No incluyas explicación, solo el JSON.',
            context: '',
          }),
        })
        if (!res.ok) throw new Error('Error del asistente')
        var reader = res.body.getReader()
        var decoder = new TextDecoder()
        var buffer = ''
        var fullText = ''
        while (true) {
          var result = await reader.read()
          if (result.done) break
          buffer += decoder.decode(result.value, { stream: true })
          var lines = buffer.split('\n')
          buffer = lines.pop() || ''
          for (var i = 0; i < lines.length; i++) {
            var line = lines[i]
            if (line.startsWith('data: ')) {
              var data = line.slice(6)
              if (data === '[DONE]' || data === 'data: [DONE]') continue
              try { var parsed = JSON.parse(data); if (parsed.token) fullText += parsed.token } catch (_) {}
            }
          }
        }
        var jsonMatch = fullText.match(/\[[\s\S]*?\]/)
        var questions = jsonMatch ? JSON.parse(jsonMatch[0]) : null
        if (!questions || !Array.isArray(questions) || questions.length < 2) throw new Error('No se pudieron generar preguntas')
        quizState.questions = questions
        showQuizQuestion()
      } catch (e) {
        showToast('Error al generar quiz: ' + e.message, 'error')
        btn.disabled = false
        btn.innerHTML = '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Iniciar Desafío'
        return
      }
      btn.disabled = false
      btn.innerHTML = '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Iniciar Desafío'
      document.getElementById('quiz-setup').classList.add('hidden')
      document.getElementById('quiz-active').classList.remove('hidden')
      document.getElementById('quiz-results').classList.add('hidden')
    })

    function showQuizQuestion() {
      var qs = quizState.questions
      var idx = quizState.currentIdx
      if (idx >= qs.length) { showQuizResults(); return }
      var q = qs[idx]
      document.getElementById('quiz-subject-label').textContent = quizState.subject
      document.getElementById('quiz-progress').textContent = 'Pregunta ' + (idx + 1) + ' de ' + qs.length
      document.getElementById('quiz-question').textContent = q.question
      var optionsDiv = document.getElementById('quiz-options')
      optionsDiv.innerHTML = q.options.map(function (o, i) {
        return '<label class="flex items-center gap-3 rounded-xl border border-white/[0.06] bg-white/[0.03] px-4 py-3 cursor-pointer hover:bg-white/[0.06] transition-all quiz-option" data-idx="' + i + '"><input type="radio" name="quiz-answer" value="' + i + '" class="sr-only" /><span class="h-4 w-4 rounded-full border-2 border-white/[0.15] flex items-center justify-center shrink-0"><span class="h-2 w-2 rounded-full hidden bg-brand-maroon"></span></span><span class="text-sm theme-text-secondary">' + o + '</span></label>'
      }).join('')
      quizState.answered = false
      document.getElementById('quiz-submit-btn').classList.remove('hidden')
      document.getElementById('quiz-next-btn').classList.add('hidden')
      document.getElementById('quiz-options').querySelectorAll('input[type="radio"]').forEach(function (r) {
        r.addEventListener('change', function () {
          document.querySelectorAll('.quiz-option').forEach(function (l) { l.querySelector('span span').classList.add('hidden'); l.querySelector('span').style.borderColor = 'rgba(255,255,255,0.15)' })
          var label = this.closest('.quiz-option')
          label.querySelector('span').style.borderColor = '#800000'
          label.querySelector('span span').classList.remove('hidden')
        })
      })
    }

    document.getElementById('quiz-submit-btn').addEventListener('click', function () {
      if (quizState.answered) return
      var selected = document.querySelector('input[name="quiz-answer"]:checked')
      if (!selected) { showToast('Selecciona una respuesta', 'error'); return }
      var q = quizState.questions[quizState.currentIdx]
      var answerIdx = parseInt(selected.value)
      var isCorrect = answerIdx === q.correct
      quizState.answered = true
      if (isCorrect) quizState.score++
      document.querySelectorAll('.quiz-option').forEach(function (label, i) {
        var idx = parseInt(label.getAttribute('data-idx'))
        if (idx === q.correct) { label.style.borderColor = '#00FF66'; label.querySelector('span').style.borderColor = '#00FF66'; label.querySelector('span span').classList.remove('hidden'); label.querySelector('span span').style.background = '#00FF66' }
        else if (idx === answerIdx && !isCorrect) { label.style.borderColor = '#FF0055'; label.querySelector('span').style.borderColor = '#FF0055' }
      })
      document.querySelectorAll('input[name="quiz-answer"]').forEach(function (r) { r.disabled = true })
      this.classList.add('hidden')
      var nextBtn = document.getElementById('quiz-next-btn')
      nextBtn.classList.remove('hidden')
      nextBtn.textContent = quizState.currentIdx + 1 >= quizState.questions.length ? 'Ver resultados' : 'Siguiente'
    })

    document.getElementById('quiz-next-btn').addEventListener('click', function () {
      quizState.currentIdx++
      document.querySelectorAll('input[name="quiz-answer"]').forEach(function (r) { r.disabled = false; r.checked = false })
      document.querySelectorAll('.quiz-option').forEach(function (l) { l.style.borderColor = 'rgba(255,255,255,0.06)'; l.querySelector('span').style.borderColor = 'rgba(255,255,255,0.15)'; l.querySelector('span span').style.background = ''; l.querySelector('span span').classList.add('hidden') })
      showQuizQuestion()
    })

    function showQuizResults() {
      document.getElementById('quiz-active').classList.add('hidden')
      document.getElementById('quiz-results').classList.remove('hidden')
      var total = quizState.questions.length
      var scorePct = Math.round(quizState.score / total * 100)
      var badge = scorePct >= 80 ? { label: 'Oro', icon: '🥇', emoji: '🏆' } : scorePct >= 50 ? { label: 'Plata', icon: '🥈', emoji: '⭐' } : { label: 'Bronce', icon: '🥉', emoji: '💪' }
      document.getElementById('quiz-results-icon').textContent = badge.emoji
      document.getElementById('quiz-results-score').textContent = quizState.score + '/' + total + ' (' + scorePct + '%)'
      document.getElementById('quiz-results-badge').textContent = 'Insignia: ' + badge.label + ' ' + badge.icon
      localStorage.setItem('vyntra-skill-badge', badge.label)
      showToast('¡' + badge.label + '! Has obtenido la insignia ' + badge.label + '.', 'success')
    }

    document.getElementById('quiz-retry-btn').addEventListener('click', function () {
      document.getElementById('quiz-results').classList.add('hidden')
      document.getElementById('quiz-setup').classList.remove('hidden')
      document.getElementById('quiz-badge').classList.remove('hidden')
      document.getElementById('quiz-badge-label').textContent = localStorage.getItem('vyntra-skill-badge') || '—'
    })

    // ── Telemetry: Headless Outage Detection ──
    ;(function setupTelemetry() {
      var offlineStart = null
      var isFrozen = false
      var pendingOutage = null
      var freezeOverlay = document.getElementById('telemetry-freeze-overlay')
      var connDot = document.getElementById('conn-dot')
      var connText = document.getElementById('conn-text')
      var outageSubmittedKey = 'vyntra-outage-pending-' + userId
      var examSnapshotKey = 'vyntra-exam-snapshot'

      function freezeUI() {
        if (isFrozen) return
        isFrozen = true
        freezeOverlay.classList.remove('hidden')
        connDot.className = 'h-2 w-2 rounded-full bg-[#FF0055] animate-pulse'
        connText.textContent = 'Desconectado'
      }

      function unfreezeUI() {
        isFrozen = false
        freezeOverlay.classList.add('hidden')
        connDot.className = 'h-2 w-2 rounded-full bg-emerald-500 animate-pulse'
        connText.textContent = 'Conectado'
      }

      async function submitOutageReport() {
        var examId = localStorage.getItem('active_exam_id') || 'unknown'
        var snapshot = localStorage.getItem(examSnapshotKey)
        var payload = {
          student_id: userId,
          exam_id: examId,
          incident_type: 'network_loss',
          description: 'Conexión perdida por más de 12 segundos durante el examen. Reanudación automática.',
        }
        if (snapshot) payload.snapshot = snapshot
        try {
          var res = await fetch(apiUrl + '/api/students/report-outage', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
            body: JSON.stringify(payload),
          })
          if (res.ok) {
            localStorage.removeItem(outageSubmittedKey)
            localStorage.removeItem(examSnapshotKey)
            pendingOutage = null
            showToast('Evaluación protegida. Puedes continuar.', 'success')
            return true
          }
        } catch (_) {}
        return false
      }

      // Save exam snapshot periodically when exam is active
      function saveExamSnapshot() {
        if (localStorage.getItem('active_exam_id')) {
          var snapshot = { savedAt: Date.now(), userId: userId }
          localStorage.setItem(examSnapshotKey, JSON.stringify(snapshot))
        }
      }

      window.addEventListener('offline', function () {
        offlineStart = Date.now()
        connDot.className = 'h-2 w-2 rounded-full bg-amber-500 animate-pulse'
        connText.textContent = 'Verificando...'
        // Start checking offline duration
        var checkInterval = setInterval(function () {
          if (navigator.onLine) { clearInterval(checkInterval); return }
          if (offlineStart && (Date.now() - offlineStart >= 12000)) {
            clearInterval(checkInterval)
            if (localStorage.getItem('active_exam_id')) {
              saveExamSnapshot()
              freezeUI()
              pendingOutage = true
              localStorage.setItem(outageSubmittedKey, 'true')
            }
          }
        }, 1000)
      })

      window.addEventListener('online', async function () {
        offlineStart = null
        if (pendingOutage || localStorage.getItem(outageSubmittedKey)) {
          var submitted = await submitOutageReport()
          if (submitted) unfreezeUI()
          else {
            // Silent retry loop
            var retries = 0
            var retryInterval = setInterval(async function () {
              retries++
              var ok = await submitOutageReport()
              if (ok || retries > 10) { clearInterval(retryInterval); if (ok) unfreezeUI() }
            }, 3000)
          }
        } else {
          unfreezeUI()
        }
      })

      // Heartbeat every 5s
      setInterval(async function () {
        saveExamSnapshot()
        try {
          var hRes = await fetch(apiUrl + '/api/health', { method: 'HEAD', cache: 'no-cache', signal: AbortSignal.timeout(5000) })
          if (hRes.ok || hRes.status === 204) {
            if (!navigator.onLine) return
            if (localStorage.getItem(outageSubmittedKey) && isFrozen) {
              var ok = await submitOutageReport()
              if (ok) unfreezeUI()
            }
            if (!isFrozen) {
              connDot.className = 'h-2 w-2 rounded-full bg-emerald-500 animate-pulse'
              connText.textContent = 'Conectado'
            }
          } else { throw new Error('not ok') }
        } catch (_) {
          if (navigator.onLine && !isFrozen) {
            connDot.className = 'h-2 w-2 rounded-full bg-amber-500 animate-pulse'
            connText.textContent = 'Latencia alta'
          }
        }
      }, 5000)

      // Check for pending outage from previous session
      if (localStorage.getItem(outageSubmittedKey)) {
        pendingOutage = true
        submitOutageReport().then(function (ok) {
          if (ok) { localStorage.removeItem(outageSubmittedKey); unfreezeUI() }
        })
      }
    })()
  })()
</script>
