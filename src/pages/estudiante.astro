  }

  [data-theme="alabaster"] #main-container { background: #F5F0EB; }
  [data-theme="alabaster"] .glass-card-student {
    background: rgba(255,255,255,0.7);
    border-color: rgba(0,0,0,0.06);
  }
  [data-theme="alabaster"] .glass-card-student:hover {
    background: rgba(255,255,255,0.85);
