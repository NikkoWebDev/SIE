---
import Layout from '@layouts/Layout.astro'
import FloatingPillNav from '@components/FloatingPillNav.astro'
import WsRiskAlert from '@components/WsRiskAlert.astro'
import AIChat from '@components/AIChat.astro'
import ScoreOrbital from '@components/ScoreOrbital.astro'
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000'
const studentId = "USER_ID_PLACEHOLDER"
---

<Layout titulo="Panel Estudiante · C sol SIE" sinMenu>
  <FloatingPillNav userRole="ESTUDIANTE" />
  <div class="noise-overlay"></div>

  <div class="relative min-h-screen theme-aware-bg" id="main-container">
    <!-- Grid background -->
    <div class="absolute inset-0 pointer-events-none grid-bg"></div>
    <!-- Solar atmosphere (obsidian only) -->
    <div class="solar-glow" id="solar-glow"></div>
    <div class="solar-ring-bg" id="solar-ring"></div>
    <div class="orbit-container" id="orbit-1">
      <div class="orbit-dot"></div><div class="orbit-dot"></div>
      <div class="orbit-dot"></div><div class="orbit-dot"></div>
    </div>
    <div class="orbit-container-2" id="orbit-2">
      <div class="orbit-dot-2"></div><div class="orbit-dot-2"></div>
      <div class="orbit-dot-2"></div>
    </div>
    <div class="glow-orb-maroon"></div>
    <div class="glow-orb-amber"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 lg:py-10">
      <!-- Header -->
      <div class="flex items-center justify-between mb-8 fade-in-section">
        <div>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight theme-text-primary" style="font-family:'Syne',sans-serif">
            <span id="student-name">Cargando...</span>
          </h1>
          <p class="text-sm theme-text-tertiary mt-1" id="student-meta">Panel de rendimiento académico</p>
        </div>
        <div class="flex items-center gap-2">
          <button id="settings-toggle-btn" class="h-9 w-9 rounded-xl bg-white/[0.04] border border-white/[0.06] flex items-center justify-center hover:bg-white/[0.08] transition-all" title="Ajustes">
            <svg class="h-4 w-4 theme-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </button>
          <button id="theme-toggle-btn" class="h-9 w-9 rounded-xl bg-white/[0.04] border border-white/[0.06] flex items-center justify-center hover:bg-white/[0.08] transition-all" title="Cambiar tema">
            <svg id="theme-icon-sun" class="h-4 w-4 text-amber-400 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            <svg id="theme-icon-moon" class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
          </button>
          <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10">
            <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse" id="conn-dot"></span>
            <span class="text-xs font-medium theme-text-tertiary" id="conn-text">Conectado</span>
          </div>
          <div class="h-10 w-10 rounded-full bg-brand-maroon flex items-center justify-center text-amber-300 font-bold text-sm shadow-sm ring-2 ring-white/10">
            <span id="student-initial">C</span>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- LEFT COLUMN -->
        <div class="lg:col-span-2 space-y-6">

          <!-- CARD 1: Academic Status -->
          <div class="glass-card-student overflow-hidden fade-in-section">
            <div class="flex items-center justify-between px-6 py-4 border-b border-white/[0.06]">
              <div class="flex items-center gap-3">
                <div class="h-9 w-9 rounded-xl bg-brand-maroon/20 flex items-center justify-center">
                  <svg class="h-5 w-5 text-brand-maroon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                </div>
                <div>
                  <h2 class="text-sm font-semibold theme-text-primary">Rendimiento Académico</h2>
                  <p class="text-xs theme-text-tertiary">Notas ABP por materia</p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="text-right">
                  <span class="text-xs theme-text-tertiary">Promedio</span>
                  <p class="text-lg font-bold" id="avg-score-display" style="font-family:'Syne',sans-serif">--</p>
                </div>
                <div class="h-14 w-14 relative">
                  <svg class="w-14 h-14 -rotate-90" viewBox="0 0 36 36">
                    <circle cx="18" cy="18" r="15.5" fill="none" class="stroke-white/[0.06]" stroke-width="3" />
                    <circle id="avg-ring" cx="18" cy="18" r="15.5" fill="none" stroke="#800000" stroke-width="3" stroke-linecap="round" stroke-dasharray="97.4" stroke-dashoffset="97.4" class="transition-all duration-1000 ease-out" style="filter: drop-shadow(0 0 4px currentColor);" />
                  </svg>
                </div>
              </div>
            </div>
            <div class="p-6">
              <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3" id="metrics-grid">
                <div class="h-20 rounded-xl shimmer-skeleton-student"></div>
                <div class="h-20 rounded-xl shimmer-skeleton-student"></div>
                <div class="h-20 rounded-xl shimmer-skeleton-student"></div>
              </div>
            </div>
          </div>

          <!-- CARD 2: Hybrid ABP Hub -->
          <div class="glass-card-student overflow-hidden fade-in-section">
            <div class="flex items-center justify-between px-6 py-4 border-b border-white/[0.06]">
              <div class="flex items-center gap-3">
                <div class="h-9 w-9 rounded-xl bg-amber-500/15 flex items-center justify-center">
                  <svg class="h-5 w-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                </div>
                <div>
                  <h2 class="text-sm font-semibold theme-text-primary">Hub ABP Integrador</h2>
                  <p class="text-xs theme-text-tertiary">Gestión de proyectos y entregas</p>
                </div>
              </div>
              <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-full">Activo</span>
            </div>
            <div class="flex border-b border-white/[0.06] bg-white/[0.01]">
              <button class="abp-tab-btn active flex-1 py-3 text-xs font-semibold uppercase tracking-wider transition-all" data-abp-tab="parciales">
                <span class="flex items-center justify-center gap-1.5">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
                  Entregas Parciales
                </span>
              </button>
              <button class="abp-tab-btn flex-1 py-3 text-xs font-semibold uppercase tracking-wider transition-all" data-abp-tab="transversal">
                <span class="flex items-center justify-center gap-1.5">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                  Proyecto Transversal
                </span>
              </button>
            </div>
            <!-- Entregas Parciales -->
            <div id="abp-parciales" class="p-6">
              <div class="grid grid-cols-3 gap-2" id="abp-subjects-grid">
                <div class="h-16 rounded-lg shimmer-skeleton-student"></div>
                <div class="h-16 rounded-lg shimmer-skeleton-student"></div>
                <div class="h-16 rounded-lg shimmer-skeleton-student"></div>
                <div class="h-16 rounded-lg shimmer-skeleton-student"></div>
                <div class="h-16 rounded-lg shimmer-skeleton-student"></div>
                <div class="h-16 rounded-lg shimmer-skeleton-student"></div>
                <div class="h-16 rounded-lg shimmer-skeleton-student"></div>
                <div class="h-16 rounded-lg shimmer-skeleton-student"></div>
                <div class="h-16 rounded-lg shimmer-skeleton-student"></div>
              </div>
            </div>
            <!-- Proyecto Transversal -->
            <div id="abp-transversal" class="p-6 hidden">
              <div id="abp-dropzone" class="flex flex-col items-center justify-center rounded-xl border-2 border-dashed border-white/[0.08] bg-white/[0.02] py-10 px-6 transition-all hover:border-amber-500/30 hover:bg-amber-500/[0.02] cursor-pointer">
                <svg class="h-10 w-10 text-amber-400/60 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                <p class="text-sm font-medium theme-text-secondary mb-1">Proyecto Transversal Integrador</p>
                <p class="text-xs theme-text-tertiary mb-4">Arrastra tu macro-entregable aquí o haz clic para seleccionar</p>
                <input id="abp-transversal-file" type="file" class="hidden" accept=".pdf,.doc,.docx,.zip,.rar,.7z" />
                <button id="abp-transversal-select-btn" class="px-4 py-2 rounded-xl bg-amber-500/10 border border-amber-500/20 text-xs font-semibold text-amber-400 hover:bg-amber-500/20 transition-all">Seleccionar archivo</button>
                <p id="abp-transversal-filename" class="text-xs theme-text-tertiary mt-3 hidden"></p>
              </div>
              <div class="mt-4">
                <div class="flex items-center justify-between text-xs theme-text-tertiary mb-1.5">
                  <span>Progreso del proyecto</span>
                  <span class="font-semibold theme-text-primary" id="abp-progress-pct">0%</span>
                </div>
                <div class="h-2 rounded-full bg-white/[0.06] overflow-hidden">
                  <div id="abp-progress-bar" class="h-full rounded-full bg-amber-500 transition-all duration-1000" style="width:0%"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- CARD 3: Schedule -->
          <div class="glass-card-student overflow-hidden fade-in-section">
            <div class="flex items-center justify-between px-6 py-4 border-b border-white/[0.06]">
              <div class="flex items-center gap-3">
                <div class="h-9 w-9 rounded-xl bg-brand-maroon/20 flex items-center justify-center">
                  <svg class="h-5 w-5 text-brand-maroon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                </div>
                <div>
                  <h2 class="text-sm font-semibold theme-text-primary">Horario & Tareas</h2>
                  <p class="text-xs theme-text-tertiary">VYNTRA Go · Cronograma semanal</p>
                </div>
              </div>
              <span class="text-[10px] font-semibold uppercase tracking-wider text-amber-400 bg-amber-500/10 px-3 py-1 rounded-full">Semana activa</span>
            </div>
            <div class="p-6">
              <div class="space-y-0" id="schedule-list">
                <div class="h-14 rounded-xl shimmer-skeleton-student"></div>
                <div class="h-14 rounded-xl shimmer-skeleton-student"></div>
                <div class="h-14 rounded-xl shimmer-skeleton-student"></div>
                <div class="h-14 rounded-xl shimmer-skeleton-student"></div>
                <div class="h-14 rounded-xl shimmer-skeleton-student"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class="space-y-6">

          <!-- CARD 4: Financial Status -->
          <div class="glass-card-student overflow-hidden fade-in-section">
            <div class="flex items-center gap-3 px-6 py-4 border-b border-white/[0.06]">
              <div class="h-9 w-9 rounded-xl bg-brand-maroon/20 flex items-center justify-center">
                <svg class="h-5 w-5 text-brand-maroon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h2 class="text-sm font-semibold theme-text-primary">Estado Financiero</h2>
                <p class="text-xs theme-text-tertiary">Situación de pagos</p>
              </div>
            </div>
            <div class="p-6" id="financial-card">
              <div class="flex items-center gap-4">
                <div class="h-14 w-14 rounded-full bg-white/5 flex items-center justify-center shrink-0" id="fin-icon-container">
                  <svg class="h-7 w-7 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold theme-text-primary" id="fin-status-label">Consultando...</p>
                  <p class="text-xs theme-text-tertiary" id="fin-status-detail">Estado de cuenta</p>
                </div>
              </div>
              <!-- Financial lock alert (appears when blocked) -->
              <div id="fin-lock-alert" class="hidden mt-4 rounded-xl bg-[#800000]/15 border border-[#800000]/25 p-4">
                <div class="flex items-center gap-3">
                  <svg class="h-5 w-5 text-[#800000] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                  <div>
                    <p class="text-xs font-semibold text-[#800000]">Acceso restringido por mora</p>
                    <p class="text-[11px] text-[#800000]/70 mt-0.5">La descarga de boletín y exámenes estará disponible al regularizar tu situación financiera.</p>
                  </div>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-white/[0.06]">
                <div class="flex items-center justify-between text-sm">
                  <span class="theme-text-tertiary">Meses en mora</span>
                  <span class="font-semibold theme-text-primary" id="fin-months">--</span>
                </div>
                <div class="flex items-center justify-between text-sm mt-2">
                  <span class="theme-text-tertiary">Saldo pendiente</span>
                  <span class="font-semibold theme-text-primary" id="fin-balance">--</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Summary -->
          <div class="glass-card-student overflow-hidden fade-in-section">
            <div class="px-6 py-4 border-b border-white/[0.06]">
              <h2 class="text-sm font-semibold theme-text-primary">Resumen Académico</h2>
            </div>
            <div class="p-6 space-y-4" id="summary-section">
              <div class="flex items-center justify-between">
                <span class="text-sm theme-text-tertiary">Estado general</span>
                <span id="summary-status" class="text-sm font-semibold text-gray-400">--</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-sm theme-text-tertiary">Materias cursando</span>
                <span id="summary-subjects" class="text-sm font-semibold theme-text-primary">--</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-sm theme-text-tertiary">Áreas en riesgo</span>
                <span id="summary-risk" class="text-sm font-semibold text-brand-danger">--</span>
              </div>
            </div>
          </div>

          <!-- CARD 5: Recursos Académicos (Material Locker + AI Quiz) -->
          <div class="glass-card-student overflow-hidden fade-in-section">
            <div class="flex items-center gap-3 px-6 py-4 border-b border-white/[0.06]">
              <div class="h-9 w-9 rounded-xl bg-emerald-500/15 flex items-center justify-center">
                <svg class="h-5 w-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
              </div>
              <div>
                <h2 class="text-sm font-semibold theme-text-primary">Recursos Académicos</h2>
                <p class="text-xs theme-text-tertiary">Materiales, documentos y desafíos</p>
              </div>
            </div>
            <div class="flex border-b border-white/[0.06] bg-white/[0.01]">
              <button class="recurso-tab-btn active flex-1 py-2.5 text-[11px] font-semibold uppercase tracking-wider transition-all" data-tab="docs">Documentos</button>
              <button class="recurso-tab-btn flex-1 py-2.5 text-[11px] font-semibold uppercase tracking-wider transition-all" data-tab="materiales">Materiales</button>
              <button class="recurso-tab-btn flex-1 py-2.5 text-[11px] font-semibold uppercase tracking-wider transition-all" data-tab="quiz">Quiz IA</button>
            </div>

            <!-- Documents sub-tab -->
            <div id="recurso-docs" class="p-6 space-y-2">
              <div id="locker-unlocked">
                <button class="locker-doc-btn flex w-full items-center gap-3 rounded-xl border border-white/[0.06] bg-white/[0.03] px-4 py-3 text-sm font-medium theme-text-secondary hover:bg-white/[0.06] hover:border-amber-500/30 transition-all text-left" data-doc="boletin">
                  <svg class="h-5 w-5 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                  <span class="flex-1">Boletín Académico</span>
                  <svg class="h-4 w-4 theme-text-quaternary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                </button>
                <button class="locker-doc-btn flex w-full items-center gap-3 rounded-xl border border-white/[0.06] bg-white/[0.03] px-4 py-3 text-sm font-medium theme-text-secondary hover:bg-white/[0.06] hover:border-amber-500/30 transition-all text-left" data-doc="reporte">
                  <svg class="h-5 w-5 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                  <span class="flex-1">Reporte de Notas</span>
                  <svg class="h-4 w-4 theme-text-quaternary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                </button>
                <button class="locker-doc-btn flex w-full items-center gap-3 rounded-xl border border-white/[0.06] bg-white/[0.03] px-4 py-3 text-sm font-medium theme-text-secondary hover:bg-white/[0.06] hover:border-amber-500/30 transition-all text-left" data-doc="horario">
                  <svg class="h-5 w-5 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  <span class="flex-1">Horario Semanal</span>
                  <svg class="h-4 w-4 theme-text-quaternary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                </button>
              </div>
              <!-- Exam link cards (locked when in arrears) -->
              <div id="exam-links-section" class="mt-3 pt-3 border-t border-white/[0.06] space-y-2">
