  window.handleDrop = function(e){
    e.preventDefault(); document.getElementById('dropzoneArea').classList.remove('dragover')
    var files = e.dataTransfer.files
    if(files.length){
      var fi = document.getElementById('hw-file'); fi.files = files
      document.getElementById('file-name-display').textContent = '📄 '+files[0].name
      showToast('Archivo adjunto: '+files[0].name,'success')
    }
  }
  window.sendHomework = function(){
    var sel = document.getElementById('hw-subject'); var fileInput = document.getElementById('hw-file'); var title = document.getElementById('hw-title')
    if(!sel.value||!fileInput.files[0]){ showToast('Selecciona una asignatura y un archivo.','error'); return }
    var fd = new FormData()
    fd.append('student_id', studentId); fd.append('grade', userGrade); fd.append('subject', sel.value)
    if(title.value) fd.append('title', title.value)
    fd.append('file', fileInput.files[0])
    fetch(apiUrl+'/api/student/upload-homework',{ method:'POST', headers:{ 'Authorization':'Bearer '+token }, body:fd }).then(function(r){
      if(!r.ok) throw new Error('Error '+r.status); return r.json()
    }).then(function(){
      alert('\u2713 Tarea subida correctamente'); fileInput.value=''; document.getElementById('file-name-display').textContent=''
      if(title) title.value=''; loadHomeworkHistory()
    }).catch(function(e){ showToast('Error: '+(e.message||'desconocido'),'error') })
  }
  function loadHomeworkHistory(){
    var el = document.getElementById('homework-history')
    apiFetch('/api/student/deliveries/'+encodeURIComponent(studentId)).then(function(data){
      if(!Array.isArray(data)||data.length===0){ el.innerHTML='<span style="opacity:.3">Sin entregas a\u00fan.</span>'; return }
      el.innerHTML = data.slice(0,10).map(function(d){
        var dateStr = d.created_at?new Date(d.created_at).toLocaleDateString('es-CO',{day:'2-digit',month:'short'}):d.date||''
        var gradeDisplay = d.grade ? '<span class="badge" style="background:rgba(52,199,89,.12);color:#34C759">'+parseFloat(d.grade).toFixed(1)+'</span>' : '<span class="badge" style="background:rgba(253,192,3,.12);color:#b38000">Entregado</span>'
        return '<div class="history-item"><div class="history-icon">📄</div><div style="flex:1"><div class="history-name">'+(d.title||d.subject||'Tarea')+'</div><div class="history-meta">'+(d.subject||'')+' &middot; '+dateStr+'</div></div>'+gradeDisplay+'</div>'
