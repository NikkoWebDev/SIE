---
import Layout from '@layouts/Layout.astro'
import WsRiskAlert from '@components/WsRiskAlert.astro'
import AIChat from '@components/AIChat.astro'
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000'
const wsUrl = apiUrl.replace(/^http/, 'ws')
---
<Layout titulo="Estudiante" sinMenu={true}>
  <WsRiskAlert />

  <style>
    :root{--sidebar-w:220px}
    .app-shell{display:flex;min-height:100vh}
    .est-sidebar{position:fixed;top:0;left:0;bottom:0;width:var(--sidebar-w);background:rgba(10,10,10,.96);backdrop-filter:blur(30px) saturate(160%);-webkit-backdrop-filter:blur(30px) saturate(160%);display:flex;flex-direction:column;z-index:200;transition:transform .3s cubic-bezier(.4,0,.2,1);border-right:1px solid rgba(255,255,255,.05)}
    .est-sidebar .logo-area{padding:1.75rem 1.5rem 1.375rem;border-bottom:1px solid rgba(255,255,255,.07);display:flex;align-items:center;gap:.625rem}
    .est-sidebar .logo-mark{width:34px;height:34px;background:var(--maroon);border-radius:9px;display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:800;font-size:15px;color:#fff;letter-spacing:-.5px;flex-shrink:0}
    .est-sidebar .logo-text{font-family:var(--font-display);font-weight:700;font-size:17px;color:#fff;letter-spacing:.5px}
    .est-sidebar .logo-text span{color:var(--gold)}
    .est-sidebar .nav-section{font-size:9.5px;text-transform:uppercase;letter-spacing:2px;color:rgba(255,255,255,.25);padding:1.25rem 1.5rem .5rem}
    .est-sidebar .est-nav-link{display:flex;align-items:center;gap:.6875rem;padding:.6875rem 1.5rem;color:rgba(255,255,255,.65);cursor:pointer;font-size:13.5px;font-weight:500;border-left:3px solid transparent;transition:color .2s,background .2s;margin:1px 0;text-decoration:none;background:none;border-right:none;border-top:none;border-bottom:none;width:100%;text-align:left;font-family:var(--font-body)}
    .est-sidebar .est-nav-link:hover{color:rgba(255,255,255,.88);background:rgba(255,255,255,.04)}
    .est-sidebar .est-nav-link.active{color:var(--gold);background:rgba(253,192,3,.08);border-left-color:var(--gold)}
    .est-sidebar .est-nav-link .nav-icon{width:18px;text-align:center;font-size:15px;opacity:.75;flex-shrink:0}
    .est-sidebar .est-nav-link.active .nav-icon{opacity:1}
    .est-sidebar .sidebar-footer{padding:.75rem 1rem;border-top:1px solid rgba(255,255,255,.07);margin-top:auto}
    .student-chip{display:flex;align-items:center;gap:.625rem;padding:.375rem .5rem;border-radius:.625rem;cursor:pointer;transition:background .2s}
    .student-chip:hover{background:rgba(255,255,255,.04)}
    .student-avatar{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--maroon),#b30000);display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:700;font-size:14px;color:#fff;flex-shrink:0}
    .student-name{font-size:12.5px;font-weight:600;color:rgba(255,255,255,.85)}
    .est-main{margin-left:var(--sidebar-w);flex:1;min-height:100vh}
    .est-topbar{position:sticky;top:0;z-index:100;height:62px;background:rgba(255,255,255,.75);backdrop-filter:blur(24px) saturate(140%);-webkit-backdrop-filter:blur(24px) saturate(140%);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 2rem;transition:background .35s}
    .est-topbar .topbar-left{display:flex;align-items:center;gap:.875rem}
    .est-topbar .topbar-title{font-family:var(--font-display);font-weight:700;font-size:19px}
    .est-topbar .topbar-right{display:flex;align-items:center;gap:1rem}
    .online-indicator{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-secondary)}
    .online-dot{width:8px;height:8px;border-radius:50%;display:inline-block}
    .online-dot.online{background:#34C759;box-shadow:0 0 0 0 rgba(52,199,89,.6);animation:pulse-dot 2s infinite}
    .online-dot.offline{background:#BA1A1A;box-shadow:none;animation:none}
    @keyframes pulse-dot{0%{box-shadow:0 0 0 0 rgba(52,199,89,.6)}70%{box-shadow:0 0 0 6px rgba(52,199,89,0)}100%{box-shadow:0 0 0 0 rgba(52,199,89,0)}}
    .topbar-clock{font-family:var(--font-display);font-weight:600;font-size:14px;color:var(--text);letter-spacing:.5px;background:var(--card-bg);border:1px solid var(--border);padding:6px 14px;border-radius:var(--radius-sm)}
    .theme-toggle-btn{width:36px;height:36px;border-radius:50%;background:var(--card-bg);border:1px solid var(--border);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:16px;transition:all .2s;color:var(--text)}
    .theme-toggle-btn:hover{transform:scale(1.08)}
    .hamburger-btn{display:none;background:none;border:none;cursor:pointer;color:var(--text);font-size:20px;padding:4px}
    .content-area{padding:2rem;max-width:1200px}
    .section{display:none}.section.active{display:block}
    .welcome-banner{background:linear-gradient(130deg,var(--maroon) 0%,#b30000 55%,#600000 100%);border-radius:var(--radius-lg);padding:1.875rem 2rem;margin-bottom:1.75rem;position:relative;overflow:hidden;color:#fff}
    .welcome-banner::after{content:'VYNTRA';position:absolute;right:-10px;top:50%;transform:translateY(-50%);font-family:var(--font-display);font-size:90px;font-weight:800;color:rgba(255,255,255,.06);letter-spacing:-4px;pointer-events:none}
    .welcome-banner h1{font-family:var(--font-display);font-size:clamp(1.2rem,2vw,1.6rem);font-weight:800;margin-bottom:4px}
    .welcome-banner p{font-size:14px;opacity:.75}
    .welcome-meta{display:flex;gap:12px;margin-top:12px;flex-wrap:wrap}
    .welcome-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.15);border-radius:20px;padding:5px 12px;font-size:12px;font-weight:500}
    .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:1.75rem}
    .stat-card{background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.375rem 1.25rem 1.125rem;position:relative;overflow:hidden;transition:transform .3s,box-shadow .3s}
    .stat-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-md)}
    .stat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--maroon);border-radius:3px 3px 0 0}
    .stat-card:nth-child(2)::before{background:var(--gold)}
    .stat-card:nth-child(3)::before{background:#34C759}
    .stat-card:nth-child(4)::before{background:#007AFF}
    .stat-icon{font-size:20px;margin-bottom:8px}
    .stat-value{font-family:var(--font-display);font-size:clamp(1.5rem,2.2vw,2.2rem);font-weight:800;color:var(--maroon);line-height:1;margin-bottom:4px}
    .stat-card:nth-child(2) .stat-value{color:var(--gold)}
    .stat-card:nth-child(3) .stat-value{color:#34C759}
    .stat-card:nth-child(4) .stat-value{color:#007AFF}
    .stat-label{font-size:11px;text-transform:uppercase;letter-spacing:1.2px;opacity:.55;font-weight:500}
    .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:1.5rem}
    .grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;margin-bottom:1.5rem}
    .section-title{font-family:var(--font-display);font-size:clamp(1.1rem,1.8vw,1.375rem);font-weight:700;margin-bottom:1.25rem;display:flex;align-items:center;gap:.625rem}
    .card-title{font-family:var(--font-display);font-size:15px;font-weight:700;margin-bottom:1rem;opacity:.9}
    .perf-item{margin-bottom:1rem}
    .perf-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
    .perf-name{font-size:13px;font-weight:500}
    .perf-score{font-family:var(--font-display);font-size:13px;font-weight:700;color:var(--maroon)}
    .perf-bar-bg{height:7px;background:var(--border);border-radius:10px;overflow:hidden}
    .perf-bar-fill{height:100%;border-radius:10px;background:linear-gradient(90deg,var(--maroon),#c00000);transition:width 1s cubic-bezier(.4,0,.2,1)}
    .perf-bar-fill.gold{background:linear-gradient(90deg,#b38000,var(--gold))}
    .perf-bar-fill.green{background:linear-gradient(90deg,#27a047,#34C759)}
    .timeline{position:relative;padding-left:1.5rem}
    .timeline::before{content:'';position:absolute;left:7px;top:0;bottom:0;width:2px;background:var(--border)}
    .timeline-item{position:relative;padding-bottom:1.25rem}
    .timeline-item:last-child{padding-bottom:0}
    .timeline-dot{position:absolute;left:-1.5rem;top:3px;width:14px;height:14px;border-radius:50%;background:var(--maroon);border:2px solid var(--bg);box-shadow:0 0 0 2px var(--maroon)}
    .timeline-dot.gold{background:var(--gold);box-shadow:0 0 0 2px var(--gold)}
    .timeline-dot.green{background:#34C759;box-shadow:0 0 0 2px #34C759}
    .timeline-date{font-size:11px;opacity:.5;margin-bottom:3px}
    .timeline-text{font-size:13px;font-weight:500}
    .timeline-sub{font-size:12px;opacity:.6;margin-top:2px}
    .cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;text-align:center}
    .cal-day-name{font-size:10px;opacity:.5;padding:4px 0;text-transform:uppercase;letter-spacing:.5px}
    .cal-day{font-size:12.5px;font-weight:500;padding:7px 4px;border-radius:8px;cursor:pointer;transition:background .15s;position:relative}
    .cal-day:hover{background:var(--border)}
    .cal-day.today{background:var(--maroon);color:#fff;font-weight:700}
    .cal-day.has-event::after{content:'';position:absolute;bottom:3px;left:50%;transform:translateX(-50%);width:4px;height:4px;border-radius:50%;background:var(--gold)}
    .cal-day.other-month{opacity:.3}
    .data-table{width:100%;border-collapse:collapse;font-size:13.5px}
    .data-table th{text-align:left;padding:10px 14px;font-size:10.5px;text-transform:uppercase;letter-spacing:1px;opacity:.5;font-weight:600;border-bottom:1px solid var(--border)}
    .data-table td{padding:13px 14px;border-bottom:1px solid var(--border);vertical-align:middle}
    .data-table tr:last-child td{border-bottom:none}
    .data-table tr:hover td{background:var(--input-bg)}
    .progress-cell{min-width:120px}
    .table-progress-bg{height:5px;background:var(--border);border-radius:4px;overflow:hidden;margin-top:4px}
    .table-progress-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--maroon),#c00000)}
    .badge{display:inline-flex;align-items:center;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;letter-spacing:.3px}
    .schedule-grid{overflow-x:auto}
    .schedule-table{width:100%;border-collapse:collapse;min-width:680px}
    .schedule-table th{padding:10px;text-align:center;font-size:11px;text-transform:uppercase;letter-spacing:1px;opacity:.5;border-bottom:1px solid var(--border)}
    .schedule-table td{padding:8px;text-align:center;font-size:12.5px;border:1px solid var(--border);min-height:52px;vertical-align:top}
    .sched-block{background:var(--maroon);color:#fff;border-radius:8px;padding:7px 8px;font-size:11.5px;font-weight:600;line-height:1.35;margin:2px}
    .sched-block.alt{background:rgba(128,0,0,.12);color:var(--maroon)}
    .sched-block.gold-bg{background:rgba(253,192,3,.15);color:#7a5c00}
    .time-col{font-size:11.5px;opacity:.5;font-weight:500;text-align:right;padding-right:14px}
    .tasks-split{display:grid;grid-template-columns:1fr 1fr;gap:20px}
    .dropzone{border:2px dashed var(--border);border-radius:var(--radius-md);padding:2.25rem 1.25rem;text-align:center;cursor:pointer;transition:border-color .2s,background .2s}
    .dropzone:hover,.dropzone.dragover{border-color:var(--maroon);background:rgba(128,0,0,.04)}
    .dropzone-icon{font-size:32px;margin-bottom:10px}
    .dropzone-text{font-size:13.5px;font-weight:500;opacity:.7}
    .dropzone-sub{font-size:12px;opacity:.45;margin-top:5px}
    .form-group{margin-bottom:1rem}
    .form-label{font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;opacity:.6;margin-bottom:6px;display:block}
    .form-input,.form-select{width:100%;padding:10px 14px;background:var(--input-bg);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text);font-family:var(--font-body);font-size:13.5px;transition:border-color .2s,box-shadow .2s;outline:none}
    .form-input:focus,.form-select:focus{border-color:var(--maroon);box-shadow:0 0 0 3px rgba(128,0,0,.1)}
    .history-item{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--border)}
    .history-item:last-child{border-bottom:none}
    .history-icon{width:38px;height:38px;border-radius:10px;background:rgba(128,0,0,.09);display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0}
    .history-name{font-size:13px;font-weight:600}
    .history-meta{font-size:11px;opacity:.5;margin-top:2px}
    .library-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px}
    .lib-card{background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius-md);padding:1.25rem;transition:transform .3s,box-shadow .3s;position:relative;overflow:hidden}
    .lib-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-md)}
    .lib-card::before{content:'';position:absolute;top:0;left:0;width:4px;height:100%;background:var(--maroon);border-radius:4px 0 0 4px}
    .lib-card:nth-child(2)::before{background:var(--gold)}\n    .lib-card:nth-child(3)::before{background:#007AFF}
    .lib-card:nth-child(4)::before{background:#34C759}
    .lib-card:nth-child(5)::before{background:#AF52DE}
    .lib-card:nth-child(6)::before{background:#FF9500}
    .lib-icon{font-size:26px;margin-bottom:10px}
    .lib-name{font-family:var(--font-display);font-weight:700;font-size:14px;margin-bottom:5px}
    .lib-desc{font-size:12px;opacity:.6;margin-bottom:12px;line-height:1.5}
    .lib-links{display:flex;gap:8px;flex-wrap:wrap}
    .lib-link{font-size:11.5px;font-weight:600;padding:5px 11px;border-radius:20px;cursor:pointer;text-decoration:none;transition:all .18s;display:inline-flex;align-items:center;gap:4px}
    .lib-link.primary{background:var(--maroon);color:#fff}
    .lib-link.primary:hover{background:#6a0000}
    .lib-link.ai{background:rgba(253,192,3,.15);color:#b38000;border:1px solid rgba(253,192,3,.3)}
    .profile-header{display:flex;align-items:flex-start;gap:24px;margin-bottom:1.75rem}
    .profile-avatar-lg{width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,var(--maroon),#b30000);display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:800;font-size:30px;color:#fff;flex-shrink:0;position:relative}
    .profile-avatar-lg::after{content:'';position:absolute;bottom:2px;right:2px;width:16px;height:16px;border-radius:50%;background:#34C759;border:2px solid var(--bg)}
    .profile-name{font-family:var(--font-display);font-size:clamp(1.2rem,2vw,1.5rem);font-weight:800;margin-bottom:4px}
    .profile-id{font-size:13px;opacity:.5}
    .profile-info-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    .info-item{padding:14px;background:var(--input-bg);border-radius:var(--radius-sm)}
    .info-key{font-size:10.5px;text-transform:uppercase;letter-spacing:1px;opacity:.5;margin-bottom:4px}
    .info-val{font-size:14px;font-weight:600}
    .btn-apple{border-radius:12px;padding:10px 20px;font-family:var(--font-body);font-weight:600;border:none;cursor:pointer;font-size:13.5px;transition:all .2s;display:inline-flex;align-items:center;gap:6px}
    .btn-primary{background:var(--maroon);color:#fff}
    .btn-primary:hover{background:#6a0000;transform:translateY(-1px);box-shadow:0 4px 14px rgba(128,0,0,.35)}
    .btn-secondary{background:var(--input-bg);color:var(--text);border:1px solid var(--border)}
    .btn-secondary:hover{background:var(--border)}
    .btn-ghost{background:transparent;color:var(--maroon);border:1px solid rgba(128,0,0,.25)}
    .btn-ghost:hover{background:rgba(128,0,0,.06)}
    .filter-row{display:flex;gap:10px;align-items:center;margin-bottom:18px;flex-wrap:wrap}
    .period-filter{padding:6px 14px;border-radius:20px;font-size:12.5px;font-weight:500;background:var(--input-bg);border:1px solid var(--border);cursor:pointer;transition:all .18s;color:var(--text)}
    .period-filter.active{background:var(--maroon);color:#fff;border-color:var(--maroon)}
    .chart-mock-wrap{padding:10px 0 28px}
    .chart-bars{display:flex;align-items:flex-end;gap:10px;height:160px}
    .c-bar{flex:1;border-radius:8px 8px 0 0;position:relative;transition:height .9s cubic-bezier(.4,0,.2,1)}
    .c-bar::after{content:attr(data-val);position:absolute;top:-22px;left:50%;transform:translateX(-50%);font-family:var(--font-display);font-size:12px;font-weight:700;opacity:.8}
    .c-bar-label{position:absolute;bottom:-22px;left:50%;transform:translateX(-50%);font-size:10px;opacity:.5;white-space:nowrap}
    .exam-modal{position:fixed;inset:0;z-index:9999;background:#040405;display:none;flex-direction:column}
    .exam-modal.open{display:flex}
    .exam-modal-header{display:flex;align-items:center;justify-content:space-between;padding:1rem 1.5rem;background:rgba(255,255,255,.03);border-bottom:1px solid rgba(255,255,255,.06)}
    .exam-modal-body{flex:1;overflow-y:auto;padding:1.5rem;display:grid;grid-template-columns:1fr;gap:1rem}
    .exam-question-card{background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.06);border-radius:1rem;padding:1.25rem}
    .exam-option{display:flex;align-items:center;gap:.625rem;padding:.625rem .75rem;border-radius:.5rem;border:1px solid rgba(255,255,255,.08);cursor:pointer;transition:all .15s;margin-bottom:.375rem;font-size:.8125rem}
    .exam-option:hover{border-color:rgba(253,192,3,.3);background:rgba(253,192,3,.04)}
    .exam-option:has(input:checked){border-color:#FDC003;background:rgba(253,192,3,.06)}
    .strike-badge{display:inline-flex;align-items:center;gap:.375rem;padding:.25rem .75rem;border-radius:999px;font-size:.6875rem;font-weight:600;background:rgba(186,26,26,.12);color:#ff4d4d}
    .timer-display{font-family:var(--font-display);font-weight:700;font-size:1.5rem;font-variant-numeric:tabular-nums}
    .timer-display.warning{color:#ff4d4d;animation:pulse 1s infinite}
    @keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
    .candidate-card{background:var(--card-bg);border:1px solid var(--border);border-radius:1.25rem;padding:1.25rem;text-align:center;transition:all .2s}
    .candidate-card:hover{border-color:rgba(128,0,0,.3)}
    .candidate-card img{width:72px;height:72px;border-radius:50%;object-fit:cover;margin:0 auto .75rem}
    .saber-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px}
    .saber-card{background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius-md);padding:1.25rem;transition:transform .3s,box-shadow .3s;position:relative;overflow:hidden}
    .saber-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-md)}
    .saber-card .saber-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem}
    .saber-card .saber-icon{width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px}
    .saber-card .saber-title{font-family:var(--font-display);font-weight:700;font-size:14px;margin-bottom:4px}
    .saber-card .saber-desc{font-size:12px;opacity:.6;margin-bottom:12px;line-height:1.5}
    .saber-tabs{display:flex;gap:4px;margin-bottom:1rem;flex-wrap:wrap}
    .saber-tab{padding:6px 16px;border-radius:20px;font-size:12.5px;font-weight:500;background:var(--input-bg);border:1px solid var(--border);cursor:pointer;transition:all .18s;color:var(--text)}
    .saber-tab.active{background:var(--maroon);color:#fff;border-color:var(--maroon)}
    .saber-tab.gold-tab.active{background:var(--gold);border-color:var(--gold);color:#000}
    .saber-material{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border)}
    .saber-material:last-child{border-bottom:none}
    .saber-material .mat-icon{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0}
    .saber-material .mat-info{flex:1}
    .saber-material .mat-name{font-size:13px;font-weight:600}
    .saber-material .mat-meta{font-size:11px;opacity:.5}
    .lightbox-overlay{position:fixed;inset:0;z-index:99998;background:rgba(0,0,0,.92);display:none;align-items:center;justify-content:center;cursor:zoom-out}
    .lightbox-overlay.open{display:flex}
    .lightbox-overlay img{max-width:90vw;max-height:90vh;border-radius:.75rem;object-fit:contain}
    .exam-card{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06);border-radius:1rem;padding:1rem;cursor:pointer;transition:all .2s}
    .exam-card:hover{border-color:rgba(253,192,3,.3);background:rgba(253,192,3,.03)}
    .sidebar-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:150;backdrop-filter:blur(4px)}
    @media(max-width:1024px){
