---
import Layout from '@layouts/Layout.astro'
import WsRiskAlert from '@components/WsRiskAlert.astro'
import AIChat from '@components/AIChat.astro'
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000'
const wsUrl = apiUrl.replace(/^http/, 'ws')
---
<Layout titulo="Estudiante">
  <WsRiskAlert />

  <style>
    .est-sidebar{position:fixed;top:0;left:0;bottom:0;width:220px;background:rgba(0,0,0,0.4);backdrop-filter:blur(20px);border-right:1px solid rgba(255,255,255,0.04);z-index:50;padding:1.25rem 0;display:flex;flex-direction:column;gap:0.25rem}
    .est-sidebar .logo-area{padding:0 1rem 1rem;border-bottom:1px solid rgba(255,255,255,0.04);margin-bottom:0.75rem}
    .est-sidebar .logo-area h2{font-family:var(--font-display);font-size:1.1rem;color:#fff;font-weight:700}
    .est-sidebar .logo-area p{font-size:0.6rem;color:rgba(255,255,255,0.35);letter-spacing:0.05em;text-transform:uppercase}
    .est-nav-link{display:flex;align-items:center;gap:0.625rem;padding:0.5rem 1rem;margin:0 0.5rem;border-radius:0.625rem;font-size:0.75rem;color:rgba(255,255,255,0.5);font-weight:500;transition:all 0.15s ease;text-decoration:none;cursor:pointer}
    .est-nav-link:hover{color:rgba(255,255,255,0.8);background:rgba(128,0,0,0.12)}
    .est-nav-link.active{color:#FDC003;background:rgba(253,192,3,0.08)}
    .est-main{margin-left:220px;padding:1.5rem 2rem;min-height:100vh;max-width:1200px}
    .est-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem}
    .est-header h1{font-family:var(--font-display);font-weight:700;font-size:clamp(1.2rem,2vw,1.6rem);color:var(--text)}
    .est-header .header-right{display:flex;align-items:center;gap:1rem}
    .online-dot{width:8px;height:8px;border-radius:50%;display:inline-block}
    .online-dot.online{background:#34D399;box-shadow:0 0 6px rgba(52,211,153,0.5)}
    .online-dot.offline{background:#BA1A1A}
    .live-clock{font-size:0.7rem;color:rgba(255,255,255,0.4);font-weight:500;font-variant-numeric:tabular-nums}
    .section-content{display:none}
    .section-content.active{display:block}
    .exam-card{background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:1rem;padding:1rem;cursor:pointer;transition:all 0.2s}
    .exam-card:hover{border-color:rgba(253,192,3,0.3);background:rgba(253,192,3,0.03)}
    .candidate-card{background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:1.25rem;padding:1.25rem;text-align:center;transition:all 0.2s}
    .candidate-card:hover{border-color:rgba(128,0,0,0.3)}
    .candidate-card img{width:72px;height:72px;border-radius:50%;object-fit:cover;margin:0 auto 0.75rem}
    .exam-modal{position:fixed;inset:0;z-index:9999;background:#040405;display:none;flex-direction:column}
    .exam-modal.open{display:flex}
    .exam-modal-header{display:flex;align-items:center;justify-content:space-between;padding:1rem 1.5rem;background:rgba(255,255,255,0.03);border-bottom:1px solid rgba(255,255,255,0.06)}
    .exam-modal-body{flex:1;overflow-y:auto;padding:1.5rem;display:grid;grid-template-columns:1fr;gap:1rem}
    .exam-question-card{background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);border-radius:1rem;padding:1.25rem}
    .exam-option{display:flex;align-items:center;gap:0.625rem;padding:0.625rem 0.75rem;border-radius:0.5rem;border:1px solid rgba(255,255,255,0.08);cursor:pointer;transition:all 0.15s;margin-bottom:0.375rem;font-size:0.8125rem}
    .exam-option:hover{border-color:rgba(253,192,3,0.3);background:rgba(253,192,3,0.04)}
    .exam-option input:checked + .opt-label{color:#FDC003}
    .exam-option:has(input:checked){border-color:#FDC003;background:rgba(253,192,3,0.06)}
    .lightbox-overlay{position:fixed;inset:0;z-index:99998;background:rgba(0,0,0,0.92);display:none;align-items:center;justify-content:center;cursor:zoom-out}
    .lightbox-overlay.open{display:flex}
    .lightbox-overlay img{max-width:90vw;max-height:90vh;border-radius:0.75rem;object-fit:contain}
    .strike-badge{display:inline-flex;align-items:center;gap:0.375rem;padding:0.25rem 0.75rem;border-radius:999px;font-size:0.6875rem;font-weight:600;background:rgba(186,26,26,0.12);color:#ff4d4d}
    .timer-display{font-family:var(--font-display);font-weight:700;font-size:1.5rem;font-variant-numeric:tabular-nums}
    .timer-display.warning{color:#ff4d4d;animation:pulse 1s infinite}
    @keyframes pulse{0%,100%{opacity:1}50%{opacity:0.5}}
    @media(max-width:768px){
      .est-sidebar{transform:translateX(-100%);transition:transform .35s var(--ease-out);z-index:60}
      .est-sidebar.open{transform:translateX(0)}
      .est-main{margin-left:0;padding:1rem}
      .est-header{flex-wrap:wrap;gap:.5rem}
    }
    @media(min-width:769px){.est-sidebar{transform:translateX(0)!important}}
    @media(max-width:480px){.est-main{padding:.75rem!important}}
    .est-sidebar-overlay{display:none;position:fixed;inset:0;z-index:55;background:rgba(0,0,0,.6)}
    .est-sidebar.open~.est-sidebar-overlay{display:block}
    @media(max-width:480px){
      .exam-modal-header{padding:.75rem 1rem;flex-wrap:wrap;gap:.5rem}
      .exam-modal-body{padding:1rem}
      .est-header .header-right{gap:.5rem}
      #online-text{display:none}
      .candidate-card{padding:1rem}
    }
    @media(max-width:380px){
      .est-header .live-clock{display:none}
    }
  </style>

  <!-- Sidebar -->
  <nav class="est-sidebar">
    <div class="logo-area">
      <div style="display:flex;align-items:center;justify-content:space-between">
        <div><h2>Vyntra</h2><p>Panel Estudiante</p></div>
        <button class="show-mobile" onclick="document.querySelector('.est-sidebar').classList.remove('open')" style="color:rgba(255,255,255,.5);font-size:1.2rem;background:none;border:none;cursor:pointer">✕</button>
      </div>
    </div>
    <button class="est-nav-link active" data-nav="inicio" tabindex="0"><svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg> Inicio</button>
    <button class="est-nav-link" data-nav="examenes" tabindex="0"><svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg> Exámenes</button>
    <button class="est-nav-link" data-nav="votaciones" tabindex="0"><svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Votaciones</button>
    <button class="est-nav-link" data-nav="aula" tabindex="0"><svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg> Aula Virtual</button>
    <button class="est-nav-link" data-nav="tareas" tabindex="0"><svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg> Tareas</button>
    <button class="est-nav-link" data-nav="boletin" tabindex="0"><svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg> Boletín</button>
  </nav>
  <div class="est-sidebar-overlay" onclick="document.querySelector('.est-sidebar').classList.remove('open')"></div>

  <!-- Lightbox -->
  <div class="lightbox-overlay" id="lightbox" onclick="closeLightbox()"><img id="lightbox-img" src="" alt=""></div>

  <!-- Exam Modal -->
  <div class="exam-modal" id="exam-modal">
    <div class="exam-modal-header">
      <div><strong id="exam-modal-title" style="font-size:0.875rem;color:#fff">Examen</strong><div class="strike-badge" id="strike-badge" style="display:none">⚠️ <span id="strike-val">0</span>/5</div></div>
      <div style="display:flex;align-items:center;gap:1rem">
        <span class="timer-display" id="timer-display">00:00</span>
        <button class="btn btn-ghost" onclick="intentarSalirManual()" style="font-size:0.75rem;color:rgba(255,255,255,0.5)">✕ Salir</button>
      </div>
    </div>
    <div class="exam-modal-body" id="examen-preguntas-render"></div>
  </div>

  <!-- Main Content -->
  <div class="est-main">
    <div class="est-header">
      <div style="display:flex;align-items:center;gap:.75rem">
        <button class="show-mobile" onclick="document.querySelector('.est-sidebar').classList.toggle('open')" style="padding:.35rem;border-radius:var(--radius-sm);color:rgba(255,255,255,.5);background:none;border:none;cursor:pointer">
          <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <div>
          <h1><span id="student-name">Cargando...</span></h1>
        <p style="font-size:0.7rem;color:rgba(255,255,255,0.4);margin-top:0.15rem" id="student-meta">Panel de rendimiento académico</p>
      </div>
      <div class="header-right">
        <span id="online-indicator" style="display:flex;align-items:center;gap:0.375rem;font-size:0.7rem;color:rgba(255,255,255,0.4)"><span class="online-dot online" id="online-dot"></span> <span id="online-text">En línea</span></span>
        <span class="live-clock" id="live-clock"></span>
      </div>
    </div>

    <!-- Inicio -->
    <div class="section-content active" id="sec-inicio">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.5rem">
        <div class="card-float" style="padding:1.25rem">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
            <h2 style="font-size:0.85rem;font-weight:600;color:var(--text)">Rendimiento</h2>
            <span style="font-family:var(--font-display);font-weight:700;font-size:1.5rem;color:var(--maroon)" id="avg-score-display">--</span>
          </div>
          <div id="metrics-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.5rem"></div>
        </div>
        <div class="card-float" style="padding:1.25rem">
          <h2 style="font-size:0.85rem;font-weight:600;color:var(--text);margin-bottom:0.75rem">📢 Avisos</h2>
          <div id="notices-list" style="font-size:0.75rem;color:rgba(255,255,255,0.5)">Cargando...</div>
        </div>
      </div>
      <div class="card-float" style="padding:1.25rem">
        <h2 style="font-size:0.85rem;font-weight:600;color:var(--text);margin-bottom:0.75rem">Notas por Materia</h2>
        <div id="grades-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:0.75rem"></div>
      </div>
    </div>

    <!-- Exámenes -->
    <div class="section-content" id="sec-examenes">
      <div class="card-float" style="padding:1.25rem;margin-bottom:1rem">
        <h2 style="font-size:0.85rem;font-weight:600;color:var(--text);margin-bottom:0.75rem">📝 Exámenes Disponibles</h2>
        <div id="available-exams" style="font-size:0.75rem;color:rgba(255,255,255,0.5)">Cargando...</div>
      </div>
    </div>

    <!-- Votaciones -->
    <div class="section-content" id="sec-votaciones">
      <div class="card-float" style="padding:1.25rem;margin-bottom:1rem">
        <h2 style="font-size:0.85rem;font-weight:600;color:var(--text);margin-bottom:0.75rem">🗳️ Elecciones — Votación Estudiantil</h2>
        <div id="candidates-list" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem"></div>
      </div>
    </div>

    <!-- Aula Virtual -->
    <div class="section-content" id="sec-aula">
      <div class="card-float" style="padding:1.25rem;margin-bottom:1rem">
        <h2 style="font-size:0.85rem;font-weight:600;color:var(--text);margin-bottom:0.75rem">📚 Aula Virtual</h2>
        <select id="subject-selector" class="input-field" style="margin-bottom:1rem;width:100%;max-width:400px"><option value="">Seleccionar materia...</option></select>
        <div id="subject-resources" style="font-size:0.75rem;color:rgba(255,255,255,0.5)">Selecciona una materia para ver sus recursos.</div>
      </div>
    </div>

    <!-- Tareas -->
    <div class="section-content" id="sec-tareas">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
        <div class="card-float" style="padding:1.25rem">
          <h2 style="font-size:0.85rem;font-weight:600;color:var(--text);margin-bottom:0.75rem">📤 Subir Tarea</h2>
          <select id="hw-subject" class="input-field" style="margin-bottom:0.75rem;width:100%"><option value="">Materia...</option></select>
          <div style="border:2px dashed rgba(255,255,255,0.08);border-radius:1rem;padding:1.5rem;text-align:center;position:relative;margin-bottom:0.75rem">
            <input type="file" id="hw-file" accept=".pdf,.doc,.docx,.zip,.png,.jpg" style="position:absolute;width:100%;height:100%;top:0;left:0;opacity:0;cursor:pointer" onchange="updateFileName(this)">
            <span style="font-size:0.75rem;color:rgba(255,255,255,0.4)">📎 Arrastra o selecciona archivo</span>
            <div id="file-name-display" style="font-size:0.7rem;color:var(--maroon);margin-top:0.375rem"></div>
          </div>
          <button class="btn btn-crimson" onclick="sendHomework()" style="width:100%;justify-content:center">Subir Tarea</button>
        </div>
        <div class="card-float" style="padding:1.25rem">
          <h2 style="font-size:0.85rem;font-weight:600;color:var(--text);margin-bottom:0.75rem">📋 Historial de Entregas</h2>
          <div id="homework-history" style="font-size:0.75rem;color:rgba(255,255,255,0.5)">Cargando...</div>
        </div>
      </div>
    </div>

    <!-- Boletín -->
    <div class="section-content" id="sec-boletin">
      <div class="card-float" style="padding:1.25rem;margin-bottom:1rem">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem">
          <h2 style="font-size:0.85rem;font-weight:600;color:var(--text)">📊 Rendimiento por Materia</h2>
          <button class="btn btn-crimson" onclick="generarBoletinPDF()" style="font-size:0.75rem">📄 Descargar Boletín PDF</button>
        </div>
        <div style="height:300px"><canvas id="myGradesChart"></canvas></div>
      </div>
    </div>
  </div>

  <AIChat />
</Layout>

<script define:vars={{ apiUrl, wsUrl }}>
  (function () {
    try {
    // ── Toast system ──
    var toastEl = document.createElement('div')
    toastEl.style.cssText = 'position:fixed;bottom:1.5rem;right:1.5rem;z-index:99999;padding:.75rem 1.25rem;border-radius:var(--radius-lg);font-size:.8rem;font-weight:500;opacity:0;transform:translateY(1rem);transition:all .3s var(--ease-out);pointer-events:auto;max-width:360px;background:var(--card-bg);border:1px solid var(--border);color:var(--text);box-shadow:var(--shadow-lg)'
    document.body.appendChild(toastEl)
    function showToast(msg, type) {
      if (type === 'error') { toastEl.style.borderColor = 'rgba(186,26,26,0.3)'; toastEl.style.color = 'var(--red)' }
      else if (type === 'success') { toastEl.style.borderColor = 'rgba(52,211,153,0.3)'; toastEl.style.color = 'var(--green)' }
      else { toastEl.style.borderColor = 'var(--border)'; toastEl.style.color = 'var(--text)' }
      toastEl.textContent = msg
      toastEl.style.opacity = '1'; toastEl.style.transform = 'translateY(0)'
      setTimeout(function(){ toastEl.style.opacity='0'; toastEl.style.transform='translateY(1rem)' }, 4000)
    }

    var token = localStorage.getItem('access_token')
    if (!token) { window.location.href = '/login'; return }
    var studentId = localStorage.getItem('profile_id') || localStorage.getItem('userId')
    var currentSection = 'inicio'
    var subjectsCache = null

    // ── Helpers ──
    function apiFetch(path, opts) {
      var url = apiUrl.replace(/\/+$/, '') + '/' + path.replace(/^\/+/, '')
      var merged = Object.assign({ headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' } }, opts || {})
      if (merged.body && typeof merged.body === 'object' && !(merged.body instanceof FormData)) merged.body = JSON.stringify(merged.body)
      return fetch(url, merged).then(function (r) { if (r.status === 401) { localStorage.clear(); window.location.href = '/login' }; return r.json() })
    }

    // ── Navigation ──
    document.querySelectorAll('.est-nav-link').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault()
        var nav = a.getAttribute('data-nav')
        if (!nav) return
        currentSection = nav
        document.querySelectorAll('.est-nav-link').forEach(function (l) { l.classList.remove('active') })
        a.classList.add('active')
        document.querySelectorAll('.section-content').forEach(function (s) { s.classList.remove('active') })
        var sec = document.getElementById('sec-' + nav)
        if (sec) sec.classList.add('active')
        if (nav === 'examenes') loadExams()
        if (nav === 'votaciones') loadCandidates()
        if (nav === 'aula') { loadSubjects(); loadSubjectResources() }
        if (nav === 'tareas') { loadSubjects(); loadHomeworkHistory() }
        if (nav === 'boletin') loadChartData()
        if (window.innerWidth < 769) document.querySelector('.est-sidebar').classList.remove('open')
      })
    })

    // ── Live Clock + Online Indicator ──
    function updateClock() { var el = document.getElementById('live-clock'); if (el) el.textContent = new Date().toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) }
    setInterval(updateClock, 1000); updateClock()

    function updateOnlineStatus() {
      var dot = document.getElementById('online-dot'); var txt = document.getElementById('online-text')
      if (!dot || !txt) return
      if (navigator.onLine) { dot.className = 'online-dot online'; txt.textContent = 'En línea' }
      else {
        dot.className = 'online-dot offline'; txt.textContent = 'Sin conexión'
        // Save exam progress on disconnect (exam resilience)
        if (isExamActive && currentExam) {
          saveExamProgress()
          apiFetch('/api/exam/handle-disconnect', {
            method: 'POST',
            body: { student_id: studentId, exam_id: currentExam.id, incident_type: 'network_loss', severity: 'low', strikes: strikes }
          }).catch(function () {})
        }
      }
    }
    window.addEventListener('online', updateOnlineStatus); window.addEventListener('offline', updateOnlineStatus); updateOnlineStatus()

    // ── Notices ──
    function loadNotices() {
      apiFetch('/api/notices').then(function (data) {
        var el = document.getElementById('notices-list')
        if (!Array.isArray(data) || data.length === 0) { el.innerHTML = '<span style="color:rgba(255,255,255,0.3)">Sin avisos recientes.</span>'; return }
        el.innerHTML = data.slice(0, 3).map(function (n) {
          var hasFile = n.archivo_url && n.archivo_url !== ''
          return '<div style="padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.04)"><strong style="display:block;font-size:0.75rem;color:rgba(255,255,255,0.8)">' + (n.titulo || '') + '</strong><span style="font-size:0.65rem;color:rgba(255,255,255,0.35)">' + (n.fecha || '') + '</span>' +
            (hasFile ? (n.archivo_url.match(/\.pdf$/i) ? '<a href="' + n.archivo_url + '" target="_blank" style="display:inline-block;font-size:0.65rem;color:var(--maroon);margin-top:0.25rem">📄 Ver PDF</a>' : '<br><img src="' + n.archivo_url + '" class="notice-image" onclick="openLightbox(\'' + n.archivo_url + '\')" style="max-width:100%;max-height:120px;border-radius:0.5rem;margin-top:0.375rem;cursor:zoom-in;object-fit:cover">') : '') + '</div>'
        }).join('')
      }).catch(function () { showToast('Error al cargar estadísticas', 'error') })
    }

    // ── Exams ──
    var currentExam = null; var strikes = 0; var isExamActive = false; var isInitializingExam = false; var timerInterval = null; var tiempoRestante = 0; var autoSaveInterval = null

    function loadExams() {
      var el = document.getElementById('available-exams')
      apiFetch('/api/student/exams').then(function (data) {
        if (!Array.isArray(data) || data.length === 0) { el.innerHTML = '<span style="color:rgba(255,255,255,0.3)">No hay exámenes disponibles.</span>'; return }
        el.innerHTML = '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:0.75rem">' + data.map(function (e) {
          return '<div class="exam-card" onclick="abrirExamen(\'' + e.id + '\')"><strong style="font-size:0.8125rem;color:#fff">' + (e.title || 'Examen') + '</strong><div style="display:flex;gap:0.75rem;margin-top:0.5rem;font-size:0.65rem;color:rgba(255,255,255,0.35)"><span>' + (e.duration_minutes || '?') + ' min</span><span>' + (e.questions ? e.questions.length : 0) + ' preg</span></div></div>'
        }).join('') + '</div>'
      }).catch(function () { showToast('Error al cargar exámenes', 'error'); el.innerHTML = '<span style="color:var(--red);font-size:0.75rem">Error al cargar exámenes</span>' })
    }

    window.abrirExamen = function (examId) {
      if (!studentId) return
      apiFetch('/api/student/exam/' + examId).then(function (exam) {
        if (!exam || !exam.questions) { alert('Examen no encontrado'); return }
        currentExam = exam; isInitializingExam = true; strikes = 0
        document.getElementById('exam-modal-title').textContent = exam.title || 'Examen'
        document.getElementById('strike-badge').style.display = 'none'

        // Check for existing progress (exam resilience)
        apiFetch('/api/exam/progress/' + studentId + '/' + examId).then(function (progress) {
          if (progress && progress.answers && Object.keys(progress.answers).length > 0) {
            restoreExamProgress(progress)
          }
        }).catch(function () {})

        var html = ''
        exam.questions.forEach(function (q, qi) {
          html += '<div class="exam-question-card"><div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem"><span style="width:24px;height:24px;border-radius:50%;background:rgba(253,192,3,0.15);color:#FDC003;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.75rem">' + (qi + 1) + '</span><strong style="font-size:0.8125rem;color:rgba(255,255,255,0.9)">' + (q.question_text || '') + '</strong></div>'
          var opts = q.options || ['A', 'B', 'C', 'D']
          opts.forEach(function (o, oi) {
            var optText = typeof o === 'string' ? o : (o.text || o.value || 'Opción ' + String.fromCharCode(65 + oi))
            html += '<label class="exam-option"><input type="radio" name="p' + qi + '" value="' + oi + '" style="display:none"><span class="opt-label" style="flex:1">' + optText + '</span></label>'
          })
          html += '</div>'
        })
        document.getElementById('examen-preguntas-render').innerHTML = html
        document.getElementById('exam-modal').classList.add('open')
        document.body.style.overflow = 'hidden'
        activarPantallaCompleta()
        iniciarCronometro(exam.duration_minutes || 60)
        setTimeout(function () { isInitializingExam = false; isExamActive = true }, 2500)

        // Auto-save every 30 seconds (exam resilience)
        if (autoSaveInterval) clearInterval(autoSaveInterval)
        autoSaveInterval = setInterval(function () {
          if (!isExamActive || !currentExam) return
          saveExamProgress()
        }, 30000)

        setupSecurityListeners()
      }).catch(function () { showToast('Error al abrir el examen', 'error') })
    }

    function restoreExamProgress(progress) {
      if (!progress.answers || !currentExam) return
      currentExam.questions.forEach(function (q, qi) {
        var savedAnswer = progress.answers[String(qi)]
        if (savedAnswer !== undefined && savedAnswer !== null && savedAnswer >= 0) {
          var radio = document.querySelector('input[name="p' + qi + '"][value="' + savedAnswer + '"]')
          if (radio) radio.checked = true
        }
      })
      if (progress.time_elapsed_seconds && progress.time_elapsed_seconds > 0) {
        tiempoRestante = Math.max(10, (currentExam.duration_minutes || 60) * 60 - progress.time_elapsed_seconds)
      }
      showToast('Progreso restaurado', 'info')
    }

    function saveExamProgress() {
      if (!currentExam || !currentExam.questions) return
      var answers = {}
      var initialDuration = (currentExam.duration_minutes || 60) * 60
      currentExam.questions.forEach(function (q, qi) {
        var selected = document.querySelector('input[name="p' + qi + '"]:checked')
        if (selected) answers[String(qi)] = parseInt(selected.value)
      })
      apiFetch('/api/exam/save-progress', {
        method: 'POST',
        body: {
          student_id: studentId,
          exam_id: currentExam.id,
          answers: answers,
          current_question_index: 0,
          time_elapsed_seconds: initialDuration - tiempoRestante,
        }
      }).catch(function () {})
    }

    function iniciarCronometro(minutos) {
      tiempoRestante = Math.max(minutos * 60, 10)
      if (timerInterval) clearInterval(timerInterval)
      timerInterval = setInterval(function () {
        tiempoRestante--
        var m = Math.floor(tiempoRestante / 60); var s = tiempoRestante % 60
        var display = document.getElementById('timer-display')
        display.textContent = String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0')
        display.className = 'timer-display' + (tiempoRestante <= 60 ? ' warning' : '')
        if (tiempoRestante <= 0) { clearInterval(timerInterval); finalizarExamen(true, 'TIEMPO AGOTADO') }
      }, 1000)
    }

    var examSubmitting = false
    window.finalizarExamen = function (auto, motivo) {
      if (examSubmitting) return
      if (!auto && !confirm('¿Enviar respuestas ahora?')) return
      examSubmitting = true
      if (timerInterval) clearInterval(timerInterval)
      isExamActive = false; isInitializingExam = true
      if (!currentExam || !currentExam.questions) { cerrarModalExamen(); examSubmitting = false; return }
      var answers = []
      currentExam.questions.forEach(function (q, qi) {
        var selected = document.querySelector('input[name="p' + qi + '"]:checked')
        answers.push(selected ? parseInt(selected.value) : -1)
      })
      apiFetch('/api/student/submit-exam', { method: 'POST', body: { exam_id: currentExam.id, student_id: studentId, answers: answers } }).then(function (res) {
        alert(motivo ? 'Examen finalizado: ' + motivo : 'Examen enviado. Calificación: ' + (res.grade || '—'))
        cerrarModalExamen(); loadExams(); loadGrades(); examSubmitting = false
      }).catch(function (e) { showToast('Error al enviar: ' + (e.message || 'desconocido'), 'error'); cerrarModalExamen(); examSubmitting = false })
    }

    window.intentarSalirManual = function () {
      if (confirm('¿Salir del examen? Las respuestas se enviarán automáticamente.')) finalizarExamen(true, 'SALIDA VOLUNTARIA')
    }

    function activarPantallaCompleta() {
      var el = document.documentElement
      if (el.requestFullscreen) el.requestFullscreen()
      else if (el.webkitRequestFullscreen) el.webkitRequestFullscreen()
      else if (el.msRequestFullscreen) el.msRequestFullscreen()
    }

    function setupSecurityListeners() {
      document.removeEventListener('visibilitychange', onVisibilityChange)
      document.removeEventListener('fullscreenchange', onFullscreenChange)
      document.addEventListener('visibilitychange', onVisibilityChange)
      document.addEventListener('fullscreenchange', onFullscreenChange)
    }

    function onVisibilityChange() {
      if (!isExamActive || isInitializingExam) return
      if (document.hidden) sumarStrikes(1, 'Cambio de pestaña')
    }

    function onFullscreenChange() {
      if (!isExamActive || isInitializingExam || !currentExam) return
      if (!document.fullscreenElement) sumarStrikes(1, 'Salió de pantalla completa')
    }

    window.cerrarModalExamen = function () {
      document.removeEventListener('visibilitychange', onVisibilityChange)
      document.removeEventListener('fullscreenchange', onFullscreenChange)
      if (timerInterval) clearInterval(timerInterval)
      if (autoSaveInterval) { clearInterval(autoSaveInterval); autoSaveInterval = null }
      isExamActive = false; currentExam = null
      if (document.fullscreenElement) document.exitFullscreen()
      document.getElementById('exam-modal').classList.remove('open')
      document.body.style.overflow = ''
    }

    function sumarStrikes(cant, motivo) {
      if (!currentExam) return
      strikes += cant
      document.getElementById('strike-badge').style.display = 'inline-flex'
      document.getElementById('strike-val').textContent = strikes
      apiFetch('/api/exams/report-incident', { method: 'POST', body: { student_id: studentId, exam_id: currentExam.id || currentExam._id, incident_type: motivo, severity: strikes >= 3 ? 'high' : 'low', strikes: strikes } }).catch(function () {})
      if (strikes >= 5) { alert('⛔ Has superado el límite de infracciones de seguridad.'); finalizarExamen(true, 'Múltiples infracciones de seguridad') }
    }

    // ── Voting ──
    function loadCandidates() {
      var el = document.getElementById('candidates-list')
      apiFetch('/api/admin/candidates').then(function (data) {
        if (!Array.isArray(data) || data.length === 0) { el.innerHTML = '<span style="color:rgba(255,255,255,0.3);grid-column:1/-1;text-align:center">No hay candidatos registrados.</span>'; return }
        el.innerHTML = data.map(function (c) {
          var defaultPhoto = 'data:image/svg+xml,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="72" height="72" viewBox="0 0 72 72"><circle cx="36" cy="36" r="36" fill="%23800000"/><text x="36" y="44" text-anchor="middle" fill="%23fff" font-size="24" font-family="sans-serif">' + (c.name ? c.name.charAt(0) : '?') + '</text></svg>')
          return '<div class="candidate-card"><img src="' + (c.photo_url || c.photoUrl || defaultPhoto) + '" alt="" onerror="this.src=\'' + defaultPhoto + '\'" loading="lazy"><strong style="font-size:0.8125rem;color:#fff;display:block">' + (c.name || '') + '</strong><span style="font-size:0.65rem;color:rgba(255,255,255,0.35);display:block;margin-bottom:0.75rem">' + (c.position || '') + '</span><button class="btn btn-crimson" onclick="votar(\'' + (c.id || c._id) + '\')" style="width:100%;justify-content:center;font-size:0.75rem">Votar</button></div>'
        }).join('')
      }).catch(function () { showToast('Error al cargar candidatos', 'error'); el.innerHTML = '<span style="color:var(--text-tertiary);grid-column:1/-1;text-align:center">🔒 Votaciones cerradas</span>' })
    }

    window.votar = function (candidateId) {
      if (!confirm('¿Confirmas tu voto? Esta acción es irreversible.')) return
      apiFetch('/api/admin/student/cast-vote', { method: 'POST', body: { student_id: studentId, candidate_id: candidateId } }).then(function (r) {
        alert('✓ Voto registrado correctamente'); loadCandidates()
      }).catch(function (e) { showToast('Error: ' + (e.detail || 'Ya has votado o el enlace falló'), 'error') })
    }

    // ── Aula Virtual ──
    function loadSubjects() {
      if (subjectsCache) { populateSubjectSelector(); return }
      apiFetch('/api/subjects').then(function (data) {
        subjectsCache = Array.isArray(data) ? data : []
        populateSubjectSelector()
      }).catch(function () {})
    }

    function populateSubjectSelector() {
      var sel = document.getElementById('subject-selector')
      if (!sel || !subjectsCache) return
      sel.innerHTML = '<option value="">Seleccionar materia...</option>' + subjectsCache.map(function (s) { return '<option value="' + (s.id || s.name) + '">' + (s.name || '') + '</option>' }).join('')
    }

    function loadSubjectResources() {
      var sel = document.getElementById('subject-selector')
      var container = document.getElementById('subject-resources')
      if (!sel || !container) return
      var subjectId = sel.value
      if (!subjectId) { container.innerHTML = '<span style="color:rgba(255,255,255,0.3)">Selecciona una materia para ver sus recursos.</span>'; return }
      var subject = (subjectsCache || []).find(function (s) { return (s.id || s.name) === subjectId })
      var html = ''
      if (subject && subject.tutor_ai) html += '<a href="' + subject.tutor_ai + '" target="_blank" class="btn btn-ghost" style="display:inline-flex;align-items:center;gap:0.375rem;margin-bottom:0.75rem;font-size:0.75rem">🤖 Tutor IA →</a>'
      var grade; try { grade = localStorage.getItem('userGrade') || '' } catch(e) { grade = '' }
      var subjectName = subject ? subject.name : subjectId
      apiFetch('/api/teacher/my-files/' + encodeURIComponent(grade) + '/' + encodeURIComponent(subjectName)).then(function (guides) {
        if (Array.isArray(guides) && guides.length > 0) {
          html += '<h3 style="font-size:0.75rem;font-weight:600;color:rgba(255,255,255,0.6);margin-bottom:0.5rem">📖 Guías</h3>'
          html += guides.map(function (g) {
            return '<div style="display:flex;justify-content:space-between;align-items:center;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.04)"><span style="font-size:0.75rem">' + (g.title || g.filename || 'Guía') + '</span><a href="' + (g.url || '#') + '" target="_blank" class="btn btn-ghost" style="font-size:0.65rem;padding:0.25rem 0.75rem">VER</a></div>'
          }).join('')
        } else { html += '<span style="color:rgba(255,255,255,0.3);font-size:0.75rem">Sin guías disponibles.</span>' }
        container.innerHTML = html
      }).catch(function () { showToast('Error al cargar guías', 'error'); container.innerHTML = '<span style="color:var(--text-tertiary);font-size:0.75rem">Error al cargar guías</span>' })
    }

    document.addEventListener('change', function (e) {
      if (e.target.id === 'subject-selector') loadSubjectResources()
    })

    // ── Homework ──
    window.updateFileName = function (input) {
      var el = document.getElementById('file-name-display')
      if (input.files && input.files[0]) el.textContent = '📄 ' + input.files[0].name
      else el.textContent = ''
    }

    window.sendHomework = function () {
      var sel = document.getElementById('hw-subject')
      var fileInput = document.getElementById('hw-file')
      var grade; try { grade = localStorage.getItem('userGrade') || '' } catch(e) { grade = '' }
      if (!sel.value || !fileInput.files[0]) { showToast('Selecciona una materia y un archivo.', 'error'); return }
      var fd = new FormData()
      fd.append('student_id', studentId); fd.append('grade', grade); fd.append('subject', sel.value); fd.append('file', fileInput.files[0])
      fetch(apiUrl + '/api/student/upload-homework', { method: 'POST', headers: { 'Authorization': 'Bearer ' + token }, body: fd }).then(function (r) {
        if (!r.ok) throw new Error('Error ' + r.status)
        return r.json()
      }).then(function () {
        alert('✓ Tarea subida correctamente')
        fileInput.value = ''; document.getElementById('file-name-display').textContent = ''
        loadHomeworkHistory()
      }).catch(function (e) { showToast('Error: ' + (e.message || 'desconocido'), 'error') })
    }

    function loadHomeworkHistory() {
      var el = document.getElementById('homework-history')
      apiFetch('/api/student/deliveries/' + encodeURIComponent(studentId)).then(function (data) {
        if (!Array.isArray(data) || data.length === 0) { el.innerHTML = '<span style="color:rgba(255,255,255,0.3)">Sin entregas aún.</span>'; return }
        el.innerHTML = data.slice(0, 10).map(function (d) {
          var dateStr = d.created_at ? new Date(d.created_at).toLocaleDateString('es-CO', { day: '2-digit', month: 'short' }) : d.date || ''
          return '<div style="display:flex;justify-content:space-between;align-items:center;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.04)"><span style="font-size:0.75rem">' + (d.subject || '') + '</span><span style="font-size:0.65rem;color:rgba(255,255,255,0.35)">' + dateStr + '</span></div>'
        }).join('')
      }).catch(function () { showToast('Error al cargar historial', 'error'); el.innerHTML = '<span style="color:var(--text-tertiary)">Error al cargar historial</span>' })
    }

    // ── Grades (Inicio) ──
    function loadGrades() {
      if (!studentId) return
      apiFetch('/api/grades?student_id=' + encodeURIComponent(studentId) + '&limit=200').then(function (data) {
        var grades = Array.isArray(data) ? data : []
        var subjectMap = {}
        grades.forEach(function (g) {
          var sid = g.subject_id || g.subject_name || 'General'
          if (!subjectMap[sid]) subjectMap[sid] = []
          subjectMap[sid].push(parseFloat(g.score) || 0)
        })
        var labels = Object.keys(subjectMap)
        var values = labels.map(function (sid) {
          var vals = subjectMap[sid]
          return vals.reduce(function (a, b) { return a + b }, 0) / vals.length
        })

        // Average
        var overallAvg = values.length ? values.reduce(function (a, b) { return a + b }, 0) / values.length : 0
        var avgEl = document.getElementById('avg-score-display')
        if (avgEl) avgEl.textContent = overallAvg ? overallAvg.toFixed(1) : '--'

        // Metrics grid
        var metricsEl = document.getElementById('metrics-grid')
        if (metricsEl) {
          var atRisk = values.filter(function (v) { return v < 3.5 }).length
          var passing = values.filter(function (v) { return v >= 3.5 }).length
          metricsEl.innerHTML =
            '<div class="stat-card" style="padding:0.5rem;text-align:center"><span class="stat-value" style="font-size:1.2rem">' + labels.length + '</span><span class="stat-label" style="font-size:0.55rem">Materias</span></div>' +
            '<div class="stat-card" style="padding:0.5rem;text-align:center"><span class="stat-value" style="font-size:1.2rem;color:var(--green)">' + passing + '</span><span class="stat-label" style="font-size:0.55rem">Aprobadas</span></div>' +
            '<div class="stat-card" style="padding:0.5rem;text-align:center"><span class="stat-value" style="font-size:1.2rem;color:var(--red)">' + atRisk + '</span><span class="stat-label" style="font-size:0.55rem">En Riesgo</span></div>'
        }

        // Grades grid
        var gridEl = document.getElementById('grades-grid')
        if (gridEl) {
          gridEl.innerHTML = labels.map(function (sid, i) {
            var v = values[i]
            var color = v >= 4 ? 'var(--green)' : v >= 3.5 ? 'var(--gold)' : 'var(--red)'
            var gradeColor = v >= 4 ? '#34d399' : v >= 3.5 ? '#fdc003' : '#ba1a1a'
            return '<div class="card-float" style="padding:0.75rem;display:flex;justify-content:space-between;align-items:center">' +
              '<span style="font-size:0.75rem;color:var(--text-secondary)">' + sid.substring(0, 20) + '</span>' +
              '<span style="font-family:var(--font-display);font-weight:700;font-size:1.1rem;color:' + gradeColor + '">' + v.toFixed(1) + '</span></div>'
          }).join('') || '<span style="color:rgba(255,255,255,0.3);font-size:0.75rem">Sin calificaciones</span>'
        }
      }).catch(function () { showToast('Error al cargar calificaciones', 'error') })
    }

    // ── Chart.js (Boletín) ──
    var performanceChart = null

    function loadChartData() {
      if (!studentId) return
      apiFetch('/api/grades?student_id=' + encodeURIComponent(studentId) + '&limit=200').then(function (data) {
        var grades = Array.isArray(data) ? data : []
        var subjectMap = {}
        grades.forEach(function (g) {
          var sid = g.subject_id || g.subject_name || 'General'
          if (!subjectMap[sid]) subjectMap[sid] = []
          subjectMap[sid].push(parseFloat(g.score) || 0)
        })
        var labels = []; var values = []
        Object.keys(subjectMap).forEach(function (sid) {
          var vals = subjectMap[sid]
          labels.push(sid.substring(0, 18))
          values.push(vals.reduce(function (a, b) { return a + b }, 0) / vals.length)
        })
        renderChart(labels, values)
      }).catch(function () {})
    }

    function renderChart(labels, values) {
      var ctx = document.getElementById('myGradesChart')
      if (!ctx) return
      if (performanceChart) performanceChart.destroy()
      performanceChart = new Chart(ctx, {
        type: 'bar',
        data: { labels: labels, datasets: [{ label: 'Promedio', data: values, backgroundColor: values.map(function (v) { return v >= 4 ? 'rgba(52,211,153,0.7)' : v >= 3 ? 'rgba(253,192,3,0.7)' : 'rgba(186,26,26,0.7)' }), borderColor: values.map(function (v) { return v >= 4 ? '#34D399' : v >= 3 ? '#FDC003' : '#BA1A1A' }), borderWidth: 2, borderRadius: 4 }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { min: 0, max: 5, ticks: { color: 'rgba(255,255,255,0.3)', stepSize: 1 }, grid: { color: 'rgba(255,255,255,0.04)' } }, x: { ticks: { color: 'rgba(255,255,255,0.5)', maxRotation: 30, font: { size: 10 } }, grid: { display: false } } } }
      })
    }

    // ── PDF Bulletin ──
    window.generarBoletinPDF = function () {
      if (typeof html2pdf === 'undefined') { loadScript('https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js', function () { generarBoletinPDF() }); return }
      var studentName = document.getElementById('student-name').textContent || 'Estudiante'
      var chartCanvas = document.getElementById('myGradesChart')
      var chartImg = ''
      if (chartCanvas && performanceChart) { chartImg = chartCanvas.toDataURL('image/png') }
      var gradeData = []
      if (performanceChart && performanceChart.data) {
        performanceChart.data.labels.forEach(function (l, i) { gradeData.push({ subject: l, grade: performanceChart.data.datasets[0].data[i] }) })
      }
      var el = document.createElement('div')
      el.style.cssText = 'padding:30px;font-family:Arial,sans-serif;color:#333;max-width:800px;margin:auto'
      el.innerHTML = '<div style="text-align:center;margin-bottom:20px;border-bottom:3px solid #800000;padding-bottom:15px"><h1 style="color:#800000;margin:0;font-size:22px">Colegio Técnico Ciudad del Sol</h1><p style="font-size:14px;color:#666;margin:5px 0 0">Vyntra Academic — Boletín de Calificaciones</p></div>' +
        '<p style="font-size:14px"><strong>Estudiante:</strong> ' + studentName + '</p>' +
        '<table style="width:100%;border-collapse:collapse;margin-top:15px"><thead><tr style="background:#800000;color:#fff"><th style="padding:8px;text-align:left;font-size:13px">Materia</th><th style="padding:8px;text-align:center;font-size:13px">Nota</th><th style="padding:8px;text-align:center;font-size:13px">Estado</th></tr></thead><tbody>' +
        gradeData.map(function (g) {
          var status = g.grade >= 4 ? '✅ Sobresaliente' : g.grade >= 3 ? '⚠️ Aceptable' : '❌ En Riesgo'
          return '<tr style="border-bottom:1px solid #eee"><td style="padding:8px;font-size:13px">' + g.subject + '</td><td style="padding:8px;text-align:center;font-size:13px;font-weight:700">' + g.grade.toFixed(1) + '</td><td style="padding:8px;text-align:center;font-size:12px">' + status + '</td></tr>'
        }).join('') +
        '</tbody></table>' +
        (chartImg ? '<div style="margin-top:20px;text-align:center"><img src="' + chartImg + '" style="max-width:100%;height:auto;max-height:250px"></div>' : '') +
        '<p style="margin-top:20px;font-size:11px;color:#999;text-align:center">Generado el ' + new Date().toLocaleString('es-CO') + ' · Vyntra Academic</p>'
      document.body.appendChild(el)
      html2pdf().set({ margin: 10, filename: 'Boletin_' + studentName.replace(/\s+/g, '_') + '.pdf', html2canvas: { scale: 2 }, jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' } }).from(el).save().then(function () { document.body.removeChild(el) })
    }

    // ── Initial Load ──
    function init() {
      var name = localStorage.getItem('userName') || 'Estudiante'
      document.getElementById('student-name').textContent = name + (localStorage.getItem('userGrade') ? ' · ' + localStorage.getItem('userGrade') : '')
      document.getElementById('student-meta').textContent = localStorage.getItem('is_paid') === 'true' || !localStorage.getItem('is_paid') ? 'Al día · Rendimiento académico' : '⚠️ En mora'
      loadGrades(); loadNotices(); loadSubjects()
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init)
    else init()
    } catch(e) {}
  })()
</script>
