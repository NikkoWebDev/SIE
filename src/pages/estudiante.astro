  // -- CALENDAR --
  (function buildCalendar(){
    var grid = document.getElementById('calGrid'); if(!grid) return
    var now = new Date(); var year = now.getFullYear(); var month = now.getMonth()
    var months = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre']
    document.getElementById('cal-month-label').textContent = months[month]+' '+year
    var firstDay = new Date(year, month, 1).getDay()
    var daysInMonth = new Date(year, month+1, 0).getDate()
    var startOffset = (firstDay===0?6:firstDay-1)
    var prevDays = new Date(year, month, 0).getDate()
    var dayNames = grid.querySelectorAll('.cal-day-name')
    grid.innerHTML = ''
    dayNames.forEach(function(dn){ grid.appendChild(dn.cloneNode(true)) })
    for(var i=startOffset-1; i>=0; i--){ var d=document.createElement('div'); d.className='cal-day other-month'; d.textContent=prevDays-i; grid.appendChild(d) }
    for(var d=1; d<=daysInMonth; d++){
      var el = document.createElement('div'); el.className='cal-day'
      if(d===now.getDate()) el.classList.add('today')
      var dow = new Date(year, month, d).getDay()
      if(dow===0||dow===6) el.style.opacity='0.5'
      el.textContent=d; el.onclick=function(){showToast('D\u00eda '+this.textContent+' de '+months[month],'info')}; grid.appendChild(el)
    }
    var total = grid.children.length; var next = 1
    while(total%7!==0){ var d=document.createElement('div'); d.className='cal-day other-month'; d.textContent=next++; grid.appendChild(d); total++ }
  })()

  // -- INIT --
  function init(){
    var name = localStorage.getItem('userName') || 'Estudiante'
    var grade = localStorage.getItem('userGrade') || ''
    document.getElementById('student-name').textContent = name + (grade?' &middot; '+grade:'')
    document.getElementById('student-meta').textContent = grade ? 'Grado '+grade+' &middot; Rendimiento acad\u00e9mico' : 'Panel de rendimiento acad\u00e9mico'
    document.getElementById('profile-name').textContent = name; document.getElementById('pf-name').textContent = name; document.getElementById('pf-grade').textContent = grade||'\u2014'
    document.getElementById('profile-avatar').textContent = name.charAt(0).toUpperCase()
    document.getElementById('profile-id').textContent = 'C\u00f3digo: '+(localStorage.getItem('profile_id')||'\u2014')
    document.getElementById('profile-grade-badge').textContent = grade||'\u2014'; document.getElementById('profile-bimestre-badge').textContent = getCurrentBimester()
    apiFetch('/api/profile/'+encodeURIComponent(studentId)).then(function(p){
      if(p){
        if(p.email) document.getElementById('pf-email').textContent = p.email
        if(p.document_id||p.documento) document.getElementById('pf-doc').textContent = p.document_id||p.documento
        if(p.phone||p.telefono) document.getElementById('pf-phone').textContent = p.phone||p.telefono
        if(p.shift||p.jornada) document.getElementById('pf-shift').textContent = p.shift||p.jornada
      }
    }).catch(function(){})
    loadGrades(); loadNotices(); loadSubjects()
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', init)
  else init()
})()
</script>
