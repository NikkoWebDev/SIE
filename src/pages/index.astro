---
import BaseLayout from '@layouts/BaseLayout.astro'
---

<BaseLayout
  titulo="Plataforma Académica Solaris"
  descripcion="VYNTRA Solaris — Ciencia, Tecnología y Futuro. Plataforma integral de gestión académica con metodología ABP, analítica en tiempo real y asistentes IA para el Colegio Técnico Ciudad del Sol, Sogamoso, Boyacá, Colombia."
  withNoise={true}
>
  <div class="relative">
    <!-- ══════════════════ HERO ══════════════════ -->
    <section id="hero" class="relative min-h-[100dvh] flex flex-col items-center justify-center overflow-hidden">
      <!-- Ambient background -->
      <div class="absolute inset-0 bg-gradient-to-b from-solar-base via-solar-cream to-solar-50 dark:from-surface-dark dark:via-[#0F0C08] dark:to-[#0A0705]">
        <!-- Solar flare -->
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[min(80vw,700px)] aspect-square rounded-full bg-gradient-to-br from-brand-gold/12 via-brand-amber/6 to-transparent blur-[140px] animate-orb will-change-transform"></div>
        <div class="absolute top-[60%] -right-32 w-[400px] aspect-square rounded-full bg-gradient-to-br from-brand-maroon/8 via-terracotta-400/4 to-transparent blur-[110px] animate-orb will-change-transform" style="animation-delay:-4s"></div>
        <div class="absolute -bottom-40 left-1/4 w-[500px] aspect-square rounded-full bg-gradient-to-t from-brand-gold/6 via-brand-amber/3 to-transparent blur-[130px] animate-orb will-change-transform" style="animation-delay:-7s"></div>
      </div>

      <!-- Grid dot pattern -->
      <div class="absolute inset-0" style="background-image:radial-gradient(var(--border) 1px,transparent 0);background-size:48px 48px;mask-image:radial-gradient(ellipse 70% 50% at 50% 25%,black 30%,transparent 70%);-webkit-mask-image:radial-gradient(ellipse 70% 50% at 50% 25%,black 30%,transparent 70%)"></div>

      <!-- Solar orbit rings (CSS art) -->
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[min(90vw,800px)] aspect-square pointer-events-none opacity-[0.08] dark:opacity-[0.12]" aria-hidden="true">
        <svg viewBox="0 0 800 800" class="w-full h-full animate-spin-slow" style="animation-duration:60s">
          <circle cx="400" cy="400" r="380" fill="none" stroke="currentColor" stroke-width="0.3" class="text-brand-maroon dark:text-brand-gold" stroke-dasharray="4 12"/>
          <circle cx="400" cy="400" r="300" fill="none" stroke="currentColor" stroke-width="0.2" class="text-brand-gold" stroke-dasharray="2 8"/>
          <circle cx="400" cy="400" r="200" fill="none" stroke="currentColor" stroke-width="0.2" class="text-brand-maroon dark:text-brand-gold"/>
          <circle cx="400" cy="400" r="100" fill="none" stroke="currentColor" stroke-width="0.5" class="text-brand-gold opacity-40" stroke-dasharray="1 6"/>
          <!-- Orbital dots -->
          <circle cx="400" cy="20" r="3" fill="currentColor" class="text-brand-maroon dark:text-brand-gold" opacity="0.4"/>
          <circle cx="700" cy="400" r="2.5" fill="currentColor" class="text-brand-gold" opacity="0.3"/>
          <circle cx="400" cy="700" r="2" fill="currentColor" class="text-brand-maroon dark:text-brand-gold" opacity="0.35"/>
          <!-- Center star -->
          <circle cx="400" cy="400" r="12" fill="currentColor" class="text-brand-gold" opacity="0.3"/>
          <circle cx="400" cy="400" r="6" fill="currentColor" class="text-brand-gold" opacity="0.5"/>
        </svg>
      </div>

      <!-- Small floating particles (CSS) -->
      <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
        {[0,1,2,3,4,5,6,7].map(i => (
          <div class="absolute w-1 h-1 rounded-full bg-brand-maroon/20 dark:bg-brand-gold/25 animate-particle will-change-transform" style={{
            left: `${15 + i * 12}%`,
            top: `${25 + (i % 4) * 18}%`,
            animationDelay: `${i * 0.7}s`,
            animationDuration: `${4 + i * 0.5}s`,
          }}></div>
        ))}
      </div>

      <!-- NAV -->
      <nav id="landing-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 ease-out">
        <div class="max-w-7xl mx-auto flex items-center justify-between px-4 sm:px-6 lg:px-8 h-16 sm:h-[72px]">
          <a href="/" class="flex items-center gap-2.5 group">
            <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-brand-maroon to-brand-maroon-dark text-white flex items-center justify-center text-sm font-extrabold shadow-glow-maroon transition-transform duration-300 group-hover:scale-105">V</div>
            <span class="text-sm font-bold tracking-tight transition-colors duration-300">VYNTRA</span>
            <span class="hidden sm:inline text-[10px] text-text-tertiary font-medium uppercase tracking-[0.2em] transition-colors duration-300">Solaris</span>
          </a>
          <div class="flex items-center gap-1 sm:gap-2">
            <a href="#features" class="hidden sm:inline-flex px-3 py-2 text-xs text-text-tertiary hover:text-text font-medium rounded-lg hover:bg-brand-maroon/5 dark:hover:bg-brand-gold/5 transition-all duration-200">Plataforma</a>
            <a href="#comunicados" class="hidden sm:inline-flex px-3 py-2 text-xs text-text-tertiary hover:text-text font-medium rounded-lg hover:bg-brand-maroon/5 dark:hover:bg-brand-gold/5 transition-all duration-200">Comunicados</a>
            <button id="nav-theme-toggle" class="p-2.5 rounded-xl text-text-tertiary hover:text-text hover:bg-brand-gold/10 dark:hover:bg-brand-gold/8 transition-all duration-200" aria-label="Cambiar tema">
              <svg class="h-4 w-4 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
              <svg class="h-4 w-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            </button>
            <a href="/login" class="relative inline-flex items-center gap-1.5 px-4 sm:px-5 py-2.5 bg-gradient-to-r from-brand-maroon to-brand-maroon-dark text-white text-xs sm:text-sm font-semibold rounded-xl hover:shadow-glow-maroon hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 ease-spring overflow-hidden group">
              <span class="relative z-10">Acceder</span>
              <svg class="relative z-10 h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
              <div class="absolute inset-0 bg-gradient-to-r from-brand-maroon-light to-brand-maroon opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            </a>
          </div>
        </div>
      </nav>

      <!-- Hero content -->
      <div class="relative z-10 flex flex-col items-center justify-center flex-1 px-4 sm:px-6 lg:px-8 py-32 sm:py-36 lg:py-40 w-full">
        <div class="max-w-5xl mx-auto text-center">
          <!-- Live badge -->
          <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-brand-maroon/8 dark:bg-brand-gold/10 border border-brand-maroon/12 dark:border-brand-gold/12 text-[10px] sm:text-[11px] font-semibold uppercase tracking-[0.15em] text-brand-maroon dark:text-brand-gold-light mb-6 sm:mb-8 animate-fade-up will-change-transform">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-success"></span>
            </span>
            Plataforma Académica v5.0
          </div>

          <!-- Main headline -->
          <h1 class="font-black leading-[0.82] tracking-[-0.04em] mb-5 sm:mb-7 animate-fade-up will-change-transform" style="font-size:clamp(3.2rem,12vw,7.5rem);font-family:'Fraunces',serif;animation-delay:0.1s">
            <span class="bg-gradient-to-r from-brand-maroon via-brand-maroon-light to-brand-gold dark:from-brand-gold dark:via-brand-amber dark:to-brand-gold-light bg-clip-text text-transparent bg-[length:200%_100%] animate-gradient-shift">VYNTRA</span>
            <br/>
            <span class="text-text dark:text-text">Solaris</span>
          </h1>

          <!-- Tagline -->
          <p class="text-sm sm:text-base lg:text-lg text-text-secondary font-medium tracking-[0.18em] uppercase mb-3 animate-fade-up will-change-transform" style="animation-delay:0.2s">
            Ciencia · Tecnología · Futuro
          </p>

          <!-- Description -->
          <p class="text-sm sm:text-base text-text-tertiary max-w-2xl mx-auto leading-relaxed mb-8 sm:mb-10 px-2 animate-fade-up will-change-transform" style="animation-delay:0.3s">
            Plataforma integral de gestión académica con metodología ABP, analítica en tiempo real y asistentes inteligentes — 
            <span class="hidden sm:inline">diseñada para potenciar la experiencia educativa en el Colegio Técnico Ciudad del Sol.</span>
          </p>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center items-center animate-fade-up will-change-transform" style="animation-delay:0.4s">
            <a href="/login" class="group relative inline-flex items-center justify-center gap-2.5 px-8 sm:px-10 py-3.5 sm:py-4 bg-gradient-to-r from-brand-maroon to-brand-maroon-dark text-white text-sm sm:text-base font-semibold rounded-xl hover:shadow-[0_0_40px_rgba(107,26,26,0.25)] hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 ease-spring overflow-hidden w-full sm:w-auto">
              <span class="relative z-10">Acceder al Portal</span>
              <svg class="relative z-10 h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
              <div class="absolute inset-0 bg-gradient-to-r from-brand-maroon-light to-brand-maroon-dark opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            </a>
            <a href="#comunicados" class="group inline-flex items-center justify-center gap-2 px-8 sm:px-10 py-3.5 sm:py-4 bg-white/30 dark:bg-surface-dark-card/50 backdrop-blur-sm border border-border hover:border-brand-gold/30 dark:hover:border-brand-gold/20 text-text dark:text-text text-sm sm:text-base font-semibold rounded-xl hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 ease-spring w-full sm:w-auto">
              Ver Comunicados
              <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-text-tertiary animate-fade-up will-change-transform" style="animation-delay:0.8s">
        <span class="text-[9px] font-semibold uppercase tracking-[0.3em]">Descubrir</span>
        <div class="relative w-px h-10 overflow-hidden">
          <div class="absolute inset-x-0 top-0 bottom-0 bg-gradient-to-b from-brand-maroon/40 via-brand-gold/30 to-transparent dark:from-brand-gold/40 dark:via-brand-amber/30 animate-float"></div>
        </div>
      </div>
    </section>

    <!-- ══════════════════ STATS ══════════════════ -->
    <section class="relative py-20 sm:py-28 border-t border-border" id="stats">
      <div class="absolute inset-0 bg-gradient-to-b from-solar-base/0 via-solar-cream/30 to-solar-base/0 dark:from-surface-dark/0 dark:via-[#0F0C08]/30 dark:to-surface-dark/0 pointer-events-none"></div>
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative">
        <div class="text-center mb-14 sm:mb-16">
          <span class="inline-flex px-3 py-1 rounded-full text-[10px] font-semibold uppercase tracking-widest bg-brand-maroon/8 dark:bg-brand-gold/10 text-brand-maroon dark:text-brand-gold-light border border-brand-maroon/10 dark:border-brand-gold/10 mb-4 opacity-0 reveal">Ecosistema</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-3 opacity-0 reveal" style="font-family:'Fraunces',serif">Comunidad <span class="bg-gradient-to-r from-brand-maroon to-brand-gold bg-clip-text text-transparent">VYNTRA</span></h2>
          <p class="text-sm text-text-tertiary opacity-0 reveal">Estado actual de la institución en tiempo real</p>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5">
          {[
            { id:'stat-estudiantes', label:'Estudiantes', value:'--', icon:'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2M12 4a3 3 0 110-6 3 3 0 010 6z', color:'from-brand-maroon to-brand-maroon-dark', delay:'0s' },
            { id:'stat-docentes', label:'Docentes', value:'--', icon:'M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.173-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z', color:'from-brand-gold to-brand-amber', delay:'0.08s' },
            { id:'stat-mora', label:'En Mora', value:'0', icon:'M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z', color:'from-brand-danger to-red-600', delay:'0.16s' },
            { id:'stat-avisos', label:'Comunicados', value:'--', icon:'M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z', color:'from-brand-info to-blue-500', delay:'0.24s' },
          ].map(stat => (
            <div class="group relative bg-white/40 dark:bg-surface-dark-card border border-border rounded-2xl p-6 sm:p-8 text-center transition-all duration-500 hover:-translate-y-2 hover:shadow-xl dark:hover:shadow-card-dark-hover opacity-0 reveal cursor-default" data-reveal-delay={stat.delay}>
              <div class={`absolute top-0 left-4 right-4 h-0.5 bg-gradient-to-r ${stat.color} rounded-full opacity-60 group-hover:opacity-100 transition-opacity duration-300`}></div>
              <div class="w-10 h-10 mx-auto mb-4 rounded-xl bg-brand-maroon/8 dark:bg-brand-gold/8 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                <svg class="h-5 w-5 text-brand-maroon dark:text-brand-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={stat.icon}/></svg>
              </div>
              <div class="text-4xl sm:text-5xl font-extrabold tracking-tight text-brand-maroon dark:text-brand-gold mb-1" style="font-family:'Fraunces',serif">
                <span id={stat.id}>{stat.value}</span>
              </div>
              <div class="text-[10px] sm:text-xs uppercase tracking-[0.15em] text-text-tertiary font-semibold">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════ FEATURES ══════════════════ -->
    <section class="relative py-20 sm:py-28 bg-[var(--bg-secondary)] dark:bg-[#0F0C08] border-t border-border overflow-hidden" id="features">
      <div class="absolute top-0 right-0 w-96 h-96 rounded-full bg-brand-gold/4 blur-[120px] pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 w-80 h-80 rounded-full bg-brand-maroon/4 blur-[100px] pointer-events-none"></div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative">
        <div class="text-center mb-14 sm:mb-16">
          <span class="inline-flex px-3 py-1 rounded-full text-[10px] font-semibold uppercase tracking-widest bg-brand-maroon/8 dark:bg-brand-gold/10 text-brand-maroon dark:text-brand-gold-light border border-brand-maroon/10 dark:border-brand-gold/10 mb-4 opacity-0 reveal">Por qué VYNTRA</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-3 opacity-0 reveal" style="font-family:'Fraunces',serif">Tecnología que <span class="bg-gradient-to-r from-brand-maroon to-brand-gold bg-clip-text text-transparent">educa</span></h2>
          <p class="text-sm text-text-tertiary max-w-xl mx-auto opacity-0 reveal">Una plataforma diseñada para potenciar cada aspecto de la vida académica</p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
          {[
            { title:'Rendimiento ABP', desc:'Seguimiento transversal de proyectos integradores con metodología activa y 9 materias vinculadas en un ecosistema de aprendizaje continuo.', icon:'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253', gradient:'from-blue-600 to-cyan-500' },
            { title:'Analítica en Vivo', desc:'Monitoreo en tiempo real de métricas académicas, financieras y alertas tempranas automatizadas con visualización de datos inteligente.', icon:'M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z', gradient:'from-brand-maroon to-brand-maroon-light' },
            { title:'Asistente IA', desc:'Chat inteligente multi-rol que analiza datos académicos, genera reportes personalizados y sugiere estrategias pedagógicas basadas en patrones.', icon:'M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z', gradient:'from-brand-gold to-brand-amber' },
            { title:'Gestión Financiera', desc:'Control de pagos, estado de cuenta y morosidad con alertas automáticas y reportes exportables para una administración transparente.', icon:'M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z', gradient:'from-emerald-500 to-green-600' },
            { title:'Biblioteca Digital', desc:'Recursos académicos por materia, guías de estudio descargables y acceso directo a tutores IA especializados por área de conocimiento.', icon:'M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25', gradient:'from-violet-500 to-purple-600' },
            { title:'Comunicación Centralizada', desc:'Sistema de avisos y comunicados oficiales con alcance segmentado por grados, notificaciones y registro histórico de publicaciones.', icon:'M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75', gradient:'from-brand-info to-blue-500' },
          ].map(f => (
            <div class="group relative bg-white/40 dark:bg-surface-dark-card border border-border rounded-2xl p-6 sm:p-7 transition-all duration-500 hover:-translate-y-2 hover:shadow-xl dark:hover:shadow-card-dark-hover opacity-0 reveal overflow-hidden" data-reveal-delay="0s">
              <div class={`absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r ${f.gradient} opacity-0 group-hover:opacity-100 transition-opacity duration-500`}></div>
              <div class={`w-11 h-11 rounded-xl bg-gradient-to-br ${f.gradient} bg-opacity-10 flex items-center justify-center mb-5 group-hover:scale-110 group-hover:shadow-lg transition-all duration-400`} style={{ backgroundColor: 'rgba(var(--brand-maroon),0.06)' }}>
