---
import BaseLayout from '@layouts/BaseLayout.astro'
import Logo from '@components/Logo.astro'

const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000'
---

<BaseLayout
  titulo="VYNTRA Solaris — Plataforma Académica"
  descripcion="Ciencia, Tecnología y Futuro. Plataforma integral de gestión académica para el Colegio Técnico Ciudad del Sol, Sogamoso, Boyacá, Colombia."
  withNoise={false}
  withThemeScript={false}
>
  <div class="bg-[#0A0505] text-white/90">

    <!-- ═══ HERO — full screen ═══ -->
    <section id="hero" class="relative min-h-[100svh] flex flex-col items-center justify-center overflow-hidden">
      <!-- Fondo gradiente sutil -->
      <div class="absolute inset-0 bg-gradient-to-b from-[#0A0404] via-[#110808] to-[#0D0A08]"></div>

      <!-- Grid dots decorativo -->
      <div class="absolute inset-0 opacity-[0.03]" style="background-image:radial-gradient(rgba(245,166,35,0.5) 1px,transparent 1px);background-size:44px 44px"></div>

      <!-- Glow detrás del logo -->
      <div class="absolute top-[42%] left-1/2 -translate-x-1/2 -translate-y-1/2 w-[min(70vw,500px)] aspect-square rounded-full bg-brand-gold/10 blur-[120px]"></div>

      <!-- Contenido del hero -->
      <div id="hero-content" class="relative z-10 flex flex-col items-center text-center px-4">
        <!-- Logo container — este es el que se vuelve sticky y crece -->
        <div id="logo-container" class="relative flex items-center justify-center">
          <Logo size={180} class="relative z-10 drop-shadow-[0_0_50px_rgba(245,166,35,0.3)]" />
          <!-- Anillos orbitales -->
          <svg class="absolute w-[260px] h-[260px] opacity-15 pointer-events-none animate-spin-slow" viewBox="0 0 260 260" style="animation-duration:80s">
            <circle cx="130" cy="130" r="120" fill="none" stroke="#F5A623" stroke-width="0.3" stroke-dasharray="2 10"/>
            <circle cx="130" cy="130" r="105" fill="none" stroke="#FFD166" stroke-width="0.2" stroke-dasharray="3 8"/>
          </svg>
        </div>

        <!-- Título y textos — animan con film-roll -->
        <div class="hero-text mt-8 space-y-3">
          <h1 class="font-black leading-[0.82] tracking-[-0.04em]" style="font-size:clamp(2.8rem,10vw,6.5rem);font-family:'Fraunces',serif">
            <span class="bg-gradient-to-r from-brand-gold via-brand-gold-light to-brand-amber bg-clip-text text-transparent">VYNTRA</span>
            <br/>
            <span>Solaris</span>
          </h1>
          <p class="text-sm text-brand-gold/40 tracking-[0.2em] uppercase font-medium">Ciencia &middot; Tecnología &middot; Futuro</p>
          <p class="text-xs text-white/20 max-w-md mx-auto leading-relaxed pt-2">
            Plataforma académica inteligente para el Colegio Técnico Ciudad del Sol. Sogamoso, Boyacá, Colombia.
          </p>
          <div class="pt-4">
            <a href="/login" class="inline-flex items-center gap-2 px-6 py-3 bg-brand-gold text-[#0A0505] text-sm font-bold rounded-xl hover:shadow-[0_0_40px_rgba(245,166,35,0.3)] hover:scale-105 transition-all duration-300">
              Acceder al Portal
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Scroll hint -->
      <div class="absolute bottom-6 flex flex-col items-center gap-2 text-white/15">
        <span class="text-[9px] tracking-[0.4em] uppercase font-semibold">Descubrir</span>
        <svg class="h-4 w-4 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </div>
    </section>

    <!-- ═══ SCROLL CONTAINER — logo crece, contenido orbita ═══ -->
    <div id="scroll-container" class="relative">
      <!-- Sticky wrapper -->
      <div class="sticky top-0 w-full h-[100svh] flex items-center justify-center overflow-hidden pointer-events-none">
        <!-- Logo que crece con el scroll -->
        <div id="sticky-logo" class="relative flex items-center justify-center transition-all duration-700 ease-out">
          <Logo size={180} class="relative z-10 drop-shadow-[0_0_60px_rgba(245,166,35,0.25)]" />
        </div>
      </div>

      <!-- Contenido que orbita (se mueve con JS) -->
      <div class="relative max-w-6xl mx-auto px-4 sm:px-8" style="margin-top:-100svh">

        <!-- ── Stats Block ── -->
        <div id="stats-block" class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 pt-[20svh] pb-[40svh] opacity-0">
          {[
            { id:'stat-estudiantes', label:'Estudiantes', value:'--' },
            { id:'stat-docentes', label:'Docentes', value:'--' },
            { id:'stat-mora', label:'Al Día', value:'0', suffix:'%' },
            { id:'stat-avisos', label:'Comunicados', value:'--' },
          ].map(s => (
            <div class="group bg-white/[0.02] border border-white/[0.05] rounded-xl p-5 text-center hover:border-brand-gold/15 hover:bg-white/[0.03] transition-all duration-300">
              <div class="text-3xl sm:text-4xl font-extrabold text-brand-gold mb-1" style="font-family:'Fraunces',serif">
                <span id={s.id}>{s.value}</span>
              </div>
              <div class="text-[10px] uppercase tracking-[0.15em] text-white/20 font-semibold">{s.label}</div>
            </div>
          ))}
        </div>

        <!-- ── Features Grid ── -->
        <div id="features-block" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4 pb-[40svh] opacity-0">
          {[
            { title:'Rendimiento ABP', desc:'Seguimiento de proyectos integradores con 9 materias vinculadas en metodología activa.' },
            { title:'Analítica en Vivo', desc:'Métricas académicas y financieras en tiempo real con alertas automatizadas.' },
            { title:'Asistente IA', desc:'Chat multi-rol que analiza datos, genera reportes y sugiere estrategias pedagógicas.' },
            { title:'Gestión Financiera', desc:'Control de pagos, estado de cuenta y morosidad con reportes exportables.' },
            { title:'Biblioteca Digital', desc:'Recursos por materia, guías descargables y tutores IA por área.' },
            { title:'Comunicación', desc:'Avisos oficiales segmentados por grados con notificaciones.' },
          ].map(f => (
            <div class="group bg-white/[0.02] border border-white/[0.05] rounded-xl p-5 hover:border-brand-gold/10 transition-all duration-300">
              <h3 class="font-bold text-sm text-white/80 mb-2" style="font-family:'Fraunces',serif">{f.title}</h3>
              <p class="text-xs text-white/30 leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>

        <!-- ── Notices / Comunicados ── -->
        <div id="notices-block" class="pb-[30svh] opacity-0">
          <div class="flex items-center gap-3 mb-6">
            <Logo size={28} />
            <h2 class="text-xl font-bold text-white/80" style="font-family:'Fraunces',serif">Comunicados <span class="text-brand-gold">Oficiales</span></h2>
          </div>
          <div id="notice-skeleton" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
            {[1,2,3].map(i => (
              <div class="bg-white/[0.02] border border-white/[0.05] rounded-xl p-5">
                <div class="skeleton-shimmer h-3 w-16 rounded mb-3" style="--skeleton-from:rgba(245,166,35,0.05);--skeleton-to:rgba(245,166,35,0.01)"></div>
                <div class="skeleton-shimmer h-4 w-3/4 rounded mb-2" style="--skeleton-from:rgba(245,166,35,0.05);--skeleton-to:rgba(245,166,35,0.01)"></div>
                <div class="skeleton-shimmer h-3 w-full rounded" style="--skeleton-from:rgba(245,166,35,0.05);--skeleton-to:rgba(245,166,35,0.01)"></div>
              </div>
            ))}
          </div>
          <div id="notice-grid" class="hidden grid sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4"></div>
          <div id="notice-empty" class="hidden text-center py-12 text-white/15 text-sm">No hay comunicados publicados.</div>
        </div>

        <!-- ── Final CTA ── -->
        <div id="final-cta" class="text-center pb-[20svh] opacity-0">
          <div class="flex justify-center mb-6">
            <Logo size={80} class="drop-shadow-[0_0_30px_rgba(245,166,35,0.3)]" />
          </div>
          <h2 class="text-2xl sm:text-4xl font-bold text-white/85 mb-4" style="font-family:'Fraunces',serif">
            El <span class="text-brand-gold">futuro</span> comienza aquí
          </h2>
          <p class="text-white/25 text-sm mb-8 max-w-md mx-auto">
            Accede a la plataforma de gestión académica más avanzada de Boyacá.
          </p>
          <a href="/login" class="inline-flex items-center gap-2 px-8 py-3.5 bg-gradient-to-r from-brand-gold to-brand-amber text-[#0A0505] text-sm font-bold rounded-xl hover:shadow-[0_0_50px_rgba(245,166,35,0.35)] hover:scale-105 transition-all duration-300">
            Ingresar al Portal
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- ═══ FOOTER ═══ -->
    <footer class="border-t border-white/[0.04] py-8 px-4 sm:px-8">
      <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-[10px] text-white/10">
        <div class="flex items-center gap-2">
          <Logo size={16} />
          <span class="tracking-[0.2em] uppercase">VYNTRA Solaris v5.0</span>
        </div>
        <span>Colegio Técnico Ciudad del Sol · Sogamoso, Boyacá, Colombia</span>
      </div>
    </footer>
  </div>

  <!-- ScrollTrigger Animation Script -->
  <script>
    import { gsap } from 'gsap'
    import { ScrollTrigger } from 'gsap/ScrollTrigger'
    gsap.registerPlugin(ScrollTrigger)

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    if (!prefersReducedMotion) {
      // ── Hero film-roll: texto rota y desaparece ──
      const heroTl = gsap.timeline({
        scrollTrigger: {
          trigger: '#hero',
          start: 'top top',
          end: 'top+=300 top',
          scrub: 1,
        }
      })

      gsap.utils.toArray('.hero-text > *').forEach((el, i) => {
        heroTl.to(el, {
          rotationX: 90,
          y: -25,
          scale: 0.5,
          opacity: 0,
          filter: 'blur(4px)',
          ease: 'power3.inOut',
          transformOrigin: 'center top',
        }, i * 0.06)
      })

      // ── Logo crece con el scroll ──
      gsap.to('#sticky-logo', {
        scrollTrigger: {
          trigger: '#scroll-container',
          start: 'top top',
          end: 'bottom bottom',
          scrub: 1.2,
        },
        scale: 2.5,
        opacity: 0.12,
        ease: 'none',
      })

      // ── Content blocks fade in as logo grows ──
      const reveals = [
        { el: '#stats-block', start: 'top 80%', end: 'top 40%' },
        { el: '#features-block', start: 'top 75%', end: 'top 35%' },
        { el: '#notices-block', start: 'top 80%', end: 'top 45%' },
        { el: '#final-cta', start: 'top 85%', end: 'top 50%' },
      ]

      reveals.forEach(({ el, start, end }) => {
        gsap.to(el, {
          scrollTrigger: { trigger: el, start, end, scrub: 0.8 },
          opacity: 1,
          y: -15,
          ease: 'power2.out',
        })
      })
    } else {
      // Show everything immediately for reduced motion
      document.querySelectorAll('.opacity-0').forEach(el => el.classList.remove('opacity-0'))
    }
  </script>

  <!-- Data loading (preserved from original) -->
  <script define:vars={{ API_BASE }}>
    (function() {
      var API = API_BASE

      function fetchWithRetry(url, opts, retries) {
        retries = retries || 3
        var f = (window.VYNTRA && window.VYNTRA.origFetch)
        if (!f) { try { f = window.fetch.bind(window) } catch(_) { f = fetch } }
        return f(url, opts).catch(function(err) {
          if (retries <= 1) throw err
          return new Promise(function(resolve) { setTimeout(resolve, 3000) }).then(function() {
            return fetchWithRetry(url, opts, retries - 1)
          })
        })
      }

      async function loadData() {
        try {
          var res = await fetchWithRetry(API + '/api/admin/stats', { signal: AbortSignal.timeout(10000) })
          if (!res.ok) return
          var d = await res.json()
          var map = {
            'stat-estudiantes': d.total_students || '--',
            'stat-docentes': d.total_teachers || '--',
            'stat-mora': d.mora || 0,
            'stat-avisos': d.total_notices || '--'
          }
          Object.keys(map).forEach(function(id) {
            var el = document.getElementById(id)
            if (el) el.textContent = map[id]
          })
        } catch(e) {}

        try {
          var res2 = await fetchWithRetry(API + '/api/notices', { signal: AbortSignal.timeout(10000) })
          if (!res2.ok) throw new Error()
          var notices = await res2.json()
          var skeleton = document.getElementById('notice-skeleton')
          var grid = document.getElementById('notice-grid')
          var empty = document.getElementById('notice-empty')
          if (!notices || !notices.length) {
            if (skeleton) skeleton.style.display = 'none'
            if (empty) empty.classList.remove('hidden')
            return
          }
          if (skeleton) skeleton.style.display = 'none'
          grid.innerHTML = notices.map(function(n) {
            var d = new Date(n.fecha || n.date).toLocaleDateString('es-CO', { day:'numeric', month:'short', year:'numeric' })
            var cat = n.categoria || n.category || 'General'
            var txt = (n.resumen || n.excerpt || n.contenido || n.content || '').substring(0, 100)
            return '<div class="bg-white/[0.02] border border-white/[0.05] rounded-xl p-5 hover:border-brand-gold/10 transition-all duration-300">' +
              '<span class="inline-block px-2 py-0.5 rounded-full text-[10px] bg-brand-gold/[0.08] text-brand-gold/60 font-semibold mb-3">' + cat + '</span>' +
              '<h3 class="font-bold text-sm text-white/75 mb-2">' + (n.titulo || n.title || '') + '</h3>' +
              '<p class="text-xs text-white/30 mb-3">' + txt + '</p>' +
              '<time class="text-[10px] text-white/12">' + d + '</time></div>'
          }).join('')
          grid.classList.remove('hidden')
        } catch(e) {
          var skel = document.getElementById('notice-skeleton')
          if (skel) skel.style.display = 'none'
        }
      }

      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', loadData)
      else loadData()
    })()
  </script>
</BaseLayout>
