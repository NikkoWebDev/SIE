  <script define:vars={{ API_BASE: import.meta.env.PUBLIC_API_URL || 'http://localhost:8000' }}>
    (function() {
      var isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      // ── NAV SCROLL EFFECT ──
      var nav = document.getElementById('landing-nav')
      var ticking = false
      function updateNav() {
        var scrollY = window.scrollY
        if (scrollY > 60) {
          nav.classList.add('nav-blur')
          nav.style.boxShadow = '0 1px 3px rgba(0,0,0,0.04)'
        } else {
          nav.classList.remove('nav-blur')
          nav.style.boxShadow = 'none'
        }
      }
      window.addEventListener('scroll', function() {
        if (!ticking) {
          requestAnimationFrame(function() {
            updateNav()
            ticking = false
          })
          ticking = true
        }
      }, { passive: true })
      updateNav()

      // ── THEME TOGGLE ──
      var themeBtn = document.getElementById('nav-theme-toggle')
      function setTheme(isDark) {
        document.documentElement.classList.toggle('dark', isDark)
        localStorage.setItem('vyntra-theme', isDark ? 'dark' : 'light')
      }
      themeBtn?.addEventListener('click', function() {
        setTheme(!document.documentElement.classList.contains('dark'))
      })

      // ── SCROLL REVEALS (IntersectionObserver) ──
      if (!isReduced && 'IntersectionObserver' in window) {
        var revealObserver = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              var el = entry.target
              var delay = el.getAttribute('data-reveal-delay') || '0s'
              el.style.animation = 'fadeUp 0.7s cubic-bezier(0.19,1,0.22,1) ' + delay + ' both'
              el.classList.remove('opacity-0')
              revealObserver.unobserve(el)
            }
          })
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' })

        document.querySelectorAll('.opacity-0.reveal').forEach(function(el) {
          el.style.opacity = '0' // ensure initial state
          revealObserver.observe(el)
        })
      } else {
        document.querySelectorAll('.opacity-0.reveal').forEach(function(el) {
          el.classList.remove('opacity-0')
        })
      }

      // ── LOAD DATA (with retry for Render cold start) ──
      var API = API_BASE
      function fetchWithRetry(url, opts, retries) {
        retries = retries || 3
        return fetch(url, opts).catch(function(err) {
          if (retries <= 1) throw err
          return new Promise(function(resolve) { setTimeout(resolve, 3000) }).then(function() {
            return fetchWithRetry(url, opts, retries - 1)
          })
        })
      }
      async function loadData() {
        try {
          var res = await fetchWithRetry(API + '/api/admin/stats', { signal: AbortSignal.timeout(10000) })
          if (!res.ok) return
          var d = await res.json()
          var map = {
            'stat-estudiantes': d.total_students,
            'stat-docentes': d.total_teachers,
            'stat-mora': d.mora || 0,
            'stat-avisos': d.total_notices
          }
          Object.keys(map).forEach(function(id) {
            var el = document.getElementById(id)
            if (el) {
              var target = map[id] ?? '--'
              el.textContent = target
            }
          })
        } catch(e) {}

        try {
          var res2 = await fetchWithRetry(API + '/api/notices', { signal: AbortSignal.timeout(10000) })
          if (!res2.ok) throw new Error()
          var notices = await res2.json()
          var skeleton = document.getElementById('notice-skeleton')
          var grid = document.getElementById('notice-grid')
          var error = document.getElementById('notice-error')
          if (!notices || notices.length === 0) {
            skeleton.style.display = 'none'
            error.textContent = 'No hay comunicados publicados.'
            error.classList.remove('hidden')
            return
          }
          skeleton.style.display = 'none'
          grid.innerHTML = notices.map(function(n, i) {
            var d = new Date(n.fecha || n.date).toLocaleDateString('es-CO', { day:'numeric', month:'long', year:'numeric' })
            var c = n.categoria || n.category || 'General'
            var content = (n.resumen || n.excerpt || n.contenido || n.content || '').substring(0, 120)
            return '<div class="group bg-white/40 dark:bg-surface-dark-card border border-border rounded-2xl p-5 sm:p-6 transition-all duration-500 hover:-translate-y-1.5 hover:shadow-xl dark:hover:shadow-card-dark-hover" style="opacity:0;animation:fadeUp .6s cubic-bezier(.19,1,.22,1) ' + (i * 0.08) + 's forwards">' +
              '<span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-semibold uppercase tracking-wider bg-brand-maroon/10 dark:bg-brand-gold/10 text-brand-maroon dark:text-brand-gold-light mb-3.5">' + c + '</span>' +
              '<h3 class="font-bold text-sm mb-2 leading-snug">' + (n.titulo || n.title) + '</h3>' +
              '<p class="text-xs text-text-secondary leading-relaxed mb-4">' + content + '</p>' +
              '<time class="text-xs text-text-tertiary flex items-center gap-1.5">' +
              '<svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>' +
              d + '</time>' +
              '</div>'
          }).join('')
          grid.classList.remove('hidden')
          grid.style.display = 'grid'
        } catch(e) {
          var skel = document.getElementById('notice-skeleton')
          var err = document.getElementById('notice-error')
          if (skel) skel.style.display = 'none'
          if (err) err.classList.remove('hidden')
        }
      }

      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', loadData)
      else loadData()
    })()
  </script>
