---
import '../styles/theme.css'
const API_BASE = import.meta.env.PUBLIC_API_URL || "http://localhost:8000"
---

<!doctype html>
<html lang="es-CO">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>VYNTRA · Plataforma Académica</title>
  <meta name="description" content="Plataforma académica VYNTRA — Tecnología educativa, ABP, y analítica en tiempo real. Sogamoso, Boyacá, Colombia." />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://colegiociudaddelsol.edu.co" />
  <meta property="og:title" content="VYNTRA · Plataforma Académica" />
  <meta property="og:description" content="Plataforma académica VYNTRA — Tecnología educativa, ABP, y analítica en tiempo real. Sogamoso, Boyacá, Colombia." />
  <meta property="og:url" content="https://colegiociudaddelsol.edu.co" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="VYNTRA Academic" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="VYNTRA · Plataforma Académica" />
  <meta name="twitter:description" content="Plataforma académica VYNTRA — Tecnología educativa, ABP, y analítica en tiempo real. Sogamoso, Boyacá, Colombia." />
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "EducationalOrganization",
      "name": "Colegio Técnico Ciudad del Sol",
      "alternateName": "VYNTRA Academic",
      "url": "https://colegiociudaddelsol.edu.co",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Sogamoso",
        "addressRegion": "Boyacá",
        "addressCountry": "CO"
      }
    }
  </script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700;800&family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline>
    (function(){try{var t=localStorage.getItem('vyntra-theme');if(t==='dark'||(!t&&window.matchMedia('(prefers-color-scheme:dark)').matches))document.documentElement.classList.add('dark')}catch(e){}})();
  </script>
  <style>
    .hero-orb{position:absolute;width:50vmin;height:50vmin;left:50%;top:50%;transform:translate(-50%,-50%);background:radial-gradient(circle,rgba(128,0,0,.06) 0%,rgba(253,192,3,.03) 30%,transparent 60%);transition:all .8s var(--ease-out)}
    @keyframes float{0%,100%{transform:translate(-50%,-50%)}50%{transform:translate(-50%,-52%)}}
    .hero-orb{animation:float 6s ease-in-out infinite}
    .hero-grid{position:absolute;inset:0;background-image:radial-gradient(var(--border) 1px,transparent 1px);background-size:32px 32px;mask-image:radial-gradient(ellipse 60% 50% at 50% 50%,black 20%,transparent 70%)}
    .stagger>*{opacity:0;transform:translateY(16px);animation:fadeUp .6s var(--ease-out) forwards}
    .stagger>*:nth-child(1){animation-delay:.1s}
    .stagger>*:nth-child(2){animation-delay:.25s}
    .stagger>*:nth-child(3){animation-delay:.4s}
    .stagger>*:nth-child(4){animation-delay:.55s}
    .stagger>*:nth-child(5){animation-delay:.7s}
    .stagger>*:nth-child(6){animation-delay:.85s}
    @media(min-width:768px){#hero-section{padding:6rem 2rem 4rem}}
    @media(max-width:380px){#hero-section{padding:4rem .75rem 2rem}}
    @media(max-width:480px){#hero-heading{font-size:clamp(2.2rem,12vw,3rem)!important}}
    #stats-section,#features-section,#notices-section{transition:padding .3s var(--ease-out)}
    @media(min-width:768px){#stats-section{padding:5rem 2rem}#features-section{padding:5rem 2rem}#notices-section{padding:5rem 2rem}}
    @media(max-width:380px){#stats-section{padding:2rem .75rem}#features-section{padding:2rem .75rem}#notices-section{padding:2rem .75rem}}
    @media(max-width:480px){.stats-grid{grid-template-columns:repeat(2,1fr)!important}}
    @media(max-width:380px){.stats-grid{grid-template-columns:1fr!important}}
  </style>
</head>
<body>
  <div class="noise-fixed"></div>

  <!-- NAV -->
  <nav class="nav-blur" style="position:fixed;top:0;left:0;right:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:0 1.5rem;height:52px">
    <div style="display:flex;align-items:center;gap:.5rem">
      <div style="width:28px;height:28px;border-radius:var(--radius-md);background:var(--maroon);color:white;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.75rem">V</div>
      <span style="font-weight:600;font-size:.85rem;font-family:var(--font-display);color:var(--text)">VYNTRA</span>
    </div>
    <div style="display:flex;align-items:center;gap:.75rem">
      <a href="/login" class="btn-apple btn-primary" style="padding:.45rem 1.1rem;font-size:.75rem">Ingresar</a>
    </div>
  </nav>

  <!-- HERO -->
  <section id="hero-section" style="min-height:100dvh;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;padding:5rem 1.25rem 3rem">
    <div class="hero-grid"></div>
    <div class="hero-orb"></div>
    <div style="position:relative;z-index:2;text-align:center;max-width:800px" class="stagger">
      <div>
        <span class="badge badge-maroon" style="margin-bottom:1.5rem">Plataforma Académica v5.0</span>
      </div>
      <div>
        <h1 id="hero-heading" style="font-family:var(--font-display);font-weight:800;font-size:clamp(3rem,10vw,6rem);line-height:.9;letter-spacing:-.04em;color:var(--text);margin-bottom:.25rem">
          <span style="color:var(--maroon)">VYN</span><span style="color:var(--text)">TRA</span>
        </h1>
      </div>
      <div>
        <p style="font-size:clamp(.9rem,2vw,1.2rem);color:var(--text-secondary);letter-spacing:.3em;text-transform:uppercase;font-weight:500;margin-bottom:1.5rem">Ciencia · Tecnología · Futuro</p>
      </div>
      <div>
        <p style="font-size:clamp(.95rem,1.5vw,1.1rem);color:var(--text-tertiary);line-height:1.7;max-width:560px;margin:0 auto 2.5rem">
          Plataforma integral de gestión académica con metodología ABP, analítica en tiempo real y alertas inteligentes — Sogamoso, Boyacá, Colombia.
        </p>
      </div>
      <div style="display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap">
        <a href="/login" class="btn-apple btn-primary" style="padding:.85rem 2rem;font-size:.85rem">
          Acceder al Portal
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
        <a href="#comunicados" class="btn-apple btn-secondary" style="padding:.85rem 2rem;font-size:.85rem">
          Ver Comunicados
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
        </a>
      </div>
    </div>
    <div style="position:absolute;bottom:2rem;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:6px;color:var(--text-tertiary);font-size:.6rem;letter-spacing:.2em;text-transform:uppercase">
      <span>Descubrir</span>
      <div style="width:1px;height:32px;background:linear-gradient(to bottom,var(--maroon),transparent);animation:scrollPulse 2s ease-in-out infinite"></div>
    </div>
  </section>

  <style>
    @keyframes scrollPulse{0%,100%{opacity:.4;transform:scaleY(1)}50%{opacity:1;transform:scaleY(.6)}}
  </style>

  <!-- STATS -->
  <section style="padding:3rem 1.25rem;border-top:1px solid var(--border);border-bottom:1px solid var(--border)" id="stats-section">
    <div style="max-width:1000px;margin:0 auto">
    <div style="max-width:1000px;margin:0 auto">
      <div style="text-align:center;margin-bottom:3rem" class="animate-in">
        <span class="badge badge-maroon" style="margin-bottom:.75rem">En Vivo</span>
        <h2 style="font-family:var(--font-display);font-weight:700;font-size:clamp(1.8rem,4vw,2.8rem);color:var(--text);margin-bottom:.5rem">Ecosistema Académico</h2>
      </div>
      <div class="stats-grid">
        <div class="card-float stat-card animate-in"><span class="stat-value" id="stat-estudiantes">--</span><span class="stat-label">Estudiantes</span></div>
        <div class="card-float stat-card animate-in"><span class="stat-value" id="stat-docentes">--</span><span class="stat-label">Docentes</span></div>
        <div class="card-float stat-card animate-in"><span class="stat-value" id="stat-mora">--</span><span class="stat-label">En Mora</span></div>
        <div class="card-float stat-card animate-in"><span class="stat-value" id="stat-avisos">--</span><span class="stat-label">Comunicados</span></div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section id="features-section" style="padding:3rem 1.25rem">
    <div style="max-width:1100px;margin:0 auto">
      <div style="text-align:center;margin-bottom:3rem" class="animate-in">
        <span class="badge badge-maroon" style="margin-bottom:.75rem">Comunidad VYNTRA</span>
        <h2 style="font-family:var(--font-display);font-weight:700;font-size:clamp(1.8rem,4vw,2.8rem);color:var(--text);margin-bottom:.5rem">Sogamoso, Boyacá</h2>
        <p style="color:var(--text-secondary);max-width:500px;margin:0 auto">Formación integral con énfasis en ciencia, técnica y valores humanos.</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem">
        {[
          {icon:'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',title:'Rendimiento ABP',desc:'Seguimiento transversal de proyectos integradores con metodología ABP.'},
          {icon:'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',title:'Analítica en Vivo',desc:'Monitoreo en tiempo real de métricas académicas con alertas tempranas.'},
          {icon:'M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z',title:'Asistente IA',desc:'Chat inteligente para resumir reportes, generar alertas y analizar tendencias.'},
        ].map(f => (
          <div class="card-float animate-in" style="padding:1.5rem">
            <div style="width:36px;height:36px;border-radius:var(--radius-md);background:var(--maroon-subtle);display:flex;align-items:center;justify-content:center;margin-bottom:1rem">
              <svg class="h-4 w-4" style="color:var(--maroon)" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={f.icon}/></svg>
            </div>
            <h3 style="font-family:var(--font-display);font-weight:600;font-size:1.05rem;color:var(--text);margin-bottom:.35rem">{f.title}</h3>
            <p style="color:var(--text-secondary);font-size:.85rem;line-height:1.6">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- NOTICES -->
  <section id="notices-section" style="padding:3rem 1.25rem;background:var(--bg-secondary);border-top:1px solid var(--border)">
    <div style="max-width:1100px;margin:0 auto;text-align:center">
      <span class="badge badge-maroon" style="margin-bottom:.75rem">En Vivo</span>
      <h2 style="font-family:var(--font-display);font-weight:700;font-size:clamp(1.8rem,4vw,2.8rem);color:var(--text);margin-bottom:.5rem">Comunicados Institucionales</h2>
      <p style="color:var(--text-secondary);margin-bottom:3rem;font-size:.9rem">Información oficial para la Comunidad VYNTRA</p>

      <div id="notice-skeleton" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem;text-align:left">
        {[1,2,3].map(() => (
          <div class="card-float" style="padding:1.5rem">
            <div class="shimmer" style="height:12px;width:80px;margin-bottom:10px"></div>
            <div class="shimmer" style="height:18px;width:75%;margin-bottom:6px"></div>
            <div class="shimmer" style="height:12px;width:55%;margin-bottom:14px"></div>
            <div class="shimmer" style="height:8px;width:60px"></div>
          </div>
        ))}
      </div>
      <div id="notice-grid" style="display:none;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem;text-align:left"></div>
      <div id="notice-error" style="display:none;margin-top:2rem;padding:1.25rem;border-radius:var(--radius-lg);border:1px solid rgba(186,26,26,.2);background:rgba(186,26,26,.04)">
        <p style="color:var(--red);font-size:.85rem">No se pudieron cargar los comunicados.</p>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer style="border-top:1px solid var(--border);padding:2rem;text-align:center">
    <div style="display:flex;flex-direction:column;align-items:center;gap:4px">
      <span style="font-family:var(--font-display);font-weight:700;color:var(--maroon);font-size:.9rem">VYNTRA</span>
      <span style="font-size:.75rem;color:var(--text-tertiary)">© 2026 VYNTRA Academic · Sogamoso, Boyacá, Colombia</span>
      <span style="font-size:.65rem;color:var(--text-tertiary);opacity:.5">v5.0</span>
    </div>
  </footer>

  <script define:vars={{ API_BASE }}>
    (function() {
      var API = API_BASE

      async function loadStats() {
        try {
          var res = await fetch(API + '/api/admin/stats')
          if (!res.ok) return
          var d = await res.json()
          var map = {'stat-estudiantes': d.total_students,'stat-docentes': d.total_teachers,'stat-mora': d.mora,'stat-avisos': d.total_notices}
          for (var id in map) {
            var el = document.getElementById(id)
            if (el) el.textContent = map[id] ?? '--'
          }
        } catch(e) {}
      }

      async function loadNotices() {
        var skeleton = document.getElementById('notice-skeleton')
        var grid = document.getElementById('notice-grid')
        var error = document.getElementById('notice-error')
        try {
          var res = await fetch(API + '/api/notices')
          if (!res.ok) throw new Error()
          var notices = await res.json()
          if (!notices || notices.length === 0) {
            skeleton.style.display = 'none'
            error.querySelector('p').textContent = 'No hay comunicados publicados.'
            error.style.display = 'block'
            return
          }
          skeleton.style.display = 'none'
          grid.innerHTML = notices.map(function(n, i) {
            var d = new Date(n.fecha || n.date).toLocaleDateString('es-CO', {day:'numeric',month:'long',year:'numeric'})
            var c = n.categoria || n.category || 'General'
            return '<div class="card-float" style="padding:1.5rem;opacity:0;animation:fadeUp .5s var(--ease-out) '+(i*0.08)+'s forwards">' +
              '<span class="badge badge-maroon" style="margin-bottom:10px">' + c + '</span>' +
              '<h3 style="font-family:var(--font-display);font-weight:600;font-size:1rem;color:var(--text);margin-bottom:6px">' + (n.titulo || n.title) + '</h3>' +
              '<p style="color:var(--text-secondary);font-size:.8rem;line-height:1.6;margin-bottom:10px">' + (n.resumen || n.excerpt || n.contenido || n.content || '') + '</p>' +
              '<time style="font-size:.7rem;color:var(--text-tertiary)">' + d + '</time></div>'
          }).join('')
          grid.style.display = 'grid'
        } catch(e) {
          skeleton.style.display = 'none'
          error.style.display = 'block'
        }
      }

      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function() { loadStats(); loadNotices() })
      else { loadStats(); loadNotices() }
    })()
  </script>
</body>
</html>
