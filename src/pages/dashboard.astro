---
import BaseLayout from '@layouts/BaseLayout.astro'
---

<BaseLayout titulo="Panel" descripcion="Redirigiendo al panel de VYNTRA Academic" noIndex={true}>
  <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-solar-base via-solar-cream to-solar-50 dark:from-surface-dark dark:via-[#0F0C08] dark:to-[#0A0705]">
    <div class="text-center">
      <div class="animate-spin-slow h-10 w-10 border-2 border-brand-maroon/20 border-t-brand-maroon dark:border-brand-gold/20 dark:border-t-brand-gold rounded-full mx-auto mb-4"></div>
      <p class="text-sm text-text-secondary">Cargando panel...</p>
    </div>
  </div>

  <script>
    (function() {
      // Use unified session manager if available (from BaseLayout module import)
      if (window.VyntraSession && window.VyntraSession.getRole && window.VyntraSession.redirectToRole) {
        var role = window.VyntraSession.getRole()
    if (!role) { window.location.href = '/login'; return }
    window.VyntraSession.redirectToRole()
  } else {
    // Fallback
    var roleRaw = (localStorage.getItem('userRole') || '').toUpperCase()
    if (!roleRaw) { window.location.href = '/login'; return }
        var map = { ADMIN:'/admin', RECTOR:'/admin', PROFESOR:'/docente', DOCENTE:'/docente', ESTUDIANTE:'/estudiante', STUDENT:'/estudiante', TEACHER:'/docente' }
        window.location.href = map[roleRaw] || '/estudiante'
      }
    })()
  </script>
</BaseLayout>
