---
import Layout from '@layouts/Layout.astro'
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000'
---
<Layout titulo="Academic">
  <div style="display:flex;align-items:center;justify-content:center;padding:4rem 2rem;text-align:center">
    <div>
      <div class="spinner" style="margin:0 auto 1rem"></div>
      <h1 id="hub-title" style="font-family:var(--font-display);font-weight:700;font-size:1.3rem;color:var(--text);margin-bottom:.35rem">Redirigiendo...</h1>
      <p id="hub-sub" style="font-size:.8rem;color:var(--text-tertiary)">Portal Soleísta</p>
    </div>
  </div>
</Layout>
<script>
  (function () {
    try {
      var token = localStorage.getItem('access_token')
      if (!token) { window.location.href = '/login'; return }
      var role = (localStorage.getItem('userRole') || '').toUpperCase()
      var name = localStorage.getItem('userName') || ''
      var target = ''
      if (role === 'PROFESOR' || role === 'TEACHER') target = '/docente'
      else if (role === 'RECTOR' || role === 'ADMIN') target = '/admin'
      else target = '/estudiante'
      if (name) document.getElementById('hub-title').textContent = 'Bienvenido, ' + name
      document.getElementById('hub-sub').textContent = 'Redirigiendo a tu panel...'
      setTimeout(function () { window.location.href = target }, 800)
    } catch(e) {}
  })()
</script>
