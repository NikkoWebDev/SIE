---
import BaseLayout from '@layouts/BaseLayout.astro'

const baseUrl = (import.meta.env.PUBLIC_API_URL || 'http://localhost:8000').replace(/\/+$/, '')
const googleClientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID || ''
---

<BaseLayout titulo="Acceso" descripcion="Inicia sesión en VYNTRA Academic — Solaris" noIndex={true} withNoise={true}>
  <main class="flex min-h-screen bg-gradient-to-br from-solar-base via-solar-cream to-solar-50 dark:from-surface-dark dark:via-[#0F0C08] dark:to-[#0A0705]">
    <!-- LEFT: Brand Panel (hidden on mobile) -->
    <section class="hidden w-0 lg:flex lg:w-[45%] relative overflow-hidden items-center justify-center">
      <!-- Solar glow -->
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full bg-gradient-to-br from-brand-gold/10 via-brand-amber/5 to-transparent blur-[120px] animate-orb"></div>
      <div class="absolute inset-0" style="background-image:radial-gradient(var(--border) 1px,transparent 1px);background-size:32px 32px;mask-image:radial-gradient(ellipse 60% 50% at 50% 50%,black 25%,transparent 70%)"></div>

      <!-- Construction diagram -->
      <svg class="absolute top-10 right-10 w-72 h-72 opacity-[0.04] dark:opacity-[0.06]" viewBox="0 0 256 256">
        <circle cx="128" cy="128" r="110" fill="none" stroke="currentColor" stroke-width="0.5" class="text-brand-maroon dark:text-brand-gold"/>
        <circle cx="128" cy="128" r="75" fill="none" stroke="currentColor" stroke-width="0.5" class="text-brand-gold"/>
        <line x1="18" y1="128" x2="238" y2="128" stroke="currentColor" stroke-width="0.3" class="text-brand-maroon"/>
        <line x1="128" y1="18" x2="128" y2="238" stroke="currentColor" stroke-width="0.3" class="text-brand-maroon"/>
        <line x1="50" y1="50" x2="206" y2="206" stroke="currentColor" stroke-width="0.2" class="text-brand-gold"/>
        <line x1="206" y1="50" x2="50" y2="206" stroke="currentColor" stroke-width="0.2" class="text-brand-gold"/>
      </svg>

      <div class="relative z-10 max-w-md mx-auto px-10">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-maroon to-brand-maroon-dark text-white flex items-center justify-center text-lg font-extrabold mb-10">V</div>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-semibold uppercase tracking-widest bg-brand-maroon/10 dark:bg-brand-gold/10 text-brand-maroon dark:text-brand-gold-light border border-brand-maroon/10 dark:border-brand-gold/10 mb-4">Portal v5.0 Solaris</span>
        <h1 class="text-[clamp(2.5rem,5vw,4rem)] font-extrabold leading-[0.85] tracking-tight mb-3" style="font-family:'Fraunces',serif">
          <span class="bg-gradient-to-r from-brand-maroon to-brand-gold bg-clip-text text-transparent">VYNTRA</span><br/>
          <span>Solaris</span>
        </h1>
        <p class="text-sm tracking-[0.2em] uppercase text-text-secondary font-medium mb-6">Ciencia · Tecnología · Futuro</p>
        <p class="text-xs text-text-tertiary leading-relaxed mb-10">Plataforma educativa inteligente — Tecnología al servicio de la educación en Sogamoso, Boyacá.</p>
        <div class="flex items-center gap-3">
          <div class="w-8 h-0.5 bg-gradient-to-r from-brand-maroon to-brand-gold rounded"></div>
          <span class="text-[10px] uppercase tracking-[0.2em] text-text-tertiary font-semibold">Solar Engine</span>
        </div>
      </div>
      <div class="absolute bottom-6 left-10 text-[9px] uppercase tracking-[0.25em] text-text-tertiary opacity-40">v5.0 · vyntra_solaris · portal</div>
    </section>

    <!-- RIGHT: Login Panel -->
    <section class="w-full lg:w-[55%] flex items-center justify-center px-4 sm:px-8 py-8 relative overflow-hidden">
      <!-- Floating glow orbs -->
      <div class="absolute top-10 right-10 w-72 h-72 rounded-full bg-brand-gold/6 blur-[100px] animate-orb pointer-events-none"></div>
      <div class="absolute bottom-10 left-10 w-64 h-64 rounded-full bg-brand-maroon/5 blur-[80px] animate-orb pointer-events-none" style="animation-delay:-4s"></div>

      <div class="w-full max-w-[420px] relative z-10">
        <!-- Mobile brand -->
        <div class="lg:hidden text-center mb-8">
          <div class="w-10 h-10 mx-auto rounded-xl bg-gradient-to-br from-brand-maroon to-brand-maroon-dark text-white flex items-center justify-center text-base font-extrabold mb-3">V</div>
          <div class="font-bold text-lg tracking-tight" style="font-family:'Fraunces',serif">VYNTRA Solaris</div>
          <div class="text-[10px] text-text-tertiary uppercase tracking-widest mt-1">Academic · v5.0</div>
        </div>

        <div class="bg-white/60 dark:bg-surface-dark-elevated backdrop-blur-2xl border border-border rounded-2xl p-6 sm:p-8 shadow-card dark:shadow-card-dark animate-fade-up">
          <div class="text-center mb-6">
            <h2 class="text-xl font-bold tracking-tight mb-1" style="font-family:'Fraunces',serif">Iniciar Sesión</h2>
            <p class="text-xs text-text-tertiary">Bienvenido a VYNTRA</p>
          </div>

          <!-- Segmented control -->
          <div class="relative flex h-10 rounded-full bg-[var(--input-bg)] p-1 mb-6">
            <div id="tab-slider" class="absolute top-1 bottom-1 w-[calc(50%-4px)] bg-gradient-to-r from-brand-maroon to-brand-maroon-dark rounded-full transition-all duration-400 ease-spring z-0 left-1"></div>
            <button id="tab-estudiante" class="flex-1 relative z-10 flex items-center justify-center rounded-full text-xs font-semibold transition-colors duration-300 text-text" data-tab="estudiante">Estudiante</button>
            <button id="tab-personal" class="flex-1 relative z-10 flex items-center justify-center rounded-full text-xs font-semibold transition-colors duration-300 text-text-tertiary" data-tab="personal">Personal</button>
          </div>

          <form id="login-form" class="space-y-4" novalidate>
            <div>
              <label for="doc-id" class="block ml-1 text-[10px] font-semibold uppercase tracking-wider text-text-tertiary mb-1.5">Identificación Institucional</label>
              <div class="relative">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-text-tertiary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0"/></svg>
                <input id="doc-id" type="text" inputmode="numeric" autocomplete="username" placeholder="ID-000000" required
                  class="w-full bg-[var(--input-bg)] border border-[var(--input-border)] rounded-lg pl-9 pr-4 py-2.5 text-sm text-text placeholder:text-text-tertiary/50 outline-none transition-all duration-200 focus:border-brand-maroon dark:focus:border-brand-gold focus:shadow-[0_0_0_3px_var(--input-focus-ring)]" />
              </div>
            </div>

            <div id="password-group" class="transition-all duration-300 overflow-hidden" style="max-height:100px;opacity:1">
              <label for="password" class="block ml-1 text-[10px] font-semibold uppercase tracking-wider text-text-tertiary mb-1.5">Contraseña</label>
              <div class="relative">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                <input id="password" type="password" autocomplete="current-password" placeholder="••••••••"
                  class="w-full bg-[var(--input-bg)] border border-[var(--input-border)] rounded-lg pl-9 pr-4 py-2.5 text-sm text-text placeholder:text-text-tertiary/50 outline-none transition-all duration-200 focus:border-brand-maroon dark:focus:border-brand-gold focus:shadow-[0_0_0_3px_var(--input-focus-ring)]" />
              </div>
              <div class="flex justify-end mt-2">
                <button type="button" id="forgot-link" class="text-[10px] font-semibold text-brand-maroon/60 dark:text-brand-gold/60 hover:text-brand-maroon dark:hover:text-brand-gold transition-colors">¿Problemas de acceso?</button>
              </div>
            </div>

            <button id="login-submit" type="submit" class="w-full h-11 flex items-center justify-center gap-2 bg-gradient-to-r from-brand-maroon to-brand-maroon-dark text-white text-sm font-semibold rounded-lg hover:shadow-glow-maroon hover:-translate-y-0.5 transition-all duration-300 ease-spring active:scale-[0.97]">
              <span id="submit-text">Ingresar al Portal</span>
              <svg id="submit-spinner" class="hidden h-4 w-4 animate-spin-slow" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </button>

            <div id="login-error" class="hidden rounded-lg border border-brand-danger/20 bg-brand-danger/5 px-4 py-2.5 text-xs text-brand-danger text-center" role="alert"></div>
          </form>

          <div class="mt-6 pt-5 border-t border-border text-center space-y-1.5">
            <p class="text-[10px] text-text-tertiary">VYNTRA Solaris · Sogamoso, Boyacá</p>
            <div class="flex items-center justify-center gap-2 text-[10px] text-text-tertiary">
              <span class="h-1.5 w-1.5 rounded-full bg-success animate-pulse"></span>
              <span class="uppercase tracking-widest font-semibold">Sistema activo</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Forgot Password Modal -->
  <div id="forgot-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm">
    <div class="bg-white dark:bg-surface-dark-elevated border border-border rounded-2xl shadow-modal p-6 max-w-sm w-11/12 mx-auto animate-scale-in">
      <div id="forgot-step-1">
        <h3 class="font-bold text-base mb-1" style="font-family:'Fraunces',serif">Recuperar Acceso</h3>
        <p class="text-xs text-text-tertiary mb-4">Ingresa tu identificación para recibir un código de recuperación.</p>
        <input type="text" id="forgot-credential" placeholder="Identificación institucional" class="w-full bg-[var(--input-bg)] border border-[var(--input-border)] rounded-lg px-4 py-2.5 text-sm outline-none focus:border-brand-maroon dark:focus:border-brand-gold mb-3" />
        <button id="forgot-send-btn" class="w-full h-10 bg-gradient-to-r from-brand-maroon to-brand-maroon-dark text-white text-xs font-semibold rounded-lg">Enviar Código</button>
        <div id="forgot-step-1-error" class="hidden mt-2 text-xs text-brand-danger text-center"></div>
      </div>
      <div id="forgot-step-2" class="hidden">
        <h3 class="font-bold text-base mb-1" style="font-family:'Fraunces',serif">Nueva Contraseña</h3>
        <p class="text-xs text-text-tertiary mb-4">Ingresa el código y tu nueva contraseña.</p>
        <input type="text" id="forgot-code" placeholder="Código de 6 dígitos" maxlength="6" class="w-full bg-[var(--input-bg)] border border-[var(--input-border)] rounded-lg px-4 py-2.5 text-sm outline-none focus:border-brand-maroon dark:focus:border-brand-gold mb-3" />
        <input type="password" id="forgot-new-pass" placeholder="Nueva contraseña" class="w-full bg-[var(--input-bg)] border border-[var(--input-border)] rounded-lg px-4 py-2.5 text-sm outline-none focus:border-brand-maroon dark:focus:border-brand-gold mb-3" />
        <input type="password" id="forgot-confirm-pass" placeholder="Confirmar contraseña" class="w-full bg-[var(--input-bg)] border border-[var(--input-border)] rounded-lg px-4 py-2.5 text-sm outline-none focus:border-brand-maroon dark:focus:border-brand-gold mb-3" />
        <button id="forgot-reset-btn" class="w-full h-10 bg-gradient-to-r from-brand-maroon to-brand-maroon-dark text-white text-xs font-semibold rounded-lg">Restablecer</button>
        <div id="forgot-step-2-error" class="hidden mt-2 text-xs text-brand-danger text-center"></div>
        <div id="forgot-step-2-success" class="hidden mt-2 text-xs text-success text-center"></div>
      </div>
      <button class="mt-4 text-xs text-text-tertiary hover:text-text" onclick="document.getElementById('forgot-modal').classList.add('hidden');document.getElementById('forgot-modal').classList.remove('flex')">Cerrar</button>
    </div>
  </div>

  <style>
    .modal-overlay { display: flex; }
  </style>

  <script define:vars={{ baseUrl, googleClientId }}>
    (function() {
      var tabEst = document.getElementById('tab-estudiante')
      var tabPer = document.getElementById('tab-personal')
      var slider = document.getElementById('tab-slider')
      var form = document.getElementById('login-form')
      var docInput = document.getElementById('doc-id')
      var passwordInput = document.getElementById('password')
      var currentTab = 'estudiante'
      var endpoint = baseUrl + '/api/auth/login'

      function setTab(tab) {
        currentTab = tab
        slider.style.left = tab === 'estudiante' ? '4px' : 'calc(50% + 2px)'
        tabEst.style.color = tab === 'estudiante' ? 'var(--text)' : 'var(--text-tertiary)'
        tabPer.style.color = tab === 'personal' ? 'var(--text)' : 'var(--text-tertiary)'
      }
      tabEst.addEventListener('click', function() { setTab('estudiante') })
      tabPer.addEventListener('click', function() { setTab('personal') })

      form.addEventListener('submit', async function(e) {
        e.preventDefault()
        var errDiv = document.getElementById('login-error')
        var submitText = document.getElementById('submit-text')
        var spinner = document.getElementById('submit-spinner')
        errDiv.classList.add('hidden')
        submitText.textContent = 'Validando...'
        spinner.classList.remove('hidden')

        var docId = docInput.value.trim()
        var password = passwordInput.value
        if (!docId) { showErr('Ingresa tu identificación institucional.'); return }
        if (!password) { showErr('Ingresa tu contraseña.'); return }

        try {
          var res = await fetch(endpoint, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ login_credential:docId, password:password }) })
          if (!res.ok) {
            var ed = await res.json().catch(function(){return{}})
            throw new Error(res.status === 401 ? 'Credenciales inválidas.' : (ed.mensaje || ed.detail || ed.error || 'Error.'))
          }
          var data = await res.json()
          var token = data.access_token || data.token || ''
          var usuario = data.usuario || {}
          var role = (usuario.rol || data.rol || currentTab).toUpperCase()
          localStorage.setItem('access_token', token)
          localStorage.setItem('userRole', role)
          localStorage.setItem('userName', usuario.nombre || data.nombre || data.fullname || '')
          localStorage.setItem('userId', usuario.profile_id || usuario.login_credential || docId)
          if (usuario.profile_id) localStorage.setItem('profile_id', usuario.profile_id)
          if (data.grado || data.grade) localStorage.setItem('userGrade', data.grado || data.grade)
          if (data.refresh_token) localStorage.setItem('refresh_token', data.refresh_token)

          submitText.textContent = '¡Bienvenido!'
          var map = { ADMIN:'/admin', RECTOR:'/admin', PROFESOR:'/docente', DOCENTE:'/docente', ESTUDIANTE:'/estudiante', STUDENT:'/estudiante', TEACHER:'/docente' }
          window.location.href = map[role] || '/dashboard'
        } catch(err) {
          showErr(err.message || 'Error de conexión.')
        }

        function showErr(msg) {
          errDiv.textContent = msg
          errDiv.classList.remove('hidden')
          submitText.textContent = 'Ingresar al Portal'
          spinner.classList.add('hidden')
        }
      })

      // Forgot password logic
      var forgotModal = document.getElementById('forgot-modal')
      document.getElementById('forgot-link')?.addEventListener('click', function() {
        forgotModal.classList.add('flex'); forgotModal.classList.remove('hidden')
        document.getElementById('forgot-step-1').style.display = 'block'
        document.getElementById('forgot-step-2').style.display = 'none'
      })
      forgotModal?.addEventListener('click', function(e) { if (e.target === this) { this.classList.add('hidden'); this.classList.remove('flex') } })

      document.getElementById('forgot-send-btn')?.addEventListener('click', async function() {
        var cred = document.getElementById('forgot-credential').value.trim()
        if (!cred) { document.getElementById('forgot-step-1-error').textContent = 'Ingresa tu identificación.'; document.getElementById('forgot-step-1-error').classList.remove('hidden'); return }
        try {
          var res = await fetch(baseUrl + '/api/auth/forgot-password', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ login_credential:cred }) })
          var data = await res.json()
          if (!res.ok) throw new Error(data.detail || 'Error')
          document.getElementById('forgot-step-1').style.display = 'none'
          document.getElementById('forgot-step-2').style.display = 'block'
        } catch(err) {
          document.getElementById('forgot-step-1-error').textContent = err.message
          document.getElementById('forgot-step-1-error').classList.remove('hidden')
        }
      })

      document.getElementById('forgot-reset-btn')?.addEventListener('click', async function() {
        var code = document.getElementById('forgot-code').value.trim()
        var p1 = document.getElementById('forgot-new-pass').value
        var p2 = document.getElementById('forgot-confirm-pass').value
        if (!code || code.length !== 6) { showErr2('Código inválido'); return }
        if (!p1 || p1.length < 4) { showErr2('Contraseña muy corta'); return }
        if (p1 !== p2) { showErr2('No coinciden'); return }
        try {
          var res = await fetch(baseUrl + '/api/auth/reset-password', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ login_credential:document.getElementById('forgot-credential').value, code:code, new_password:p1 }) })
          var data = await res.json()
          if (!res.ok) throw new Error(data.detail || 'Error')
          document.getElementById('forgot-step-2-success').textContent = 'Contraseña actualizada. Ya puedes iniciar sesión.'
          document.getElementById('forgot-step-2-success').classList.remove('hidden')
          setTimeout(function() { forgotModal.classList.add('hidden'); forgotModal.classList.remove('flex') }, 2500)
        } catch(err) { showErr2(err.message) }
        function showErr2(m) {
          document.getElementById('forgot-step-2-error').textContent = m
          document.getElementById('forgot-step-2-error').classList.remove('hidden')
        }
      })

      // Wake-up ping
      try { fetch(baseUrl + '/api/health', { method:'GET', priority:'low' }).catch(function(){}) } catch(e) {}

      // Icon glow on input focus
      ;[docInput, passwordInput].forEach(function(inp) {
        inp?.addEventListener('focus', function() {
          this.parentElement.querySelector('svg').style.color = 'var(--brand-maroon)'
        })
        inp?.addEventListener('blur', function() {
          this.parentElement.querySelector('svg').style.color = ''
        })
      })
    })()
  </script>
</BaseLayout>
