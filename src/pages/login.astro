---
import BaseLayout from '@layouts/BaseLayout.astro'
import Logo from '@components/Logo.astro'

const baseUrl = (import.meta.env.PUBLIC_API_URL || 'http://localhost:8000').replace(/\/+$/, '')
---

<BaseLayout titulo="Acceso" descripcion="Portal VYNTRA Solaris — Iniciar Sesión" noIndex={true} withNoise={false}>
  <main class="min-h-[100svh] flex items-center justify-center bg-[#0A0505] px-4 py-12">
    <!-- Glow sutil detrás del logo -->
    <div class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] h-[350px] rounded-full bg-brand-gold/[0.04] blur-[100px] pointer-events-none"></div>

    <div class="relative z-10 w-full max-w-[360px]">
      <!-- Logo — la joya central -->
      <div class="flex justify-center mb-6">
        <div class="relative">
          <div class="absolute inset-0 rounded-full bg-brand-gold/[0.08] blur-[35px] scale-110"></div>
          <Logo size={130} class="relative drop-shadow-[0_0_35px_rgba(245,166,35,0.2)]" />
        </div>
      </div>

      <!-- Marca -->
      <div class="text-center mb-7">
        <h1 class="text-2xl font-bold text-white/80 tracking-tight" style="font-family:'Fraunces',serif">
          VYNTRA <span class="text-brand-gold">Solaris</span>
        </h1>
        <p class="text-[10px] text-white/15 tracking-[0.25em] uppercase mt-2 font-medium">Portal Académico &middot; v5.0</p>
      </div>

      <!-- Formulario -->
      <div class="bg-white/[0.02] border border-white/[0.05] rounded-2xl p-6 sm:p-7">
        <form id="login-form" class="space-y-4">
          <!-- ID -->
          <div>
            <label for="credential" class="block ml-1 text-[10px] font-semibold uppercase tracking-wider text-white/20 mb-1.5">
              Identificación Institucional
            </label>
            <div class="relative group">
              <div class="absolute inset-0 rounded-lg bg-gradient-to-r from-brand-gold/0 via-brand-gold/6 to-brand-gold/0 opacity-0 group-focus-within:opacity-100 transition-opacity duration-500 -m-[1px] pointer-events-none"></div>
              <input
                id="credential"
                type="text"
                autocomplete="username"
                placeholder="ID institucional"
                required
                class="relative w-full bg-white/[0.02] border border-white/[0.05] rounded-lg px-3.5 py-2.5 text-sm text-white/75 placeholder:text-white/10 outline-none transition-all duration-300 focus:border-brand-gold/25 focus:bg-white/[0.04]"
              />
            </div>
          </div>

          <!-- Password -->
          <div>
            <label for="password" class="block ml-1 text-[10px] font-semibold uppercase tracking-wider text-white/20 mb-1.5">
              Contraseña
            </label>
            <div class="relative group">
              <div class="absolute inset-0 rounded-lg bg-gradient-to-r from-brand-gold/0 via-brand-gold/6 to-brand-gold/0 opacity-0 group-focus-within:opacity-100 transition-opacity duration-500 -m-[1px] pointer-events-none"></div>
              <input
                id="password"
                type="password"
                autocomplete="current-password"
                placeholder="••••••••"
                required
                class="relative w-full bg-white/[0.02] border border-white/[0.05] rounded-lg px-3.5 py-2.5 text-sm text-white/75 placeholder:text-white/10 outline-none transition-all duration-300 focus:border-brand-gold/25 focus:bg-white/[0.04]"
              />
            </div>
          </div>

          <!-- Submit -->
          <button
            id="login-submit"
            type="submit"
            class="relative w-full h-11 flex items-center justify-center gap-2 bg-gradient-to-r from-brand-gold to-brand-amber text-[#0A0505] text-sm font-bold rounded-lg hover:shadow-[0_0_40px_rgba(245,166,35,0.25)] hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 mt-1"
          >
            <span id="submit-text">Ingresar al Portal</span>
            <svg id="submit-arrow" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            <svg id="submit-spinner" class="hidden h-4 w-4 animate-spin-slow" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
          </button>

          <!-- Error -->
          <div id="login-error" class="hidden rounded-lg border border-red-500/[0.08] bg-red-500/[0.03] px-4 py-2.5 text-xs text-red-400/80 text-center" role="alert"></div>
        </form>

        <!-- Footer del form -->
        <div class="mt-5 pt-4 border-t border-white/[0.04] text-center space-y-2">
          <button id="forgot-link" class="text-[10px] text-brand-gold/25 hover:text-brand-gold/50 transition-colors duration-300">
            ¿Problemas de acceso? Recuperar cuenta
          </button>
        </div>
      </div>

      <!-- Info institucional -->
      <p class="text-center mt-6 text-[9px] text-white/6">
        Colegio Técnico Ciudad del Sol · Sogamoso, Boyacá
      </p>
    </div>
  </main>

  <!-- Modal Recuperar Contraseña -->
  <div id="forgot-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="Recuperar acceso">
    <div class="bg-[#120808] border border-white/[0.05] rounded-2xl p-6 max-w-sm w-11/12 mx-auto shadow-[0_0_80px_rgba(0,0,0,0.4)]">
      <div id="forgot-step-1">
        <h3 class="font-bold text-white/80 mb-1" style="font-family:'Fraunces',serif">Recuperar Acceso</h3>
        <p class="text-xs text-white/25 mb-4">Ingresa tu identificación para recibir un código.</p>
        <input type="text" id="forgot-credential" placeholder="Identificación institucional" class="w-full bg-white/[0.02] border border-white/[0.05] rounded-lg px-3.5 py-2.5 text-sm text-white/75 placeholder:text-white/10 outline-none focus:border-brand-gold/25 mb-3 transition-all duration-300" />
        <button id="forgot-send-btn" class="w-full h-10 bg-gradient-to-r from-brand-gold to-brand-amber text-[#0A0505] text-xs font-semibold rounded-lg hover:shadow-[0_0_25px_rgba(245,166,35,0.15)] transition-all duration-300">Enviar Código</button>
        <div id="forgot-step-1-error" class="hidden mt-2 text-xs text-red-400 text-center" role="alert"></div>
      </div>
      <div id="forgot-step-2" class="hidden">
        <h3 class="font-bold text-white/80 mb-1" style="font-family:'Fraunces',serif">Restablecer Contraseña</h3>
        <p class="text-xs text-white/25 mb-4">Ingresa el código y tu nueva contraseña.</p>
        <input type="text" id="forgot-code" placeholder="Código de 6 dígitos" maxlength="6" class="w-full bg-white/[0.02] border border-white/[0.05] rounded-lg px-3.5 py-2.5 text-sm text-white/75 placeholder:text-white/10 outline-none focus:border-brand-gold/25 mb-3 transition-all duration-300" />
        <input type="password" id="forgot-new-pass" placeholder="Nueva contraseña" class="w-full bg-white/[0.02] border border-white/[0.05] rounded-lg px-3.5 py-2.5 text-sm text-white/75 placeholder:text-white/10 outline-none focus:border-brand-gold/25 mb-3 transition-all duration-300" />
        <input type="password" id="forgot-confirm-pass" placeholder="Confirmar contraseña" class="w-full bg-white/[0.02] border border-white/[0.05] rounded-lg px-3.5 py-2.5 text-sm text-white/75 placeholder:text-white/10 outline-none focus:border-brand-gold/25 mb-3 transition-all duration-300" />
        <button id="forgot-reset-btn" class="w-full h-10 bg-gradient-to-r from-brand-gold to-brand-amber text-[#0A0505] text-xs font-semibold rounded-lg hover:shadow-[0_0_25px_rgba(245,166,35,0.15)] transition-all duration-300">Restablecer</button>
        <div id="forgot-step-2-error" class="hidden mt-2 text-xs text-red-400 text-center" role="alert"></div>
        <div id="forgot-step-2-success" class="hidden mt-2 text-xs text-green-400 text-center" role="status"></div>
      </div>
      <button class="mt-4 w-full text-xs text-white/12 hover:text-white/30 transition-colors py-1" onclick="document.getElementById('forgot-modal').classList.add('hidden');document.getElementById('forgot-modal').classList.remove('flex')">Cerrar</button>
    </div>
  </div>

  <script define:vars={{ baseUrl }}>
    (function() {
      var form = document.getElementById('login-form')
      var credInput = document.getElementById('credential')
      var passInput = document.getElementById('password')
      var endpoint = baseUrl + '/api/auth/login'

      form.addEventListener('submit', async function(e) {
        e.preventDefault()
        var errDiv = document.getElementById('login-error')
        var submitText = document.getElementById('submit-text')
        var spinner = document.getElementById('submit-spinner')
        var arrow = document.getElementById('submit-arrow')

        errDiv.classList.add('hidden')
        submitText.textContent = 'Validando...'
        arrow.classList.add('hidden')
        spinner.classList.remove('hidden')

        var cred = credInput.value.trim()
        var pass = passInput.value

        if (!cred) { reset(); showErr('Ingresa tu identificación institucional.'); return }
        if (!pass) { reset(); showErr('Ingresa tu contraseña.'); return }

        try {
          var res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ login_credential: cred, password: pass })
          })

          if (!res.ok) {
            var ed = await res.json().catch(function() { return {} })
            throw new Error(res.status === 401 ? 'Credenciales inválidas.' : (ed.mensaje || ed.detail || 'Error de conexión.'))
          }

          var data = await res.json()
          var usuario = data.usuario || {}
          var role = (usuario.rol || data.rol || 'ESTUDIANTE').toUpperCase()

          if (data.access_token) localStorage.setItem('ws_access_token', data.access_token)
          localStorage.setItem('userRole', role)
          localStorage.setItem('userName', usuario.nombre || data.nombre || data.fullname || '')
          localStorage.setItem('userId', usuario.profile_id || usuario.login_credential || cred)
          if (usuario.profile_id) localStorage.setItem('profile_id', usuario.profile_id)
          if (data.grado || data.grade) localStorage.setItem('userGrade', data.grado || data.grade)

          submitText.textContent = '¡Bienvenido!'
          var map = { ADMIN:'/admin', RECTOR:'/admin', PROFESOR:'/docente', DOCENTE:'/docente', ESTUDIANTE:'/estudiante', STUDENT:'/estudiante', TEACHER:'/docente' }
          window.location.href = map[role] || '/dashboard'
        } catch(err) {
          reset()
          showErr(err.message || 'Error de conexión.')
        }

        function reset() {
          submitText.textContent = 'Ingresar al Portal'
          arrow.classList.remove('hidden')
          spinner.classList.add('hidden')
        }
        function showErr(msg) {
          errDiv.textContent = msg
          errDiv.classList.remove('hidden')
        }
      })

      // ── Forgot password ──
      var forgotModal = document.getElementById('forgot-modal')
      document.getElementById('forgot-link')?.addEventListener('click', function() {
        forgotModal.classList.add('flex')
        forgotModal.classList.remove('hidden')
        document.getElementById('forgot-step-1').style.display = 'block'
        document.getElementById('forgot-step-2').style.display = 'none'
        var e1 = document.getElementById('forgot-step-1-error')
        var e2 = document.getElementById('forgot-step-2-error')
        var s2 = document.getElementById('forgot-step-2-success')
        if (e1) e1.classList.add('hidden')
        if (e2) e2.classList.add('hidden')
        if (s2) s2.classList.add('hidden')
      })
      forgotModal?.addEventListener('click', function(e) {
        if (e.target === this) { this.classList.add('hidden'); this.classList.remove('flex') }
      })

      document.getElementById('forgot-send-btn')?.addEventListener('click', async function() {
        var c = document.getElementById('forgot-credential').value.trim()
        var e1 = document.getElementById('forgot-step-1-error')
        if (!c) { e1.textContent = 'Ingresa tu identificación.'; e1.classList.remove('hidden'); return }
        try {
          var r = await fetch(baseUrl + '/api/auth/forgot-password', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ login_credential: c })
          })
          var d = await r.json()
          if (!r.ok) throw new Error(d.detail || 'Error al enviar código.')
          document.getElementById('forgot-step-1').style.display = 'none'
          document.getElementById('forgot-step-2').style.display = 'block'
        } catch(er) { e1.textContent = er.message; e1.classList.remove('hidden') }
      })

      document.getElementById('forgot-reset-btn')?.addEventListener('click', async function() {
        var code = document.getElementById('forgot-code').value.trim()
        var p1 = document.getElementById('forgot-new-pass').value
        var p2 = document.getElementById('forgot-confirm-pass').value
        if (!code || code.length !== 6) { showErr2('Código inválido (6 dígitos).'); return }
        if (!p1 || p1.length < 4) { showErr2('Contraseña muy corta.'); return }
        if (p1 !== p2) { showErr2('No coinciden.'); return }
        try {
          var r = await fetch(baseUrl + '/api/auth/reset-password', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              login_credential: document.getElementById('forgot-credential').value,
              code: code, new_password: p1
            })
          })
          var d = await r.json()
          if (!r.ok) throw new Error(d.detail || 'Error al restablecer.')
          var s = document.getElementById('forgot-step-2-success')
          s.textContent = 'Contraseña actualizada. Ya puedes iniciar sesión.'
          s.classList.remove('hidden')
          setTimeout(function() { forgotModal.classList.add('hidden'); forgotModal.classList.remove('flex') }, 2500)
        } catch(er) { showErr2(er.message) }
        function showErr2(m) {
          var e2 = document.getElementById('forgot-step-2-error')
          e2.textContent = m; e2.classList.remove('hidden')
        }
      })

      // Wake-up ping
      fetch(baseUrl + '/api/health', { method: 'GET', mode: 'no-cors', signal: AbortSignal.timeout(5000) }).catch(function(){})
    })()
  </script>
</BaseLayout>
