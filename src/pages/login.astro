---
import '../styles/theme.css'
const baseUrl = (import.meta.env.PUBLIC_API_URL || 'http://localhost:8000').replace(/\/+$/, '')
---

<!doctype html>
<html lang="es-CO">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>VYNTRA · Acceso</title>
  <meta name="description" content="Inicia sesión en VYNTRA Academic" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href="https://colegiociudaddelsol.edu.co/login" />
  <meta property="og:title" content="VYNTRA · Acceso" />
  <meta property="og:description" content="Inicia sesión en VYNTRA Academic" />
  <meta property="og:url" content="https://colegiociudaddelsol.edu.co/login" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700;800&family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <script>
    import * as Sentry from '@sentry/browser'
    var dsn = import.meta.env.PUBLIC_SENTRY_DSN || ''
    if (dsn) { Sentry.init({ dsn, environment: import.meta.env.PUBLIC_ENV || 'development', tracesSampleRate: 0.25 }) }
  </script>
  <script is:inline>
    (function(){try{var t=localStorage.getItem('vyntra-theme');if(t==='dark'||(!t&&window.matchMedia('(prefers-color-scheme:dark)').matches))document.documentElement.classList.add('dark')}catch(e){}})();
  </script>
</head>
<body>
  <div class="noise-fixed"></div>
  <main style="display:flex;min-height:100vh;width:100%">
    <!-- LEFT: Brand panel (hidden mobile) -->
    <section style="display:none" class="login-brand">
      <div class="grid-dots" style="position:absolute;inset:0"></div>
      <div class="hero-orb"></div>
      <div style="position:relative;z-index:2;padding:4rem">
        <div style="width:56px;height:56px;border-radius:var(--radius-lg);background:var(--maroon);color:white;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:1.3rem;margin-bottom:3rem">V</div>
        <span class="badge badge-maroon" style="margin-bottom:1rem">Portal VYNTRA v5.0</span>
        <h1 style="font-family:var(--font-display);font-weight:800;font-size:clamp(2.5rem,4vw,3.5rem);line-height:.9;letter-spacing:-.03em;color:var(--text);margin-bottom:.5rem">
          <span style="color:var(--maroon)">VYNTRA</span><br/>Academic
        </h1>
        <p style="font-size:clamp(.9rem,1.5vw,1.1rem);color:var(--text-secondary);letter-spacing:.15em;text-transform:uppercase;font-weight:500;margin-bottom:1.5rem">Ciencia · Tecnología · Futuro</p>
        <p style="color:var(--text-tertiary);font-size:.85rem;line-height:1.6;max-width:380px;margin-bottom:3rem">Plataforma Educativa VYNTRA — Tecnología al servicio de la educación en Sogamoso, Boyacá.</p>
        <div style="display:flex;align-items:center;gap:1rem">
          <div style="width:40px;height:2px;background:var(--maroon);border-radius:1px"></div>
          <span style="font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.15em;color:var(--text-tertiary)">Tecnología Educativa</span>
        </div>
      </div>
      <div style="position:absolute;bottom:2rem;left:4rem;font-size:.6rem;font-weight:600;text-transform:uppercase;letter-spacing:.2em;color:var(--text-tertiary);opacity:.5">v5.0 // vyntra_engine_active // academic_portal</div>
    </section>

    <!-- RIGHT: Login panel -->
    <section class="login-panel">
      <div class="glow-orb-maroon"></div>
      <div class="glow-orb-gold"></div>

      <div style="width:100%;max-width:400px;position:relative;z-index:2">
        <!-- Mobile brand -->
        <div class="show-mobile" style="text-align:center;margin-bottom:2rem">
          <div style="width:48px;height:48px;border-radius:var(--radius-md);background:var(--maroon);color:white;display:inline-flex;align-items:center;justify-content:center;font-weight:800;font-size:1.1rem;margin-bottom:.75rem">V</div>
          <div style="font-family:var(--font-display);font-weight:700;font-size:1.3rem;color:var(--text)">VYNTRA Academic</div>
        </div>

        <div class="card-float" style="padding:2rem">
          <div style="text-align:center;margin-bottom:1.5rem">
            <h2 style="font-family:var(--font-display);font-weight:700;font-size:1.5rem;color:var(--text);margin-bottom:.25rem">Iniciar Sesión</h2>
            <p style="color:var(--text-tertiary);font-size:.8rem">Bienvenido a VYNTRA</p>
          </div>

          <!-- Segmented control -->
          <div class="segmented-control" id="tab-container">
            <div class="segmented-slider" id="tab-slider" style="left:4px"></div>
            <button id="tab-estudiante" class="tab-btn-segment" style="color:var(--text)" data-tab="estudiante">Estudiante</button>
            <button id="tab-personal" class="tab-btn-segment" style="color:var(--text-tertiary)" data-tab="personal">Personal</button>
          </div>

          <!-- Form -->
          <form id="login-form" style="margin-top:1.5rem;display:flex;flex-direction:column;gap:1rem" novalidate>
            <div style="display:flex;flex-direction:column;gap:.35rem">
              <label for="doc-id" class="label-caps">Identificación Institucional</label>
              <div style="position:relative">
                <svg class="input-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"/></svg>
                <input id="doc-id" type="text" inputmode="numeric" autocomplete="username" placeholder="ID-000000" required class="input-apple" style="padding-left:2.75rem" />
              </div>
            </div>
            <div id="password-group" style="display:flex;flex-direction:column;gap:.35rem;transition:all .35s var(--ease-out);overflow:hidden;max-height:100px;opacity:1">
              <label for="password" class="label-caps">Contraseña</label>
              <div style="position:relative">
                <svg class="input-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                <input id="password" type="password" autocomplete="current-password" placeholder="••••••••" class="input-apple" style="padding-left:2.75rem" />
              </div>
            </div>
            <div style="display:flex;justify-content:flex-end">
              <span class="forgot-link">¿Problemas de acceso?</span>
            </div>
            <button id="login-submit" type="submit" class="btn-apple btn-primary" style="width:100%;height:3rem;font-size:.85rem">
              <span id="submit-text">Ingresar al Portal</span>
              <svg id="submit-spinner" class="hidden h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
              </svg>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </button>
            <div id="login-error" style="border-radius:var(--radius-md);border:1px solid rgba(186,26,26,.15);background:rgba(186,26,26,.04);padding:.65rem .85rem;font-size:.8rem;color:var(--red);text-align:center;display:none" role="alert"></div>
          </form>

          <div style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid var(--border);display:flex;flex-direction:column;align-items:center;gap:.5rem">
            <p style="font-size:.65rem;color:var(--text-tertiary)">VYNTRA Academic · Sogamoso, Boyacá</p>
            <div style="display:flex;align-items:center;gap:.5rem">
              <span class="pulse-dot"></span>
              <span style="font-size:.6rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--text-tertiary)">Servidores en línea</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <style>
    .login-brand{width:45%;background:var(--bg);position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:center}
    @media(min-width:1024px){.login-brand{display:flex}}
    .login-panel{width:100%;display:flex;align-items:center;justify-content:center;padding:2rem;position:relative;overflow:hidden;background:var(--bg-secondary)}
    @media(min-width:1024px){.login-panel{width:55%}}
    .hero-orb{position:absolute;width:50vmin;height:50vmin;left:50%;top:50%;transform:translate(-50%,-50%);background:radial-gradient(circle,rgba(128,0,0,.06) 0%,rgba(253,192,3,.03) 30%,transparent 60%)}
    .glow-orb-maroon{position:absolute;top:20%;right:-10%;width:300px;height:300px;border-radius:50%;background:var(--glow-maroon);filter:blur(100px);pointer-events:none}
    .glow-orb-gold{position:absolute;bottom:10%;left:-5%;width:200px;height:200px;border-radius:50%;background:var(--glow-gold);filter:blur(80px);pointer-events:none}
    .segmented-control{position:relative;display:flex;height:2.5rem;border-radius:var(--radius-full);background:var(--input-bg);padding:4px}
    .segmented-slider{position:absolute;top:4px;bottom:4px;width:calc(50% - 4px);background:var(--maroon);border-radius:var(--radius-full);transition:left .4s cubic-bezier(.34,1.56,.64,1);z-index:0}
    .tab-btn-segment{flex:1;position:relative;z-index:1;display:flex;align-items:center;justify-content:center;border-radius:var(--radius-full);cursor:pointer;border:none;background:none;font-size:.8rem;font-weight:600;font-family:inherit;transition:color .3s ease}
    .input-icon{position:absolute;left:.85rem;top:50%;transform:translateY(-50%);width:1.1rem;height:1.1rem;color:var(--text-tertiary);transition:color .3s ease;pointer-events:none}
    .label-caps{display:block;margin-left:.15rem;font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em;color:var(--text-tertiary)}
    .forgot-link{font-size:.7rem;font-weight:600;color:var(--maroon);opacity:.6;transition:opacity .2s ease}
    .forgot-link:hover{opacity:1}
    .hidden{display:none!important}
    @keyframes spin{to{transform:rotate(360deg)}}
    .animate-spin{animation:spin .7s linear infinite}
    @media(max-width:480px){.login-panel{padding:1rem}}
    @media(max-width:380px){.login-panel{padding:.75rem}.card-float{padding:1.25rem!important}}
  </style>

  <script define:vars={{ baseUrl }}>
    (function () {
      var tabEst = document.getElementById('tab-estudiante')
      var tabPer = document.getElementById('tab-personal')
      var slider = document.getElementById('tab-slider')
      var passwordGroup = document.getElementById('password-group')
      var passwordInput = document.getElementById('password')
      var form = document.getElementById('login-form')
      var docInput = document.getElementById('doc-id')
      var submitBtn = document.getElementById('login-submit')
      var submitText = document.getElementById('submit-text')
      var submitSpinner = document.getElementById('submit-spinner')
      var errorDiv = document.getElementById('login-error')
      var currentTab = 'estudiante'
      var endpoint = baseUrl + '/api/auth/login'

      ;(function wakeUp() {
        try { fetch(baseUrl + '/api/health', { method:'GET', priority:'low' }).catch(function(){}) } catch(e){}
      })()

      function setTab(tab) {
        currentTab = tab
        slider.style.left = tab === 'estudiante' ? '4px' : 'calc(50% + 4px)'
        passwordGroup.style.maxHeight = '100px'
        passwordGroup.style.opacity = '1'
        passwordInput.required = true
        tabEst.style.color = tab === 'estudiante' ? 'var(--text)' : 'var(--text-tertiary)'
        tabPer.style.color = tab === 'personal' ? 'var(--text)' : 'var(--text-tertiary)'
      }
      tabEst.addEventListener('click', function () { setTab('estudiante') })
      tabPer.addEventListener('click', function () { setTab('personal') })

      function setupInputGlow(input) {
        var icon = input.parentElement.querySelector('.input-icon')
        if (!icon) return
        input.addEventListener('focus', function () { icon.style.color = 'var(--maroon)' })
        input.addEventListener('blur', function () { icon.style.color = '' })
      }
      setupInputGlow(docInput)
      setupInputGlow(passwordInput)

      form.addEventListener('submit', async function (e) {
        e.preventDefault()
        errorDiv.style.display = 'none'
        errorDiv.textContent = ''
        submitText.textContent = 'Validando...'
        submitSpinner.classList.remove('hidden')
        submitBtn.disabled = true

        var docId = docInput.value.trim()
        var password = passwordInput.value

        if (!docId) { showError('Ingresa tu identificación institucional.'); return }
        if (!password) { showError('Ingresa tu contraseña.'); return }

        var controller = new AbortController()
        var timeoutId = setTimeout(function () { controller.abort() }, 25000)

        try {
          var res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ login_credential: docId, password: password }),
            signal: controller.signal,
          })
          clearTimeout(timeoutId)
          if (!res.ok) {
            var errData
            try { errData = await res.json() } catch(e) { errData = {} }
            if (res.status === 401) throw new Error('Credenciales inválidas.')
            throw new Error(errData.mensaje || errData.detail || errData.error || 'Error de autenticación.')
          }
          var data = await res.json()
          var token = data.access_token || data.token || ''
          var usuario = data.usuario || {}
          var role = (usuario.rol || data.rol || currentTab).toUpperCase()
          localStorage.setItem('access_token', token)
          localStorage.setItem('userRole', role)
          localStorage.setItem('userName', usuario.nombre || data.nombre || data.fullname || '')
          localStorage.setItem('userId', usuario.profile_id || usuario.login_credential || docId)
          localStorage.setItem('profile_id', usuario.profile_id || '')
          localStorage.setItem('is_paid', String(data.is_paid !== false))
          if (data.grado || data.grade) localStorage.setItem('userGrade', data.grado || data.grade)
          if (data.refresh_token) localStorage.setItem('refresh_token', data.refresh_token)
          submitText.textContent = '¡Bienvenido!'
          var map = { ADMIN:'/admin', RECTOR:'/admin', PROFESOR:'/docente', DOCENTE:'/docente', ESTUDIANTE:'/estudiante', STUDENT:'/estudiante', TEACHER:'/docente' }
          window.location.href = map[role] || '/dashboard'
        } catch (err) {
          clearTimeout(timeoutId)
          if (err.name === 'AbortError') showError('El servidor está iniciando. Reintenta en unos segundos.')
          else showError(err.message || 'Error de conexión.')
        }

        function showError(msg) {
          errorDiv.textContent = msg
          errorDiv.style.display = 'block'
          submitText.textContent = 'Ingresar al Portal'
          submitSpinner.classList.add('hidden')
          submitBtn.disabled = false
        }
      })
    })()
  </script>
</body>
</html>
