---
import BaseLayout from '@layouts/BaseLayout.astro'
import DashboardShell from '@components/layout/DashboardShell.astro'
import AIChat from '@components/AIChat.astro'
import ChatFull from '@components/ChatFull.astro'

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000'
---

<BaseLayout titulo="Panel Docente" descripcion="Panel docente VYNTRA — Control de notas y alertas académicas" noIndex={true} withNoise={true}>
<DashboardShell role="teacher" activeSection="inicio" pageTitle="Panel Docente" pageSubtitle="Control de notas y alertas">
  <AIChat role="teacher" />

  <div class="space-y-5">
    <!-- INICIO / DASHBOARD -->
    <section id="sec-inicio" class="section-active space-y-5">
      <div class="solar-card bg-white/40 dark:bg-surface-dark-card border border-border rounded-xl p-5">
        <h2 class="font-bold text-sm mb-1" style="font-family:'Fraunces',serif">Bienvenido, <span id="teacher-name">Docente</span></h2>
        <p class="text-xs text-text-secondary" id="teacher-subjects">Cargando materias...</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
        {[
          { id:'stat-students', label:'Estudiantes', value:'--' },
          { id:'stat-subjects', label:'Materias', value:'--' },
          { id:'stat-risk', label:'En Riesgo', value:'0' },
          { id:'stat-recent', label:'Notas Recientes', value:'0' },
        ].map(s => (
          <div class="solar-card solar-card-hover bg-white/40 dark:bg-surface-dark-card border border-border rounded-xl p-4 text-center transition-all hover:-translate-y-1 hover:shadow-card-hover dark:hover:shadow-card-dark-hover">
            <div class="text-2xl sm:text-3xl font-extrabold text-brand-maroon dark:text-brand-gold" id={s.id} style="font-family:'Fraunces',serif">{s.value}</div>
            <div class="text-[10px] uppercase tracking-wider text-text-tertiary mt-1 font-semibold">{s.label}</div>
          </div>
        ))}
      </div>
      <div class="solar-card bg-white/40 dark:bg-surface-dark-card border border-border rounded-xl p-5">
        <h3 class="font-bold text-sm mb-3">Últimas Calificaciones</h3>
        <div id="recent-grades-list" class="text-xs text-text-tertiary">No hay calificaciones recientes.</div>
      </div>
    </section>

    <!-- CONTROL DE NOTAS -->
    <section id="sec-notas" class="space-y-5">
      <div class="solar-card bg-white/40 dark:bg-surface-dark-card border border-border rounded-xl p-5">
        <div class="flex flex-wrap justify-between items-center gap-3 mb-4">
          <h2 class="font-bold text-sm" style="font-family:'Fraunces',serif">Planilla de Calificaciones</h2>
          <button class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-solar-100 dark:bg-surface-dark-card border border-border hover:bg-solar-200 transition-colors" onclick="exportGradesPDF()">Exportar PDF</button>
        </div>
        <div class="flex flex-wrap gap-3 mb-4">
          <select id="filter-grade-notas" class="flex-1 min-w-[140px] bg-[var(--input-bg)] border border-[var(--input-border)] rounded-lg px-4 py-2.5 text-sm outline-none focus:border-brand-maroon"><option value="">Grado...</option></select>
          <select id="filter-subject-notas" class="flex-1 min-w-[140px] bg-[var(--input-bg)] border border-[var(--input-border)] rounded-lg px-4 py-2.5 text-sm outline-none focus:border-brand-maroon"><option value="">Primero elija grado</option></select>
        </div>
        <div class="overflow-x-auto -mx-5 sm:mx-0">
          <table class="w-full text-xs min-w-[650px]">
            <thead><tr class="text-[10px] uppercase tracking-wider text-text-tertiary font-semibold">
              <th scope="col" class="text-left p-2 border-b border-border">Estudiante</th>
              <th scope="col" class="text-center p-2 border-b border-border w-14">P1</th><th scope="col" class="text-center p-2 border-b border-border w-14">P2</th>
              <th scope="col" class="text-center p-2 border-b border-border w-14">P3</th><th scope="col" class="text-center p-2 border-b border-border w-14">P4</th>
              <th scope="col" class="text-center p-2 border-b border-border w-16">Prom.</th><th scope="col" class="text-left p-2 border-b border-border">Obs.</th><th scope="col" class="text-center p-2 border-b border-border w-12"></th>
            </tr></thead>
            <tbody id="grades-tbody"><tr><td colspan="8" class="text-center py-8 text-text-tertiary">Selecciona grado y materia</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- GUIAS Y TAREAS -->
    <section id="sec-contenidos" class="space-y-5">
      <div class="solar-card bg-white/40 dark:bg-surface-dark-card border border-border rounded-xl p-5">
        <h2 class="font-bold text-sm mb-4" style="font-family:'Fraunces',serif">Publicar Guía o Recurso</h2>
        <div class="grid sm:grid-cols-2 gap-3 mb-3">
          <input id="guide-title" placeholder="Título de la guía" class="w-full bg-[var(--input-bg)] border border-[var(--input-border)] rounded-lg px-4 py-2.5 text-sm outline-none focus:border-brand-maroon">
          <select id="guide-subject" class="w-full bg-[var(--input-bg)] border border-[var(--input-border)] rounded-lg px-4 py-2.5 text-sm outline-none focus:border-brand-maroon"><option value="">Materia...</option></select>
        </div>
        <div id="guide-drop-zone" class="border-2 border-dashed border-border rounded-xl p-8 text-center cursor-pointer hover:border-brand-maroon hover:bg-brand-maroon/3 mb-3">
          <div class="text-2xl mb-2">&#x1F4C4;</div>
          <p class="text-sm font-medium text-text-secondary">Arrastra un PDF o haz clic</p>
          <input type="file" id="guide-file" accept=".pdf" class="hidden">
        </div>
        <div id="guide-preview" class="mb-3"></div>
        <button class="w-full py-3 bg-gradient-to-r from-brand-maroon to-brand-maroon-dark text-white text-sm font-semibold rounded-xl" onclick="uploadGuide()">Publicar Guía</button>
      </div>
      <div class="solar-card bg-white/40 dark:bg-surface-dark-card border border-border rounded-xl p-5">
        <h3 class="font-bold text-sm mb-3">Guías Publicadas</h3>
        <div id="guides-list" class="text-xs text-text-tertiary">Cargando...</div>
      </div>
      <div class="solar-card bg-white/40 dark:bg-surface-dark-card border border-border rounded-xl p-5">
        <h3 class="font-bold text-sm mb-3">Buzón de Tareas</h3>
        <div id="tasks-list" class="text-xs text-text-tertiary">Cargando...</div>
      </div>
    </section>

    <!-- EXAMENES -->
    <section id="sec-examenes" class="space-y-5">
      <div class="solar-card bg-white/40 dark:bg-surface-dark-card border border-border rounded-xl p-5">
        <h2 class="font-bold text-sm mb-4" style="font-family:'Fraunces',serif">Generar Examen</h2>
        <div class="grid sm:grid-cols-2 gap-3 mb-3">
          <input id="exam-title-input" placeholder="Título del examen" class="w-full bg-[var(--input-bg)] border border-[var(--input-border)] rounded-lg px-4 py-2.5 text-sm outline-none focus:border-brand-maroon">
          <select id="exam-grade" class="w-full bg-[var(--input-bg)] border border-[var(--input-border)] rounded-lg px-4 py-2.5 text-sm outline-none focus:border-brand-maroon"><option value="">Grado...</option></select>
          <select id="exam-subject" class="w-full bg-[var(--input-bg)] border border-[var(--input-border)] rounded-lg px-4 py-2.5 text-sm outline-none focus:border-brand-maroon"><option value="">Materia...</option></select>
        </div>
        <div id="questions-area" class="mb-3"></div>
        <div class="flex gap-3">
          <button class="flex-1 py-2.5 rounded-lg text-xs font-semibold bg-solar-100 dark:bg-surface-dark-card border border-border hover:bg-solar-200 transition-colors" onclick="addQuestion()">+ Añadir Pregunta</button>
          <button class="flex-1 py-2.5 rounded-lg text-xs font-semibold bg-gradient-to-r from-brand-maroon to-brand-maroon-dark text-white" onclick="saveExam()">Publicar Examen</button>
        </div>
      </div>
      <div class="solar-card bg-white/40 dark:bg-surface-dark-card border border-border rounded-xl p-5">
        <h3 class="font-bold text-sm mb-3">Mis Exámenes</h3>
        <div id="my-exams-list" class="text-xs text-text-tertiary">Cargando...</div>
      </div>
    </section>

    <!-- HORARIO -->
    <section id="sec-horario" class="space-y-5">
      <div class="solar-card bg-white/40 dark:bg-surface-dark-card border border-border rounded-xl p-5">
        <h2 class="font-bold text-sm mb-4" style="font-family:'Fraunces',serif">Horario Semanal</h2>
        <p class="text-xs text-text-secondary mb-4" id="teacher-schedule-grade">Grado: --</p>
        <div class="overflow-x-auto"><div id="teacher-schedule-body" class="min-w-[680px] text-xs text-text-tertiary">Cargando...</div></div>
      </div>
    </section>

    <!-- INCIDENTES -->
    <section id="sec-incidentes" class="space-y-5">
      <div class="solar-card bg-white/40 dark:bg-surface-dark-card border border-border rounded-xl p-5">
        <div class="flex flex-wrap justify-between items-center gap-3 mb-4">
          <h2 class="font-bold text-sm" style="font-family:'Fraunces',serif">Seguridad en Exámenes</h2>
          <span class="px-2 py-0.5 rounded-full bg-brand-danger/10 text-brand-danger text-[10px] font-semibold uppercase">Monitor activo</span>
        </div>
        <div class="overflow-x-auto -mx-5 sm:mx-0">
          <table class="w-full text-xs min-w-[550px]">
            <thead><tr class="text-[10px] uppercase tracking-wider text-text-tertiary font-semibold">
              <th class="text-left p-2 border-b border-border">Estudiante</th><th class="text-left p-2 border-b border-border">Examen</th>
              <th class="text-center p-2 border-b border-border w-16">Strikes</th><th class="text-left p-2 border-b border-border">Motivo</th>
            </tr></thead>
            <tbody id="incidents-tbody"><tr><td colspan="5" class="text-center py-8 text-text-tertiary">Cargando incidentes...</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ALERTAS -->
    <section id="sec-alertas" class="space-y-5">
      <div class="solar-card bg-white/40 dark:bg-surface-dark-card border border-border rounded-xl p-5">
        <h2 class="font-bold text-sm mb-4" style="font-family:'Fraunces',serif">Alertas de Riesgo Académico</h2>
        <div id="risk-alerts-list" class="space-y-3">
          <div class="skeleton-shimmer h-16 rounded-xl"></div>
          <div class="skeleton-shimmer h-16 rounded-xl"></div>
        </div>
      </div>
    </section>

    <section id="sec-chats" class="space-y-5" style="height:calc(100vh - 12rem)">
      <ChatFull role="teacher" />
    </section>
  </div>
</DashboardShell>
</BaseLayout>

<script define:vars={{ apiUrl }}>
  (function () {
    var API = apiUrl
    var role = (localStorage.getItem('userRole')||'').toUpperCase()
    if (!role) { window.VyntraToast?.error('Sesión no encontrada.'); setTimeout(function(){ window.location.href='/login' },1500); return }
    if (!['PROFESOR','TEACHER','DOCENTE'].includes(role)) { window.location.href = '/'; return }
    var userId = localStorage.getItem('profile_id') || localStorage.getItem('userId')
    var userName = localStorage.getItem('userName') || 'Docente'

    document.getElementById('teacher-name').textContent = userName
    var sbName = document.getElementById('sidebar-username-teacher'); if (sbName) sbName.textContent = userName
    var sbMeta = document.getElementById('sidebar-metadata-teacher'); if (sbMeta) sbMeta.textContent = 'Docente'

    var sectionTitles = { inicio:'Panel Docente', notas:'Control de Notas', contenidos:'Guías y Tareas', examenes:'Exámenes', horario:'Horario Semanal', incidentes:'Incidentes de Seguridad', alertas:'Alertas de Riesgo', chats:'Chats por Materia' }
    var sectionSubs = { inicio:'Vista general', notas:'Registrar calificaciones', contenidos:'Subir guías y revisar entregas', examenes:'Crear y publicar evaluaciones', horario:'Clases programadas', incidentes:'Monitoreo de seguridad', alertas:'Estudiantes con rendimiento crítico', chats:'Conversaciones por materia con el Asistente' }
    function staggerCards(section) {
      var cards = section.querySelectorAll('.solar-card')
      cards.forEach(function(card, i) {
        card.style.animationDelay = (i * 0.04) + 's'
        card.classList.add('card-stagger')
      })
    }

    window.showSection = function(id) {
      document.querySelectorAll('[id^="sec-"]').forEach(function(s){ s.style.display = 'none'; s.classList.remove('section-enter') })
      var sec = document.getElementById('sec-' + id)
      if (sec) { sec.style.display = ''; sec.classList.remove('hidden'); sec.classList.add('section-enter'); staggerCards(sec) }
      var t = document.querySelector('.topbar-heading'), p = document.querySelector('.topbar-subtitle')
      if (t) t.textContent = sectionTitles[id] || id
      if (p) p.textContent = sectionSubs[id] || ''
      window.dispatchEvent(new CustomEvent('vyntra:navigate', { detail: { section: id } }))
      if (id === 'contenidos') { loadGuides(); loadTasks() }
      if (id === 'examenes') loadMyExams()
      if (id === 'incidentes') loadIncidents()
    }

    async function loadData() {
      try {
        var [gradesRes, riskRes] = await Promise.all([
          vfetch(API, '/api/grades?teacher_id='+userId),
          vfetch(API, '/api/students/risk').catch(function(){return null})
        ])
        if (gradesRes && gradesRes.ok) {
          var data = await gradesRes.json()
          var grades = Array.isArray(data) ? data : []
          var students = new Set(), subjSet = new Set()
          grades.forEach(function(g) {
            if (g.student_name) students.add(g.student_name)
            if (g.subject_name) subjSet.add(g.subject_name)
          })
          document.getElementById('stat-students').textContent = students.size || '--'
          document.getElementById('stat-subjects').textContent = subjSet.size || '--'
          document.getElementById('stat-recent').textContent = grades.length || 0
          document.getElementById('teacher-subjects').textContent = Array.from(subjSet).join(', ') || 'Sin materias asignadas'
          if (sbMeta) sbMeta.textContent = subjSet.size + ' materias'
          document.getElementById('recent-grades-list').innerHTML = grades.slice(-10).reverse().map(function(g) {
            return '<div class="flex justify-between items-center py-2.5 border-b border-border last:border-0">'+
              '<div><strong class="text-xs">'+window.escapeHtml(g.student_name)+'</strong><span class="text-[11px] text-text-tertiary"> · '+window.escapeHtml(g.subject_name)+'</span></div>'+
              '<span class="font-bold text-xs '+(g.score>=3.5?'text-success':'text-brand-danger')+'">'+window.formatNum(g.score,1)+'</span></div>'
          }).join('') || 'No hay calificaciones recientes.'
        }
        if (riskRes && riskRes.ok) {
          var riskData = await riskRes.json()
          var riskStudents = riskData.students || riskData || []
          document.getElementById('stat-risk').textContent = riskStudents.length || 0
          var riskList = document.getElementById('risk-alerts-list')
          riskList.innerHTML = riskStudents.length ? riskStudents.map(function(s) {
            return '<div class="flex justify-between items-center p-3 bg-white/40 dark:bg-surface-dark-card border border-border rounded-xl border-l-3 border-l-brand-danger">'+
              '<div><div class="text-xs font-medium">'+window.escapeHtml(s.fullname||s.student_name)+'</div><div class="text-[10px] text-text-tertiary">Promedio: '+window.formatNum(s.avg_score,1)+'</div></div>'+
              '<span class="px-2 py-0.5 rounded-full bg-brand-danger/10 text-brand-danger text-[10px] font-semibold">En riesgo</span></div>'
          }).join('') : '<div class="text-center py-4 text-success text-xs">No hay estudiantes en riesgo</div>'
        }
        try {
          var schedRes = await vfetch(API, '/api/teacher/schedule?teacher_id='+userId)
          if (schedRes && schedRes.ok) {
            var sched = await schedRes.json()
            document.getElementById('teacher-schedule-grade').textContent = 'Grado: ' + (sched.grado || sched.grade_name || 'No asignado')
            var tbody = document.getElementById('teacher-schedule-body')
            if (sched.days && sched.hours) {
              var weekdays = ['lunes','martes','miércoles','jueves','viernes']
              var hours = Array.isArray(sched.hours) ? sched.hours : (typeof sched.hours === 'string' ? JSON.parse(sched.hours||'[]') : [])
              tbody.innerHTML = '<table class="w-full text-xs"><thead><tr class="text-[10px] text-text-tertiary"><th class="p-2 border-b border-border w-16">Hora</th>'+
                weekdays.map(function(d){return'<th class="p-2 text-center border-b border-border">'+d.charAt(0).toUpperCase()+d.slice(1)+'</th>'}).join('')+'</tr></thead><tbody>'+
                hours.map(function(h,hi){
                  return '<tr><td class="p-2 text-text-tertiary font-medium">'+(h.time||h.hour||('H'+(hi+1)))+'</td>'+
                    weekdays.map(function(d){return'<td class="p-2 text-center border border-border/50">'+(sched.days[d]&&sched.days[d][hi]?'<div class="font-semibold">'+window.escapeHtml(sched.days[d][hi].subject)+'</div>':'<span class="opacity-20">---</span>')+'</td>'}).join('')+'</tr>'
                }).join('')+'</tbody></table>'
            }
          }
        } catch(e) { console.error('[docente] schedule load:', e) }
      } catch(e) { window.VyntraToast?.error('Error cargando datos del panel'); console.error('[docente] loadData:', e) }
    }

    function loadGradesSheet() {
      var val = document.getElementById('filter-subject-notas').value
      if (!val) return
      var parts = val.split('|'), subject = parts[0], grade = parts[1]
      var tbody = document.getElementById('grades-tbody')
      vfetch(API, '/api/admin/students').then(function(r){return r.json()}).then(function(students) {
        var filtered = (Array.isArray(students) ? students : []).filter(function(s){ return (s.grade||s.grado)==grade })
        tbody.innerHTML = filtered.map(function(s){
          return '<tr>'+
            '<td class="font-semibold p-2 border-b border-border text-xs">'+window.escapeHtml(s.fullname)+'</td>'+
            ['P1','P2','P3','P4'].map(function(){return '<td class="p-1 text-center border-b border-border"><input type="number" class="w-full text-center bg-[var(--input-bg)] border border-[var(--input-border)] rounded px-2 py-1 text-xs min-w-[50px]" min="0" max="5" step="0.1" placeholder="0.0" oninput="calcAvg(this)"></td>'}).join('')+
            '<td class="text-center font-bold text-xs p-2 border-b border-border avg-cell text-brand-gold">0.00</td>'+
            '<td class="p-1 border-b border-border"><input class="w-full bg-[var(--input-bg)] border border-[var(--input-border)] rounded px-2 py-1 text-xs" placeholder="Obs."></td>'+
            '<td class="text-center p-1 border-b border-border"><button class="px-2 py-1 rounded text-xs bg-brand-maroon text-white" onclick="saveGradeRow(\''+window.escapeHtml(s.document_id||s._id)+'\',\''+subject.replace(/'/g,"\\'")+'\',this)">Guardar</button></td></tr>'
        }).join('') || '<tr><td colspan="8" class="text-center py-8 text-text-tertiary">Sin estudiantes en este grado</td></tr>'
      })
    }

    window.calcAvg = function(input) {
      var row = input.closest('tr')
      var notes = row.querySelectorAll('input[type="number"]')
      var vals = Array.from(notes).map(function(i){ return parseFloat(i.value)||0 })
      var avg = (vals.reduce(function(a,b){return a+b},0)/vals.length).toFixed(2)
      var cell = row.querySelector('.avg-cell')
      if (cell) { cell.textContent = avg; cell.style.color = parseFloat(avg)<3?'var(--brand-danger)':'var(--success)' }
    }

    window.saveGradeRow = async function(studentId, subject, btn) {
      var row = btn.closest('tr')
      var inputs = row.querySelectorAll('input[type="number"]')
      var avg = row.querySelector('.avg-cell')
      var obs = row.querySelector('td:nth-child(7) input')
      try {
        await vfetch(API, '/api/teacher/submit-grade', {
          method:'POST',
          body:JSON.stringify({
            student_id:String(studentId),subject:String(subject),
            p1:inputs[0]?.value||'0',p2:inputs[1]?.value||'0',p3:inputs[2]?.value||'0',p4:inputs[3]?.value||'0',
            final_grade:window.formatNum(avg?.textContent,1),observations:obs?.value||'',
            teacher_id:userId
          })
        })
        btn.textContent = '✓'; btn.classList.add('bg-success')
        Array.from(inputs).forEach(function(i){ i.disabled = true })
      } catch(e) { window.VyntraToast?.error('Error al guardar calificación: ' + (e?.message || 'Reintente')) }
    }

    window.exportGradesPDF = function() { window.VyntraToast?.info('Exportación PDF no disponible aún') }

    window.uploadGuide = async function() {
      var title = document.getElementById('guide-title').value.trim()
      var subjectVal = document.getElementById('guide-subject').value
      var file = document.getElementById('guide-file').files[0]
      if (!title || !subjectVal || !file) { window.VyntraToast?.warning('Todos los campos son requeridos'); return }
      var parts = subjectVal.split('|'), subject=parts[0], grade=parts[1]
      var fd = new FormData()
      fd.append('title',title); fd.append('subject_name',subject); fd.append('grade',grade)
      fd.append('teacher_id',userId); fd.append('file',file)
      try {
        await fetch(API+'/api/teacher/guides', { method:'POST', credentials:'include', body:fd })
        window.VyntraToast?.success('Guía publicada')
        loadGuides(); loadTasks()
      } catch(e) { window.VyntraToast?.error('Error publicando guía: ' + (e?.message || 'Reintente')) }
    }

    async function loadGuides() {
      var list = document.getElementById('guides-list')
      if (!list) return
      try {
        var data = await vfetch(API, '/api/teacher/guides/'+userId).then(function(r){return r.json()})
        list.innerHTML = (Array.isArray(data)&&data.length) ? data.map(function(g){ return '<div class="flex justify-between p-2.5 border-b border-border"><div><strong class="text-xs">'+window.escapeHtml(g.title)+'</strong><br><span class="text-[10px] text-text-tertiary">'+window.escapeHtml(g.subject_name)+' · Grado '+window.escapeHtml(g.grade)+'</span></div>'+(g.file_url?'<a href="'+g.file_url+'" target="_blank" class="text-xs text-brand-maroon">Ver</a>':'')+'</div>' }).join('') : '<p class="py-4">No hay guías.</p>'
      } catch(e) { list.innerHTML = '<p class="py-4 text-text-tertiary">Error cargando guías. Intenta de nuevo.</p>'; console.error('[docente] loadGuides:', e) }
    }

    async function loadTasks() {
      var list = document.getElementById('tasks-list')
      if (!list) return
      try {
        var data = await vfetch(API, '/api/teacher/deliveries/'+userId).then(function(r){return r.json()})
        list.innerHTML = (Array.isArray(data)&&data.length) ? data.map(function(t){ return '<div class="flex justify-between p-2.5 border-b border-border"><div><strong class="text-xs">'+window.escapeHtml(t.student_name)+'</strong><br><span class="text-[10px] text-text-tertiary">'+window.escapeHtml(t.subject)+'</span></div>'+(t.file_url?'<a href="'+t.file_url+'" target="_blank" class="text-xs text-brand-maroon">Ver</a>':'')+'</div>' }).join('') : '<p class="py-4">Buzón vacío.</p>'
      } catch(e) { list.innerHTML = '<p class="py-4 text-text-tertiary">Error cargando entregas. Intenta de nuevo.</p>'; console.error('[docente] loadTasks:', e) }
    }

    window.addQuestion = function() {
      var area = document.getElementById('questions-area')
      var count = area.querySelectorAll('.q-card').length + 1
      var div = document.createElement('div')
      div.className = 'q-card border border-border rounded-xl p-4 mb-3'
      div.innerHTML = '<div class="flex justify-between mb-2"><strong class="text-xs">#'+count+'</strong><button class="text-brand-danger text-xs" onclick="this.closest(\'.q-card\').remove()">Eliminar</button></div>'+
        '<input class="w-full bg-[var(--input-bg)] border border-[var(--input-border)] rounded-lg px-3 py-2 text-xs mb-2" placeholder="Pregunta...">'+
        '<div class="grid grid-cols-2 gap-2 mb-2">'+['A','B','C','D'].map(function(l){return'<input class="w-full bg-[var(--input-bg)] border border-[var(--input-border)] rounded-lg px-3 py-2 text-xs" placeholder="'+(l==='A'?'Opción correcta':'Opción '+l)+'">'}).join('')+'</div>'+
        '<div class="flex items-center gap-2"><span class="text-[10px] text-text-tertiary uppercase">Correcta:</span><select class="bg-[var(--input-bg)] border border-[var(--input-border)] rounded px-2 py-1 text-xs">'+['A','B','C','D'].map(function(l){return'<option>'+l+'</option>'}).join('')+'</select></div>'
      area.appendChild(div)
    }

    window.saveExam = async function() {
      var title = document.getElementById('exam-title-input').value.trim()
      var subjectVal = document.getElementById('exam-subject').value
      var qCards = document.querySelectorAll('.q-card')
      if (!title || !subjectVal || !qCards.length) { window.VyntraToast?.warning('Título, materia y al menos una pregunta requeridos'); return }
      var questions = []
      qCards.forEach(function(card) {
        var inputs = card.querySelectorAll('input[type="text"]')
        var correct = card.querySelector('select').value
        questions.push({ text:inputs[0].value, options:{A:inputs[1].value,B:inputs[2].value,C:inputs[3].value,D:inputs[4].value}, correct:correct })
      })
      var parts = subjectVal.split('|'), subject=parts[0], grade=parts[1]
      try {
        await vfetch(API, '/api/teacher/exams', { method:'POST', body:JSON.stringify({ title,subject_name:subject,grade,teacher_id:userId,questions,duration_minutes:30 }) })
        window.VyntraToast?.success('Examen publicado')
        loadMyExams()
      } catch(e) { window.VyntraToast?.error('Error publicando examen: ' + (e?.message || 'Reintente')) }
    }

    async function loadMyExams() {
      var list = document.getElementById('my-exams-list')
      if (!list) return
      try {
        var data = await vfetch(API, '/api/teacher/exams/'+userId).then(function(r){return r.json()})
        list.innerHTML = (Array.isArray(data)&&data.length) ? data.map(function(e){ return '<div class="p-3 border border-border rounded-xl mb-2"><strong class="text-xs">'+window.escapeHtml(e.title)+'</strong><br><span class="text-[10px] text-text-tertiary">'+window.escapeHtml(e.subject_name)+' · '+(e.questions?e.questions.length:0)+' preguntas</span></div>' }).join('') : '<p class="py-4">No hay exámenes.</p>'
      } catch(e) { list.innerHTML = '<p class="py-4 text-text-tertiary">Error cargando exámenes. Intenta de nuevo.</p>'; console.error('[docente] loadMyExams:', e) }
    }

    async function loadIncidents() {
      var tbody = document.getElementById('incidents-tbody')
      if (!tbody) return
      try {
        var data = await vfetch(API, '/api/teacher/incidents').then(function(r){return r.json()})
        tbody.innerHTML = (Array.isArray(data)&&data.length) ? data.map(function(i){ return '<tr class="border-b border-border"><td class="p-2 text-xs">'+window.escapeHtml(i.student_name)+'</td><td class="p-2 text-xs">'+window.escapeHtml(i.exam_title)+'</td><td class="p-2 text-center"><span class="px-2 py-0.5 rounded-full text-[10px] font-semibold '+(i.strikes>=3?'bg-brand-danger/10 text-brand-danger':'bg-brand-gold/10 text-brand-gold')+'">'+i.strikes+'</span></td><td class="p-2 text-xs">'+window.escapeHtml(i.incident_type)+'</td></tr>' }).join('') : '<tr><td colspan="5" class="text-center py-8 text-text-tertiary">Sin incidentes registrados.</td></tr>'
      } catch(e) { tbody.innerHTML = '<tr><td colspan="5" class="text-center py-8 text-text-tertiary">Error cargando incidentes. Intenta de nuevo.</td></tr>'; console.error('[docente] loadIncidents:', e) }
    }

    loadData()

    function populateGradeSelects() {
      var grades = ['6-A','6-B','7-A','7-B','8-A','8-B','9-A','9-B','10-A','10-B','11-A','11-B']
      var selectors = ['filter-grade-notas','exam-grade']
      var html = '<option value="">Grado...</option>' + grades.map(function(g){return '<option value="'+g+'">'+g+'</option>'}).join('')
      selectors.forEach(function(id){ var el=document.getElementById(id); if(el) el.innerHTML = html })
    }

    function loadSubjectsForGrade(grade, targetId) {
      var target = document.getElementById(targetId)
      if (!target) return
      if (!grade) { target.innerHTML = '<option value="">Primero elija grado</option>'; return }
      target.innerHTML = '<option value="">Cargando...</option>'
      vfetch(API, '/api/subjects').then(function(r){return r.json()}).then(function(subjects) {
        var filtered = (Array.isArray(subjects) ? subjects : []).filter(function(s){ return s.grade === grade })
        target.innerHTML = '<option value="">Seleccione materia</option>' + filtered.map(function(s){
          return '<option value="'+s.name+'|'+s.grade+'">'+s.name+'</option>'
        }).join('') || '<option value="">Sin materias para este grado</option>'
        if (targetId === 'filter-subject-notas' && target.value) loadGradesSheet()
      }).catch(function(){
        target.innerHTML = '<option value="">Error al cargar materias</option>'
      })
    }

    function populateAllSubjects() {
      var target = document.getElementById('guide-subject')
      if (!target) return
      vfetch(API, '/api/subjects').then(function(r){return r.json()}).then(function(subjects) {
        var arr = Array.isArray(subjects) ? subjects : []
        target.innerHTML = '<option value="">Materia...</option>' + arr.map(function(s){
          return '<option value="'+s.name+'|'+s.grade+'">'+s.name+' ('+s.grade+')</option>'
        }).join('')
      }).catch(function(err){
        console.error('[docente] populateAllSubjects:', err)
        target.innerHTML = '<option value="">Error al cargar materias</option>'
      })
    }

    populateGradeSelects()
    populateAllSubjects()

    document.getElementById('filter-grade-notas')?.addEventListener('change', function() {
      loadSubjectsForGrade(this.value, 'filter-subject-notas')
    })
    document.getElementById('exam-grade')?.addEventListener('change', function() {
      loadSubjectsForGrade(this.value, 'exam-subject')
    })

    document.querySelectorAll('[id^="sec-"]').forEach(function(s) { if (s.id !== 'sec-inicio') s.style.display = 'none' })

    var guideDrop = document.getElementById('guide-drop-zone')
    var guideFile = document.getElementById('guide-file')
    if (guideDrop) {
      guideDrop.addEventListener('click', function(){ guideFile.click() })
      guideFile.addEventListener('change', function() {
        if (guideFile.files.length) document.getElementById('guide-preview').innerHTML = '<div class="text-xs bg-brand-maroon/5 rounded-lg px-3 py-2">'+window.escapeHtml(guideFile.files[0].name)+'</div>'
      })
    }
    document.getElementById('filter-grade-notas')?.addEventListener('change', function() { loadGradesSheet() })
    document.getElementById('filter-subject-notas')?.addEventListener('change', loadGradesSheet)
  })()
</script>
