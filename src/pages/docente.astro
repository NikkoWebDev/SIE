---
import SEOHead from '@components/SEOHead.astro'
import WsRiskAlert from '@components/WsRiskAlert.astro'
import AIChat from '@components/AIChat.astro'
const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://sie-8agt.onrender.com'
const wsUrl = apiUrl.replace(/^http/, 'ws')
---
<!doctype html>
<html lang="es-CO">
  <head>
    <SEOHead titulo="Panel Docente · C sol SIE" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400..800&family=Sora:wght@300..700&display=swap" rel="stylesheet">
    <style>
      :root {
        --alabaster: #F5F0EB; --crimson: #800000; --crimson-dark: #5C0000;
        --gold: #FDC003; --gold-light: #FEF1C0; --charcoal: #1A1A2E;
        --slate: #6B7280; --border-light: rgba(0,0,0,0.06);
        --shadow-card: 0 1px 3px rgba(0,0,0,0.04), 0 4px 12px rgba(0,0,0,0.04);
        --shadow-hover: 0 4px 12px rgba(0,0,0,0.06), 0 12px 32px rgba(0,0,0,0.06);
      }
      *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
      html{font-family:'Sora',sans-serif;-webkit-font-smoothing:antialiased}
      body{background:var(--alabaster);color:var(--charcoal);min-height:100vh;display:flex}
      ::selection{background:var(--crimson);color:#fff}
      ::-webkit-scrollbar{width:5px}
      ::-webkit-scrollbar-track{background:transparent}
      ::-webkit-scrollbar-thumb{background:rgba(128,0,0,0.15);border-radius:3px}
      .teacher-layout{display:flex;width:100%;min-height:100vh}
      .teacher-sidebar{position:fixed;left:0;top:0;bottom:0;width:240px;background:#fff;border-right:1px solid var(--border-light);display:flex;flex-direction:column;z-index:40}
      .teacher-sidebar-header{padding:1.25rem 1.25rem 0.75rem;border-bottom:1px solid var(--border-light)}
      .teacher-sidebar-brand{display:flex;align-items:center;gap:0.625rem;font-family:'Syne',sans-serif}
      .teacher-sidebar-brand .logo-mark{width:2rem;height:2rem;border-radius:0.5rem;background:var(--crimson);color:var(--gold);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:1rem}
      .teacher-sidebar-brand .brand-name{font-weight:700;font-size:0.9rem;color:var(--charcoal)}
      .teacher-sidebar-brand .brand-sub{font-size:0.65rem;color:var(--slate);text-transform:uppercase;letter-spacing:0.08em}
      .teacher-sidebar-nav{flex:1;padding:0.75rem 0.5rem;overflow-y:auto}
      .teacher-sidebar-nav .nav-section{margin-bottom:1.5rem}
      .teacher-sidebar-nav .nav-label{padding:0 0.75rem;margin-bottom:0.375rem;font-size:0.65rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--slate)}
      .teacher-sidebar-nav a{display:flex;align-items:center;gap:0.625rem;padding:0.5rem 0.75rem;border-radius:0.5rem;font-size:0.8125rem;font-weight:500;color:var(--slate);text-decoration:none;transition:all 0.15s ease}
      .teacher-sidebar-nav a:hover,.teacher-sidebar-nav a.active{background:rgba(128,0,0,0.06);color:var(--crimson)}
      .teacher-sidebar-nav a.active{font-weight:600}
      .teacher-sidebar-nav a svg{width:1.125rem;height:1.125rem;flex-shrink:0}
      .teacher-sidebar-footer{padding:0.75rem;border-top:1px solid var(--border-light)}
      .teacher-sidebar-footer .user-badge{display:flex;align-items:center;gap:0.5rem;padding:0.5rem 0.625rem;border-radius:0.5rem;background:rgba(128,0,0,0.04)}
      .teacher-sidebar-footer .user-badge .avatar{width:1.75rem;height:1.75rem;border-radius:50%;background:var(--crimson);color:var(--gold);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.75rem}
      .teacher-sidebar-footer .user-badge .info{flex:1;min-width:0}
      .teacher-sidebar-footer .user-badge .name{font-size:0.75rem;font-weight:600;color:var(--charcoal)}
      .teacher-sidebar-footer .user-badge .role{font-size:0.625rem;color:var(--slate)}
      .teacher-main{margin-left:240px;flex:1;min-height:100vh;display:flex;flex-direction:column}
      .teacher-topbar{position:sticky;top:0;z-index:30;background:rgba(245,240,235,0.85);backdrop-filter:blur(12px);border-bottom:1px solid var(--border-light);display:flex;align-items:center;justify-content:space-between;padding:0.75rem 1.5rem}
      .teacher-topbar .page-title h1{font-family:'Syne',sans-serif;font-size:1.125rem;font-weight:700;color:var(--charcoal)}
      .teacher-topbar .page-title p{font-size:0.75rem;color:var(--slate);margin-top:0.125rem}
      .teacher-topbar .topbar-actions{display:flex;align-items:center;gap:0.75rem}
      .teacher-topbar .topbar-actions .status-pill{display:flex;align-items:center;gap:0.375rem;padding:0.25rem 0.75rem;border-radius:999px;background:rgba(76,175,80,0.1);color:#2E7D32;font-size:0.6875rem;font-weight:600}
      .teacher-topbar .topbar-actions .status-pill .dot{width:0.375rem;height:0.375rem;border-radius:50%;background:#4CAF50;animation:pulse 2s infinite}
      .teacher-content{padding:1.5rem;flex:1}
      .stat-card{background:#fff;border-radius:0.75rem;padding:1rem 1.25rem;box-shadow:var(--shadow-card);border:1px solid var(--border-light)}
      .stat-card .stat-label{font-size:0.6875rem;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--slate);margin-bottom:0.25rem}
      .stat-card .stat-value{font-family:'Syne',sans-serif;font-size:1.5rem;font-weight:700;color:var(--charcoal);line-height:1.2}
      .stat-card .stat-footer{font-size:0.6875rem;color:var(--slate);margin-top:0.25rem}
      .module-card{background:#fff;border-radius:0.75rem;box-shadow:var(--shadow-card);border:1px solid var(--border-light);overflow:hidden}
      .module-card:hover{box-shadow:var(--shadow-hover)}
      .module-card-header{display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;border-bottom:1px solid var(--border-light)}
      .module-card-header .module-title{display:flex;align-items:center;gap:0.625rem;font-family:'Syne',sans-serif;font-size:0.9375rem;font-weight:700;color:var(--charcoal)}
      .module-card-header .module-title .icon-wrap{width:1.75rem;height:1.75rem;border-radius:0.375rem;display:flex;align-items:center;justify-content:center;flex-shrink:0}
      .module-card-header .module-title .icon-wrap.crimson{background:rgba(128,0,0,0.1);color:var(--crimson)}
      .module-card-header .module-title .icon-wrap.amber{background:rgba(253,192,3,0.15);color:#B8860B}
      .module-card-header .module-title .icon-wrap.emerald{background:rgba(76,175,80,0.1);color:#2E7D32}
      .module-card-body{padding:1.25rem}
      .btn{display:inline-flex;align-items:center;gap:0.375rem;padding:0.5rem 1rem;border-radius:0.5rem;font-size:0.75rem;font-weight:600;border:none;cursor:pointer;transition:all 0.15s ease;text-decoration:none;font-family:'Sora',sans-serif}
      .btn-crimson{background:var(--crimson);color:#fff}
      .btn-crimson:hover{background:var(--crimson-dark)}
      .btn-ghost{background:transparent;color:var(--slate);border:1px solid var(--border-light)}
      .btn-ghost:hover{background:rgba(128,0,0,0.04);color:var(--crimson);border-color:rgba(128,0,0,0.15)}
      .btn-sm{padding:0.25rem 0.625rem;font-size:0.6875rem}
      .btn-gold{background:var(--gold);color:var(--charcoal)}
      .btn-gold:hover{background:#E5AC02}
      .btn:disabled{opacity:0.5;cursor:not-allowed}
      .input-field{width:100%;padding:0.5rem 0.75rem;border-radius:0.5rem;border:1px solid var(--border-light);font-size:0.8125rem;font-family:'Sora',sans-serif;background:#fff;color:var(--charcoal);outline:none;transition:border 0.15s ease}
      .input-field:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(253,192,3,0.15)}
      .input-field::placeholder{color:#B0B0B0}
      select.input-field{cursor:pointer;appearance:auto}
      .incident-table{width:100%;border-collapse:collapse;font-size:0.8125rem}
      .incident-table thead th{text-align:left;padding:0.5rem 0.75rem;font-size:0.6875rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--slate);border-bottom:2px solid var(--border-light)}
      .incident-table tbody td{padding:0.625rem 0.75rem;border-bottom:1px solid var(--border-light);color:var(--charcoal);vertical-align:middle}
      .incident-table tbody tr:last-child td{border-bottom:none}
      .incident-table tbody tr:hover{background:rgba(128,0,0,0.02)}
      .status-badge{display:inline-flex;align-items:center;gap:0.375rem;padding:0.125rem 0.5rem;border-radius:999px;font-size:0.6875rem;font-weight:600}
      .status-badge.interrupted{background:rgba(186,26,26,0.08);color:#BA1A1A}
      .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:0.75rem}
      .form-grid .full{grid-column:1/-1}
      .propagation-banner{display:flex;align-items:center;gap:0.5rem;padding:0.625rem 0.875rem;border-radius:0.5rem;background:rgba(128,0,0,0.05);border:1px solid rgba(128,0,0,0.12);font-size:0.75rem;font-weight:500;color:var(--crimson)}
      .ai-result-box{padding:0.75rem 1rem;border-radius:0.5rem;background:rgba(253,192,3,0.06);border:1px solid rgba(253,192,3,0.15);font-size:0.8125rem;line-height:1.6;color:var(--charcoal);display:none}

      .drop-zone{border:2px dashed var(--border-light);border-radius:0.75rem;padding:2rem;text-align:center;cursor:pointer;transition:all 0.15s ease;background:#fff}
      .drop-zone:hover,.drop-zone.dragover{border-color:var(--crimson);background:rgba(128,0,0,0.02)}
      .drop-zone .dz-icon{width:2.5rem;height:2.5rem;margin:0 auto 0.5rem;color:var(--slate)}
      .drop-zone .dz-text{font-size:0.8125rem;color:var(--slate);font-weight:500}
      .drop-zone .dz-hint{font-size:0.6875rem;color:var(--slate);margin-top:0.25rem}
      .drop-zone.has-file{border-color:var(--crimson);background:rgba(128,0,0,0.03)}
      .drop-zone.has-file .dz-text{color:var(--crimson);font-weight:600}
      .upload-progress{display:none;margin-top:0.75rem;padding:0.75rem;border-radius:0.5rem;background:rgba(128,0,0,0.04);font-size:0.75rem;color:var(--crimson);text-align:center}
      .upload-progress.active{display:block}
      .upload-progress.success{background:rgba(76,175,80,0.08);color:#2E7D32}
      .upload-progress.error{background:rgba(186,26,26,0.08);color:#BA1A1A}

      .heat-grid{display:grid;grid-template-columns:auto repeat(9,1fr);gap:0.25rem;font-size:0.6875rem;overflow-x:auto}
      .heat-grid .hg-header{padding:0.25rem 0.5rem;font-weight:700;color:var(--slate);text-transform:uppercase;letter-spacing:0.04em;text-align:center}
      .heat-grid .hg-label{padding:0.25rem 0.5rem;font-weight:600;color:var(--charcoal);white-space:nowrap;display:flex;align-items:center}
      .heat-grid .hg-cell{width:100%;aspect-ratio:1;border-radius:0.25rem;display:flex;align-items:center;justify-content:center;font-size:0.625rem;font-weight:700;transition:transform 0.15s ease}
      .heat-grid .hg-cell:hover{transform:scale(1.15);z-index:1}
      .heat-grid .hg-cell.oro{background:rgba(253,192,3,0.3);color:#B8860B}
      .heat-grid .hg-cell.plata{background:rgba(156,163,175,0.3);color:#4B5563}
      .heat-grid .hg-cell.bronce{background:rgba(205,127,50,0.2);color:#8B5E3C}
      .heat-grid .hg-cell.vacio{background:rgba(0,0,0,0.03)}
      .heat-legend{display:flex;gap:1rem;margin-top:0.75rem;font-size:0.6875rem;color:var(--slate)}
      .heat-legend span{display:flex;align-items:center;gap:0.25rem}
      .heat-legend .dot{width:0.625rem;height:0.625rem;border-radius:0.125rem;display:inline-block}

      .ws-toast{position:fixed;top:1rem;right:1rem;z-index:999;max-width:22rem;background:var(--crimson);color:#fff;border-radius:0.75rem;padding:1rem 1.25rem;box-shadow:0 8px 24px rgba(128,0,0,0.25);transform:translateX(120%);transition:transform 0.35s var(--ease-out-expo, ease);display:flex;flex-direction:column;gap:0.5rem}
      .ws-toast.open{transform:translateX(0)}
      .ws-toast .t-title{font-size:0.8125rem;font-weight:700}
      .ws-toast .t-body{font-size:0.75rem;opacity:0.9}
      .ws-toast .t-btn{display:inline-flex;align-items:center;gap:0.375rem;padding:0.375rem 0.75rem;border-radius:0.375rem;background:rgba(255,255,255,0.15);color:#fff;font-size:0.6875rem;font-weight:600;border:none;cursor:pointer;align-self:flex-end;transition:background 0.15s ease}
      .ws-toast .t-btn:hover{background:rgba(255,255,255,0.25)}

      .sidebar-overlay{display:none}
      .sidebar-toggle{display:none}
      @media(max-width:768px){
        .teacher-sidebar{transform:translateX(-100%);transition:transform 0.3s ease}
        .teacher-sidebar.open{transform:translateX(0)}
        .teacher-main{margin-left:0}
        .sidebar-overlay{display:block;position:fixed;inset:0;z-index:35;background:rgba(0,0,0,0.3);opacity:0;pointer-events:none;transition:opacity 0.3s ease}
        .sidebar-overlay.open{opacity:1;pointer-events:auto}
        .sidebar-toggle{display:flex}
        .form-grid{grid-template-columns:1fr}
      }
      @keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}
    </style>
  </head>
  <body>
    <div class="teacher-layout">
      <div class="sidebar-overlay" id="sidebar-overlay"></div>
      <aside class="teacher-sidebar" id="teacher-sidebar">
        <div class="teacher-sidebar-header">
          <div class="teacher-sidebar-brand">
            <div class="logo-mark">C</div>
            <div><div class="brand-name">Vyntra Académico</div><div class="brand-sub">Panel Docente</div></div>
          </div>
        </div>
        <nav class="teacher-sidebar-nav">
          <div class="nav-section">
            <div class="nav-label">Gestión</div>
            <a href="#" class="active" data-nav="planilla">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
              Planilla ABP
            </a>
            <a href="#" data-nav="materiales">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
              Subir Material
            </a>
            <a href="#" data-nav="incidentes">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Incidentes
            </a>
            <a href="#" data-nav="redaccion">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
              Redacción IA
            </a>
            <a href="#" data-nav="competencias">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/></svg>
              Competencias
            </a>
          </div>
          <div class="nav-section">
            <div class="nav-label">Enlaces</div>
            <a href="/admin">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              Administración
            </a>
            <a href="/estudiante">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
              Portal Estudiantil
            </a>
          </div>
        </nav>
        <div class="teacher-sidebar-footer">
          <div class="user-badge">
            <div class="avatar" id="sidebar-avatar">D</div>
            <div class="info">
              <div class="name" id="sidebar-name">Docente</div>
              <div class="role">Profesor</div>
            </div>
            <button id="logout-btn" class="btn btn-sm btn-ghost" onclick="localStorage.clear();window.location.href='/login'">Salir</button>
          </div>
        </div>
      </aside>

      <div class="teacher-main">
        <header class="teacher-topbar">
          <div class="page-title">
            <h1>Panel Docente</h1>
            <p>Gestión de calificaciones · Metodología ABP</p>
          </div>
          <div class="topbar-actions">
            <span class="sidebar-toggle" style="display:inline-flex;padding:0.375rem;border-radius:0.375rem;background:transparent;border:1px solid var(--border-light);cursor:pointer" id="sidebar-toggle-btn">
              <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color:var(--charcoal)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
            </span>
            <div class="status-pill"><span class="dot"></span>Sesión activa</div>
          </div>
        </header>

        <div class="teacher-content">
          <!-- Stats -->
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(9rem,1fr));gap:0.75rem;margin-bottom:1.5rem">
            <div class="stat-card"><div class="stat-label">Registros hoy</div><div class="stat-value" id="stat-today" style="color:var(--charcoal)">--</div><div class="stat-footer">Notas ingresadas</div></div>
            <div class="stat-card"><div class="stat-label">En riesgo</div><div class="stat-value" id="stat-risk" style="color:#BA1A1A">--</div><div class="stat-footer">&lt; 3.5 de promedio</div></div>
            <div class="stat-card"><div class="stat-label">Incidentes</div><div class="stat-value" id="stat-incidents" style="color:#B8860B">--</div><div class="stat-footer">Pendientes de revisión</div></div>
          </div>

          <!-- SECTION: Planilla ABP -->
          <div id="section-planilla">
            <div class="module-card">
              <div class="module-card-header">
                <div class="module-title"><div class="icon-wrap crimson"><svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg></div>Planilla Inteligente ABP</div>
                <span style="font-size:0.6875rem;color:var(--slate)">Nota propagada a 9 materias</span>
              </div>
              <div class="module-card-body">
                <form id="grade-form">
                  <div class="form-grid">
                    <div><label style="font-size:0.75rem;font-weight:600;color:var(--charcoal);display:block;margin-bottom:0.25rem">Curso</label><select id="gf-course" class="input-field"><option value="11-A">11-A</option><option value="10-A">10-A</option><option value="9-A">9-A</option><option value="8-A">8-A</option><option value="7-A">7-A</option><option value="6-A">6-A</option></select></div>
                    <div><label style="font-size:0.75rem;font-weight:600;color:var(--charcoal);display:block;margin-bottom:0.25rem">Proyecto Integrador</label><select id="gf-project" class="input-field"><option value="Proyecto Transversal ABP">Proyecto Transversal ABP</option><option value="Proyecto Científico ABP">Proyecto Científico ABP</option><option value="Proyecto Social ABP">Proyecto Social ABP</option><option value="Proyecto Tecnológico ABP">Proyecto Tecnológico ABP</option></select></div>
                    <div><label style="font-size:0.75rem;font-weight:600;color:var(--charcoal);display:block;margin-bottom:0.25rem">Materia base</label><select id="gf-subject" class="input-field"><option value="Investigación Guiada">Investigación Guiada</option><option value="Matemáticas Aplicadas">Matemáticas Aplicadas</option><option value="Ciencias Naturales">Ciencias Naturales</option><option value="Lenguaje y Literatura">Lenguaje y Literatura</option><option value="Inglés Avanzado">Inglés Avanzado</option><option value="Ciencias Sociales">Ciencias Sociales</option><option value="Tecnología e Informática">Tecnología e Informática</option><option value="Arte y Creatividad">Arte y Creatividad</option><option value="Música y Expresión">Música y Expresión</option></select></div>
                    <div><label style="font-size:0.75rem;font-weight:600;color:var(--charcoal);display:block;margin-bottom:0.25rem">Estudiante (ID)</label><input id="gf-student" class="input-field" placeholder="Número de identificación" /></div>
                    <div><label style="font-size:0.75rem;font-weight:600;color:var(--charcoal);display:block;margin-bottom:0.25rem">Nota (0.0 - 5.0)</label><input id="gf-score" type="number" step="0.1" min="0" max="5" class="input-field" placeholder="Ej: 4.2" /></div>
                    <div style="display:flex;align-items:flex-end"><button type="submit" class="btn btn-crimson" id="gf-submit" style="width:100%;justify-content:center;padding:0.625rem;font-size:0.8125rem">Registrar Nota</button></div>
                  </div>
                </form>
                <div id="gf-feedback" style="margin-top:0.75rem"></div>
                <div id="propagation-banner" class="propagation-banner" style="display:none;margin-top:0.75rem">
                  <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                  <span id="propagation-text"></span>
                </div>
                <div style="margin-top:1rem;padding-top:1rem;border-top:1px solid var(--border-light)">
                  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.5rem">
                    <span style="font-size:0.75rem;font-weight:600;color:var(--charcoal)">Últimos registros</span>
                    <span style="font-size:0.6875rem;color:var(--slate)" id="recent-count">0 hoy</span>
                  </div>
                  <div id="recent-grades" style="max-height:200px;overflow-y:auto"><div style="font-size:0.75rem;color:var(--slate);text-align:center;padding:1rem">Cargando...</div></div>
                </div>
              </div>
            </div>
          </div>

          <!-- SECTION: Subir Material (drag-drop) -->
          <div id="section-materiales" style="display:none">
            <div class="module-card">
              <div class="module-card-header">
                <div class="module-title"><div class="icon-wrap amber"><svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg></div>Subir Material Educativo</div>
              </div>
              <div class="module-card-body">
                <div class="drop-zone" id="drop-zone">
                  <svg class="dz-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                  <div class="dz-text">Arrastra un archivo PDF o Word aquí</div>
                  <div class="dz-hint">o haz clic para seleccionar</div>
                </div>
                <input type="file" id="file-input" accept=".pdf,.doc,.docx" style="display:none" />
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-top:0.75rem">
                  <div><label style="font-size:0.75rem;font-weight:600;color:var(--charcoal);display:block;margin-bottom:0.25rem">Materia</label><select id="mat-subject" class="input-field"><option value="">Seleccionar materia...</option></select></div>
                  <div><label style="font-size:0.75rem;font-weight:600;color:var(--charcoal);display:block;margin-bottom:0.25rem">Curso</label><select id="mat-grade" class="input-field"><option value="11-A">11-A</option><option value="10-A">10-A</option><option value="9-A">9-A</option><option value="8-A">8-A</option><option value="7-A">7-A</option><option value="6-A">6-A</option></select></div>
                </div>
                <button class="btn btn-crimson" id="mat-upload-btn" style="margin-top:0.75rem;width:100%;justify-content:center;padding:0.625rem" disabled>Selecciona un archivo</button>
                <div class="upload-progress" id="mat-progress"></div>
              </div>
            </div>
          </div>

          <!-- SECTION: Incidentes -->
          <div id="section-incidentes" style="display:none">
            <div class="module-card">
              <div class="module-card-header">
                <div class="module-title"><div class="icon-wrap emerald"><svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>Buzón de Incidentes & Reactivación</div>
                <span style="font-size:0.6875rem;color:var(--slate)" id="incident-count">0 pendientes</span>
              </div>
              <div class="module-card-body" style="padding:0;overflow-x:auto">
                <table class="incident-table">
                  <thead><tr><th>Estudiante</th><th>Examen</th><th>Estado</th><th>Fecha</th><th style="text-align:center">Acción</th></tr></thead>
                  <tbody id="incident-tbody"><tr><td colspan="5" style="text-align:center;padding:2rem;color:var(--slate)">Cargando incidentes...</td></tr></tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- SECTION: Redacción IA -->
          <div id="section-redaccion" style="display:none">
            <div class="module-card">
              <div class="module-card-header">
                <div class="module-title"><div class="icon-wrap amber"><svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg></div>Copiloto de Redacción Docente</div>
              </div>
              <div class="module-card-body">
                <p style="font-size:0.8125rem;color:var(--slate);margin-bottom:1rem">Escribe notas rápidas sobre el comportamiento o desempeño de un estudiante y el asistente IA las convertirá en observaciones formales y pedagógicas.</p>
                <div style="display:flex;flex-direction:column;gap:0.75rem">
                  <div><label style="font-size:0.75rem;font-weight:600;color:var(--charcoal);display:block;margin-bottom:0.25rem">Nombre del estudiante</label><input id="ai-student" class="input-field" placeholder="Opcional — Ej: Juan Pérez" /></div>
                  <div><label style="font-size:0.75rem;font-weight:600;color:var(--charcoal);display:block;margin-bottom:0.25rem">Notas rápidas del docente</label><textarea id="ai-notes" class="input-field" rows="4" placeholder='Ej: "Juan estuvo distraído hoy, no entregó la tarea, interrumpió la clase varias veces"'></textarea></div>
                  <div style="display:flex;gap:0.5rem;align-items:center">
                    <button class="btn btn-gold" id="ai-optimize-btn"><svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>Optimizar con IA</button>
                    <span id="ai-status" style="font-size:0.75rem;color:var(--slate)"></span>
                  </div>
                  <div id="ai-result" class="ai-result-box">
                    <div style="font-size:0.6875rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#B8860B;margin-bottom:0.375rem">Observación optimizada</div>
                    <div id="ai-result-text"></div>
                    <button class="btn btn-sm btn-ghost" id="ai-copy-btn" style="margin-top:0.5rem">Copiar al portapapeles</button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- SECTION: Competencias (heat map) -->
          <div id="section-competencias" style="display:none">
            <div class="module-card">
              <div class="module-card-header">
                <div class="module-title"><div class="icon-wrap crimson"><svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/></svg></div>Monitoreo de Competencias</div>
                <span style="font-size:0.6875rem;color:var(--slate)">Insignias Oro · Plata · Bronce</span>
              </div>
              <div class="module-card-body">
                <div id="heat-container"><div style="font-size:0.75rem;color:var(--slate);text-align:center;padding:1rem">Cargando mapa de competencias...</div></div>
                <div class="heat-legend">
                  <span><span class="dot" style="background:rgba(253,192,3,0.4)"></span>Oro (≥ 4.0)</span>
                  <span><span class="dot" style="background:rgba(156,163,175,0.4)"></span>Plata (3.0 – 3.9)</span>
                  <span><span class="dot" style="background:rgba(205,127,50,0.3)"></span>Bronce (&lt; 3.0)</span>
                  <span><span class="dot" style="background:rgba(0,0,0,0.03);border:1px solid var(--border-light)"></span>Sin dato</span>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- WS Toast Notification -->
    <div class="ws-toast" id="ws-toast">
      <div class="t-title">⚠️ Examen Interrumpido</div>
      <div class="t-body" id="ws-toast-body">Un estudiante ha perdido conexión durante un examen.</div>
      <button class="t-btn" id="ws-toast-btn">Reactivar Examen</button>
    </div>

    <AIChat role="teacher" />
  </body>
</html>

<script define:vars={{ apiUrl, wsUrl }}>
(function () {
  var token = localStorage.getItem('access_token')
  if (!token) { window.location.href = '/login'; return }

  var name = localStorage.getItem('userName') || 'Docente'
  var elName = document.getElementById('sidebar-name')
  var elAvatar = document.getElementById('sidebar-avatar')
  if (elName) elName.textContent = name
  if (elAvatar) elAvatar.textContent = name.charAt(0).toUpperCase()

  // ── Navigation ──
  var currentSection = 'planilla'
  var navLinks = document.querySelectorAll('[data-nav]')
  var sections = {
    planilla: document.getElementById('section-planilla'),
    materiales: document.getElementById('section-materiales'),
    incidentes: document.getElementById('section-incidentes'),
    redaccion: document.getElementById('section-redaccion'),
    competencias: document.getElementById('section-competencias'),
  }

  function showSection(id) {
    currentSection = id
    Object.keys(sections).forEach(function (k) {
      sections[k].style.display = k === id ? 'block' : 'none'
    })
    navLinks.forEach(function (a) {
      a.classList.toggle('active', a.getAttribute('data-nav') === id)
    })
    if (id === 'incidentes') loadIncidents()
    if (id === 'competencias') loadHeatMap()
    if (id === 'materiales') loadSubjects()
  }

  navLinks.forEach(function (a) {
    a.addEventListener('click', function (e) {
      e.preventDefault()
      var nav = a.getAttribute('data-nav')
      if (nav && sections[nav]) showSection(nav)
    })
  })

  // ── Sidebar Toggle (Mobile) ──
  var sidebar = document.getElementById('teacher-sidebar')
  var overlay = document.getElementById('sidebar-overlay')
  var toggleBtn = document.getElementById('sidebar-toggle-btn')
  if (toggleBtn) {
    toggleBtn.addEventListener('click', function () { sidebar.classList.toggle('open'); overlay.classList.toggle('open') })
  }
  if (overlay) {
    overlay.addEventListener('click', function () { sidebar.classList.remove('open'); overlay.classList.remove('open') })
  }

  // ── API Helpers ──
  function apiHeaders() {
    return { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token }
  }
  function apiFetch(path, opts) {
    var url = apiUrl.replace(/\/+$/, '') + '/' + path.replace(/^\/+/, '')
    var merged = Object.assign({ headers: apiHeaders() }, opts || {})
    if (merged.body && typeof merged.body === 'object' && !(merged.body instanceof FormData)) {
      merged.body = JSON.stringify(merged.body)
    }
    return fetch(url, merged).then(function (r) {
      if (r.status === 401) { localStorage.clear(); window.location.href = '/login' }
      return r.json()
    })
  }

  // ── Stats ──
  function loadStats() {
    var userId = localStorage.getItem('userId')
    if (!userId) return
    apiFetch('/api/grades?teacher_id=' + encodeURIComponent(userId)).then(function (grades) {
      var today = new Date().toDateString()
      var todayCount = Array.isArray(grades) ? grades.filter(function (g) { return g.created_at ? g.created_at.slice(0, 10) === today : false }).length : 0
      document.getElementById('stat-today').textContent = todayCount
    }).catch(function () {})
    apiFetch('/api/students/risk').then(function (risk) {
      document.getElementById('stat-risk').textContent = Array.isArray(risk) ? risk.length : 0
    }).catch(function () {})
    apiFetch('/api/admin/incidents?limit=5').then(function (inc) {
      document.getElementById('stat-incidents').textContent = Array.isArray(inc) ? inc.length : 0
    }).catch(function () {})
  }

  // ── Grade Form ──
  var form = document.getElementById('grade-form')
  var feedback = document.getElementById('gf-feedback')
  var propBanner = document.getElementById('propagation-banner')
  var propText = document.getElementById('propagation-text')
  var submitBtn = document.getElementById('gf-submit')

  form.addEventListener('submit', async function (e) {
    e.preventDefault()
    var studentId = document.getElementById('gf-student').value.trim()
    var score = parseFloat(document.getElementById('gf-score').value)
    var teacherId = localStorage.getItem('userId')
    if (!studentId || isNaN(score)) {
      feedback.innerHTML = '<span style="font-size:0.75rem;color:#BA1A1A">Completa todos los campos</span>'; return
    }
    var payload = {
      student_id: studentId, teacher_id: teacherId, course_id: document.getElementById('gf-course').value,
      project_id: document.getElementById('gf-project').value, subject_id: document.getElementById('gf-subject').value, score: score,
    }
    submitBtn.disabled = true; submitBtn.textContent = 'Registrando...'
    feedback.innerHTML = ''; propBanner.style.display = 'none'
    try {
      var res = await fetch(apiUrl + '/api/teacher/submit-grade', { method: 'POST', headers: apiHeaders(), body: JSON.stringify(payload) })
      var data = await res.json()
      if (!res.ok) throw new Error(data.detail || 'Error al registrar')
      if (data.propagation_note) { propText.textContent = data.propagation_note; propBanner.style.display = 'flex' }
      feedback.innerHTML = '<span style="font-size:0.75rem;color:#2E7D32;font-weight:600">Nota registrada correctamente</span>'
      form.reset(); loadRecentGrades(); loadStats()
    } catch (err) { feedback.innerHTML = '<span style="font-size:0.75rem;color:#BA1A1A">' + (err.message || 'Error de conexión') + '</span>' }
    finally { submitBtn.disabled = false; submitBtn.textContent = 'Registrar Nota' }
  })

  // ── Recent Grades ──
  function loadRecentGrades() {
    var userId = localStorage.getItem('userId')
    if (!userId) return
    var el = document.getElementById('recent-grades')
    apiFetch('/api/grades?teacher_id=' + encodeURIComponent(userId) + '&limit=10').then(function (data) {
      if (!data || data.length === 0) { el.innerHTML = '<div style="font-size:0.75rem;color:var(--slate);text-align:center;padding:1rem">Sin registros recientes</div>'; return }
      var today = new Date().toDateString()
      var todayCount = data.filter(function (g) { return g.created_at ? g.created_at.slice(0, 10) === today : false }).length
      document.getElementById('recent-count').textContent = todayCount + ' hoy'
      el.innerHTML = data.map(function (g) {
        var color = g.score >= 4.0 ? '#2E7D32' : g.score >= 3.5 ? '#B8860B' : '#BA1A1A'
        return '<div style="display:flex;align-items:center;gap:0.5rem;padding:0.375rem 0;border-bottom:1px solid var(--border-light)"><span style="width:0.5rem;height:0.5rem;border-radius:50%;background:' + color + ';flex-shrink:0"></span><span style="flex:1;font-size:0.75rem;color:var(--charcoal)">' + (g.student_id || '-').substring(0, 12) + '</span><span style="font-size:0.6875rem;color:var(--slate)">' + (g.subject_name || '').substring(0, 16) + '</span><span style="font-size:0.8125rem;font-weight:700;color:' + color + '">' + (g.score != null ? g.score.toFixed(1) : '-') + '</span></div>'
      }).join('')
    }).catch(function () { el.innerHTML = '<div style="font-size:0.75rem;color:var(--slate);text-align:center;padding:1rem">Error al cargar</div>' })
  }

  // ── Upload Material (drag-drop) ──
  var dropZone = document.getElementById('drop-zone')
  var fileInput = document.getElementById('file-input')
  var matSubject = document.getElementById('mat-subject')
  var matGrade = document.getElementById('mat-grade')
  var matUploadBtn = document.getElementById('mat-upload-btn')
  var matProgress = document.getElementById('mat-progress')
  var selectedFile = null

  function loadSubjects() {
    apiFetch('/api/subjects').then(function (subs) {
      if (Array.isArray(subs) && subs.length) {
        matSubject.innerHTML = '<option value="">Seleccionar materia...</option>' + subs.map(function (s) { return '<option value="' + (s.id || s.name) + '">' + (s.name || s.id) + '</option>' }).join('')
      }
    }).catch(function () {})
  }

  dropZone.addEventListener('click', function () { fileInput.click() })
  dropZone.addEventListener('dragover', function (e) { e.preventDefault(); dropZone.classList.add('dragover') })
  dropZone.addEventListener('dragleave', function () { dropZone.classList.remove('dragover') })
  dropZone.addEventListener('drop', function (e) {
    e.preventDefault(); dropZone.classList.remove('dragover')
    if (e.dataTransfer.files.length) handleFile(e.dataTransfer.files[0])
  })
  fileInput.addEventListener('change', function () { if (fileInput.files.length) handleFile(fileInput.files[0]) })

  function handleFile(file) {
    var ext = file.name.split('.').pop().toLowerCase()
    if (!['pdf', 'doc', 'docx'].includes(ext)) { alert('Solo se aceptan archivos PDF o Word'); return }
    selectedFile = file
    dropZone.classList.add('has-file')
    dropZone.querySelector('.dz-text').textContent = file.name
    matUploadBtn.textContent = 'Procesar ' + file.name
    matUploadBtn.disabled = false
  }

  matUploadBtn.addEventListener('click', async function () {
    if (!selectedFile || !matSubject.value) { alert('Selecciona un archivo y una materia'); return }
    matUploadBtn.disabled = true; matUploadBtn.textContent = 'Procesando...'
    matProgress.className = 'upload-progress active'; matProgress.textContent = 'Extrayendo texto y comprimiendo con IA...'
    var fd = new FormData()
    fd.append('file', selectedFile)
    fd.append('subject_id', matSubject.value)
    fd.append('grade_id', matGrade.value)
    try {
      var res = await fetch(apiUrl + '/api/teacher/upload-material', { method: 'POST', headers: { 'Authorization': 'Bearer ' + token }, body: fd })
      var data = await res.json()
      if (!res.ok) throw new Error(data.detail || 'Error')
      matProgress.className = 'upload-progress active success'
      matProgress.textContent = '✓ Material procesado y subido a la nube'
      selectedFile = null; dropZone.classList.remove('has-file')
      dropZone.querySelector('.dz-text').textContent = 'Arrastra un archivo PDF o Word aquí'
      matUploadBtn.textContent = 'Selecciona un archivo'; matUploadBtn.disabled = true
      fileInput.value = ''
    } catch (err) {
      matProgress.className = 'upload-progress active error'
      matProgress.textContent = '✗ ' + (err.message || 'Error de conexión')
      matUploadBtn.disabled = false; matUploadBtn.textContent = 'Intentar de nuevo'
    }
  })

  // ── Incidents ──
  function loadIncidents() {
    var tbody = document.getElementById('incident-tbody')
    tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:2rem;color:var(--slate)">Cargando...</td></tr>'
    apiFetch('/api/admin/incidents?limit=50').then(function (incidents) {
      var count = document.getElementById('incident-count')
      if (!incidents || incidents.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:2rem;color:var(--slate)">No hay incidentes registrados.</td></tr>'
        if (count) count.textContent = '0 pendientes'; return
      }
      if (count) count.textContent = incidents.length + ' pendiente' + (incidents.length !== 1 ? 's' : '')
      tbody.innerHTML = incidents.map(function (inc) {
        var dateStr = inc.created_at ? new Date(inc.created_at).toLocaleDateString('es-CO', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) : '-'
        var isInterrupted = inc.incident_type === 'network_loss' || inc.incident_type === 'power_loss'
        return '<tr><td style="font-weight:600">' + (inc.student_name || 'ID: ' + (inc.student_id || '-').substring(0, 8)) + '</td><td>' + (inc.exam_title || 'Examen #' + (inc.exam_id || '-').substring(0, 8)) + '</td><td><span class="status-badge interrupted">' + (isInterrupted ? 'Posible fallo técnico' : inc.status) + '</span></td><td style="font-size:0.75rem;color:var(--slate)">' + dateStr + '</td><td style="text-align:center">' + (isInterrupted ? '<button class="btn btn-sm btn-crimson reactivate-btn" data-student="' + inc.student_id + '" data-exam="' + inc.exam_id + '">Reactivar Examen</button>' : '<span style="font-size:0.6875rem;color:var(--slate)">—</span>') + '</td></tr>'
      }).join('')
      document.querySelectorAll('.reactivate-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var studentId = btn.getAttribute('data-student'); var examId = btn.getAttribute('data-exam')
          btn.disabled = true; btn.textContent = 'Reactivando...'
          apiFetch('/api/teacher/reactivate-exam', { method: 'POST', body: { student_id: studentId, exam_id: examId } }).then(function () {
            btn.textContent = '✓ Reactivado'; btn.style.background = '#2E7D32'; setTimeout(loadIncidents, 1500)
          }).catch(function () { btn.textContent = 'Error'; btn.disabled = false })
        })
      })
    }).catch(function () { var t2 = document.getElementById('incident-tbody'); if (t2) t2.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:2rem;color:var(--slate)">Error al cargar incidentes.</td></tr>' })
  }

  // ── AI Behavior Helper ──
  var optimizeBtn = document.getElementById('ai-optimize-btn')
  var aiStatus = document.getElementById('ai-status')
  var aiResult = document.getElementById('ai-result')
  var aiResultText = document.getElementById('ai-result-text')
  var aiCopyBtn = document.getElementById('ai-copy-btn')

  optimizeBtn.addEventListener('click', async function () {
    var notes = document.getElementById('ai-notes').value.trim()
    var studentName = document.getElementById('ai-student').value.trim()
    if (!notes) { aiStatus.textContent = 'Escribe algunas notas primero.'; return }
    optimizeBtn.disabled = true; optimizeBtn.textContent = 'Optimizando...'; aiStatus.textContent = 'Conectando con el asistente IA...'; aiResult.style.display = 'none'
    try {
      var data = await apiFetch('/api/teacher/ai-behavior-helper', { method: 'POST', body: { notes: notes, student_name: studentName } })
      if (data.optimized) { aiResultText.textContent = data.optimized; aiResult.style.display = 'block'; aiStatus.textContent = '✓ Observación generada' }
      else throw new Error('Respuesta vacía')
    } catch (err) { aiStatus.textContent = '✗ Error: ' + (err.message || 'Intenta de nuevo') }
    finally { optimizeBtn.disabled = false; optimizeBtn.textContent = 'Optimizar con IA' }
  })
  aiCopyBtn.addEventListener('click', function () {
    var text = aiResultText.textContent; if (!text) return
    if (navigator.clipboard) { navigator.clipboard.writeText(text).then(function () { aiCopyBtn.textContent = '✓ Copiado'; setTimeout(function () { aiCopyBtn.textContent = 'Copiar al portapapeles' }, 2000) }) }
  })

  // ── Heat Map (Competencias) ──
  function loadHeatMap() {
    var container = document.getElementById('heat-container')
    container.innerHTML = '<div style="font-size:0.75rem;color:var(--slate);text-align:center;padding:1rem">Cargando mapa de competencias...</div>'
    apiFetch('/api/teacher/skill-badges').then(function (data) {
      if (!Array.isArray(data) || data.length === 0) {
        container.innerHTML = '<div style="font-size:0.75rem;color:var(--slate);text-align:center;padding:1rem">Sin datos de competencias aún.</div>'; return
      }
      var subjectSet = {}
      data.forEach(function (s) { (s.badges || []).forEach(function (b) { if (b.subject_id) subjectSet[b.subject_id] = true }) })
      var subjects = Object.keys(subjectSet).slice(0, 9)
      var html = '<div class="heat-grid"><div class="hg-header">Estudiante</div>'
      subjects.forEach(function (s) { html += '<div class="hg-header">' + s.substring(0, 8) + '</div>' })
      data.forEach(function (student) {
        html += '<div class="hg-label">' + (student.fullname || student.student_id.substring(0, 8)) + '</div>'
        var badgeMap = {}
        ;(student.badges || []).forEach(function (b) { badgeMap[b.subject_id] = b.badge })
        subjects.forEach(function (subj) {
          var badge = badgeMap[subj] || 'vacio'
          var label = badge === 'vacio' ? '' : badge.charAt(0)
          html += '<div class="hg-cell ' + badge.toLowerCase() + '">' + label + '</div>'
        })
      })
      html += '</div>'
      container.innerHTML = html
    }).catch(function () { container.innerHTML = '<div style="font-size:0.75rem;color:var(--slate);text-align:center;padding:1rem">Error al cargar competencias.</div>' })
  }

  // ── WebSocket Exam Interrupt Listener ──
  var wsToast = document.getElementById('ws-toast')
  var wsToastBody = document.getElementById('ws-toast-body')
  var wsToastBtn = document.getElementById('ws-toast-btn')
  var pendingInterrupt = null

  function connectWs() {
    try {
      var ws = new WebSocket(wsUrl + '/ws?token=' + encodeURIComponent(token))
      ws.onmessage = function (ev) {
        try {
          var msg = JSON.parse(ev.data)
          if (msg.type === 'exam_interrupted') {
            pendingInterrupt = { student_id: msg.student_id, exam_id: msg.exam_id }
            wsToastBody.textContent = 'Un estudiante ha perdido conexión durante un examen. ¿Deseas reactivarlo?'
            wsToast.classList.add('open')
          }
        } catch (e) {}
      }
      ws.onclose = function () { setTimeout(connectWs, 5000) }
      ws.onerror = function () { ws.close() }
    } catch (e) {}
  }

  wsToastBtn.addEventListener('click', function () {
    if (pendingInterrupt) {
      var btn = wsToastBtn; btn.disabled = true; btn.textContent = 'Reactivando...'
      apiFetch('/api/teacher/reactivate-exam', { method: 'POST', body: pendingInterrupt }).then(function () {
        btn.textContent = '✓ Reactivado'; btn.style.background = 'rgba(255,255,255,0.25)'
        setTimeout(function () { wsToast.classList.remove('open'); btn.textContent = 'Reactivar Examen'; btn.disabled = false; btn.style.background = ''; pendingInterrupt = null }, 2000)
      }).catch(function () { btn.textContent = 'Error'; btn.disabled = false })
    }
  })

  // ── Initial Load ──
  loadStats(); loadRecentGrades(); loadIncidents(); connectWs()
  setInterval(loadStats, 30000); setInterval(loadRecentGrades, 15000)
})()
</script>
