---
import BaseLayout from '@layouts/BaseLayout.astro'
---

<BaseLayout titulo="Página no encontrada" descripcion="La página que buscas no existe en VYNTRA Academic." withNoise={true}>
  <div class="min-h-screen bg-gradient-to-br from-solar-base via-solar-cream to-solar-50 dark:from-surface-dark dark:via-[#0F0C08] dark:to-[#0A0705] flex items-center justify-center px-4 py-16 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-brand-gold/6 blur-[120px] animate-orb"></div>
      <div class="absolute bottom-1/3 right-1/4 w-80 h-80 rounded-full bg-brand-maroon/5 blur-[100px] animate-orb" style="animation-delay:-4s"></div>
    </div>

    <div class="relative z-10 text-center max-w-lg">
      <!-- Large 404 -->
      <div class="relative inline-block mb-8">
        <div class="text-[clamp(6rem,20vw,12rem)] font-extrabold leading-none tracking-[-0.05em] select-none" style="background:linear-gradient(135deg,var(--brand-maroon) 0%,var(--brand-gold) 50%,var(--brand-amber) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-family:'Fraunces',serif">404</div>
        <div class="absolute -bottom-4 left-1/2 -translate-x-1/2 w-32 h-0.5 bg-gradient-to-r from-transparent via-brand-gold to-transparent"></div>
      </div>

      <h1 class="text-xl sm:text-2xl font-bold mb-3 tracking-tight" style="font-family:'Fraunces',serif">Eclipse Solar</h1>
      <p class="text-sm text-text-secondary leading-relaxed mb-8">Esta página se ha desvanecido como una sombra al mediodía.<br/>No existe o ha sido movida a otro lugar en el sistema.</p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-brand-maroon to-brand-maroon-dark text-white text-sm font-semibold rounded-xl hover:shadow-glow-maroon hover:-translate-y-0.5 transition-all duration-300 ease-spring">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          Volver al Sol
        </a>
        <a href="/login" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-solar-100 dark:bg-surface-dark-card border border-brand-maroon/10 dark:border-brand-gold/10 text-text text-sm font-semibold rounded-xl hover:bg-solar-200 dark:hover:bg-surface-dark transition-all duration-300 ease-spring">
          Iniciar Sesión
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
