---
import '../styles/theme.css'
---

<!doctype html>
<html lang="es-CO">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>VYNTRA · Página no encontrada</title>
  <meta name="description" content="La página solicitada no existe en VYNTRA Academic" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href="https://colegiociudaddelsol.edu.co/404" />
  <meta property="og:title" content="VYNTRA · Página no encontrada" />
  <meta property="og:description" content="La página solicitada no existe en VYNTRA Academic" />
  <meta property="og:url" content="https://colegiociudaddelsol.edu.co/404" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700;800&family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline>
    (function(){try{var t=localStorage.getItem('vyntra-theme');if(t==='dark'||(!t&&window.matchMedia('(prefers-color-scheme:dark)').matches))document.documentElement.classList.add('dark')}catch(e){}})();
  </script>
</head>
<body>
  <div class="noise-fixed"></div>
  <main style="display:flex;min-height:100vh;align-items:center;justify-content:center;padding:2rem;text-align:center">
    <div>
      <div style="font-family:var(--font-display);font-weight:800;font-size:clamp(5rem,15vw,8rem);line-height:.8;color:var(--maroon);margin-bottom:1rem">404</div>
      <h1 style="font-family:var(--font-display);font-weight:700;font-size:clamp(1.5rem,3vw,2rem);color:var(--text);margin-bottom:.5rem">Página no encontrada</h1>
      <p style="color:var(--text-secondary);font-size:.9rem;margin-bottom:2rem;max-width:400px;margin-left:auto;margin-right:auto">La página que buscas no existe o ha sido movida. Verifica la dirección o vuelve al inicio.</p>
      <a href="/" class="btn-apple btn-primary" style="padding:.85rem 2rem;font-size:.85rem;text-decoration:none">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        Volver al Inicio
      </a>
    </div>
  </main>
</body>
</html>
