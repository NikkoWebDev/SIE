---
export interface Props {
  role?: 'student' | 'teacher' | 'admin'
}

const { role = 'student' } = Astro.props as Props
const cfg = {
  student: { accent: '#6B1A1A', accentLight: '#F5A623', endpoint: '/api/ai/student-tutor', avatar: 'V', title: 'Tutor IA · VYNTRA', subtitle: 'Asistente académico VYNTRA', welcome: '¡Hola! Soy el <strong>Tutor VYNTRA</strong>, tu asistente académico. Puedo ayudarte a entender tus materias ABP, recordarte tareas y resolver dudas. ¿En qué te ayudo hoy?', name: 'Estudiante' },
  teacher: { accent: '#34D399', accentLight: '#6EE7B7', endpoint: '/api/ai/teacher-tutor', avatar: 'D', title: 'Asistente Docente', subtitle: 'Análisis pedagógico y seguimiento', welcome: 'Bienvenido, docente. Soy el <strong>Asistente VYNTRA</strong>. Puedo ayudarte con análisis de rendimiento, alertas y recomendaciones. ¿En qué te ayudo?', name: 'Docente' },
  admin: { accent: '#F5A623', accentLight: '#FFD166', endpoint: '/api/ai/admin-assistant', avatar: 'A', title: 'Asistente Administrativo', subtitle: 'Gestión financiera y reportes', welcome: 'Bienvenido. Soy el <strong>Asistente Administrativo VYNTRA</strong>. Puedo ayudarte con análisis financiero, reportes y toma de decisiones. ¿En qué te ayudo?', name: 'Administrador' },
}
const rc = cfg[role]
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000'
---

<div id="ai-chat-root" class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-50" style="--chat-accent:{rc.accent};--chat-accent-light:{rc.accentLight}" data-endpoint={rc.endpoint} data-avatar={rc.avatar} data-username={rc.name} data-welcome={rc.welcome}>
  <button id="ai-chat-toggle"
    class="w-14 h-14 rounded-full flex items-center justify-center text-white shadow-xl hover:shadow-2xl hover:scale-110 transition-all duration-300 ease-spring relative"
    style="background:var(--chat-accent)">
    <svg id="chat-icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
    <svg id="chat-icon-close" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    <span id="chat-dot" class="absolute -top-0.5 -right-0.5 w-3 h-3 rounded-full bg-success border-2 border-white dark:border-surface-dark"></span>
  </button>

  <div id="ai-chat-panel" class="absolute bottom-16 right-0 w-[calc(100vw-1.5rem)] sm:w-[400px] h-[60vh] sm:h-[550px] rounded-2xl shadow-modal dark:shadow-modal-dark flex flex-col overflow-hidden transition-all duration-300 opacity-0 scale-95 pointer-events-none origin-bottom-right"
    style="border:1px solid var(--border);background:var(--bg)">
    <!-- Header -->
    <div class="flex items-center gap-3 px-4 sm:px-5 py-3.5 shrink-0 text-white" style="background:var(--chat-accent)">
      <div class="w-8 h-8 rounded-full bg-white/15 flex items-center justify-center shrink-0">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547"/></svg>
      </div>
      <div class="flex-1 min-w-0">
        <h3 class="text-[13px] font-bold">{rc.title}</h3>
        <p class="text-[10px] text-white/60">{rc.subtitle}</p>
      </div>
      <div class="flex items-center gap-1.5">
        <button id="chat-clear-btn" class="p-1.5 rounded-lg text-white/40 hover:text-white hover:bg-white/10 transition-colors" title="Limpiar conversación">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        </button>
      </div>
    </div>

    <!-- Messages -->
    <div id="chat-messages" class="flex-1 overflow-y-auto p-3 sm:p-4 space-y-3" role="log" aria-live="polite" aria-label="Mensajes del chat"></div>

    <!-- Typing + Tool Status -->
    <div id="chat-typing" class="hidden px-3 sm:px-4 pb-2">
      <div class="flex items-start gap-2.5">
        <div class="w-7 h-7 rounded-full flex items-center justify-center text-[10px] font-bold text-white shrink-0" style="background:var(--chat-accent)">{rc.avatar}</div>
        <div class="rounded-2xl rounded-tl-sm px-3.5 py-3 bg-[var(--bg-secondary)] border border-border">
          <div class="flex gap-1">
            <span class="w-2 h-2 rounded-full bg-text-tertiary animate-bounce" style="animation-delay:0ms"></span>
            <span class="w-2 h-2 rounded-full bg-text-tertiary animate-bounce" style="animation-delay:150ms"></span>
            <span class="w-2 h-2 rounded-full bg-text-tertiary animate-bounce" style="animation-delay:300ms"></span>
          </div>
          <div id="chat-tool-status" class="text-[10px] text-text-tertiary mt-1 hidden"></div>
        </div>
      </div>
    </div>

    <!-- Input -->
    <div class="px-3 sm:px-4 py-3 shrink-0 border-t border-border bg-[var(--bg)]">
      <form id="chat-form" class="flex gap-2">
        <input id="chat-input" type="text" placeholder="Escribe tu consulta..." class="flex-1 bg-[var(--input-bg)] border border-[var(--input-border)] rounded-xl px-4 py-2.5 text-sm text-text placeholder:text-text-tertiary/50 outline-none transition-all duration-200 focus:border-brand-maroon dark:focus:border-brand-gold" />
        <button id="chat-send" type="submit" class="w-10 h-10 shrink-0 rounded-xl flex items-center justify-center text-white transition-all duration-200 hover:shadow-glow-maroon active:scale-95" style="background:var(--chat-accent)">
          <svg id="chat-send-icon" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          <span id="chat-send-spinner" class="hidden h-4 w-4 border-2 border-white/30 border-t-white rounded-full animate-spin-slow"></span>
        </button>
      </form>
    </div>
  </div>
</div>

<script define:vars={{ apiUrl, role }}>
  (function () {
    var root = document.getElementById('ai-chat-root')
    var accent = getComputedStyle(root).getPropertyValue('--chat-accent').trim()
    var endpoint = root.getAttribute('data-endpoint')
    var avatar = root.getAttribute('data-avatar') || 'V'
    var userNameText = root.getAttribute('data-username') || 'Usuario'
    var welcomeText = root.getAttribute('data-welcome') || ''
    var storageKey = 'vyntra-chat-' + role
    var userName = localStorage.getItem('userName') || userNameText

    var toggle = document.getElementById('ai-chat-toggle')
    var panel = document.getElementById('ai-chat-panel')
    var messages = document.getElementById('chat-messages')
    var form = document.getElementById('chat-form')
    var input = document.getElementById('chat-input')
    var typing = document.getElementById('chat-typing')
    var sendIcon = document.getElementById('chat-send-icon')
    var spinner = document.getElementById('chat-send-spinner')
    var statusBar = document.getElementById('chat-tool-status')

    toggle.addEventListener('click', function () {
      var isOpen = !toggle._open
      toggle._open = isOpen
      panel.classList.toggle('opacity-0', !isOpen)
      panel.classList.toggle('scale-95', !isOpen)
      panel.classList.toggle('pointer-events-none', !isOpen)
      panel.classList.toggle('opacity-100', isOpen)
      panel.classList.toggle('scale-100', isOpen)
      panel.classList.toggle('pointer-events-auto', isOpen)
      document.getElementById('chat-icon-open').classList.toggle('hidden', isOpen)
      document.getElementById('chat-icon-close').classList.toggle('hidden', !isOpen)
      if (isOpen) loadMessages()
    })

    document.getElementById('chat-clear-btn').addEventListener('click', function () {
      localStorage.removeItem(storageKey); messages.innerHTML = ''; addWelcome()
    })

    function escapeHtml(text) { var d = document.createElement('div'); d.appendChild(document.createTextNode(text)); return d.innerHTML }
    function renderMarkdown(text) {
      var html = escapeHtml(text)
      html = html.replace(/^### (.+)$/gm, '<h4>$1</h4>').replace(/^## (.+)$/gm, '<h3>$1</h3>').replace(/^# (.+)$/gm, '<h3>$1</h3>')
      html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/\*(.+?)\*/g, '<em>$1</em>')
      html = html.replace(/`([^`]+)`/g, '<code>$1</code>')
      html = html.replace(/\n/g, '<br>')
      return html
    }

    function addWelcome() {
      var div = document.createElement('div'); div.className = 'flex items-start gap-2.5'
      var av = document.createElement('div'); av.style.cssText = 'width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;background:'+accent+';color:white;flex-shrink:0'
      av.textContent = avatar
      var bubble = document.createElement('div'); bubble.style.cssText = 'border-radius:16px;border-top-left-radius:4px;padding:.75rem 1rem;line-height:1.6;font-size:13px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text)'
      bubble.innerHTML = welcomeText
      div.appendChild(av); div.appendChild(bubble); messages.appendChild(div)

      var suggestions = role === 'student' ? ['¿Cómo mejorar mi promedio?','Explica el proyecto ABP','¿Qué materias tengo en riesgo?'] :
                         role === 'teacher' ? ['Resumen de calificaciones','Estudiantes en riesgo','Sugerencias pedagógicas'] :
                         ['Reporte financiero','Estudiantes en mora','Estadísticas del sistema']
      var chipsDiv = document.createElement('div'); chipsDiv.className = 'flex flex-wrap gap-1.5 mt-2'
      suggestions.forEach(function(text) {
        var chip = document.createElement('button'); chip.textContent = text
        chip.style.cssText = 'font-size:11px;padding:.3rem .75rem;border-radius:999px;border:1px solid var(--border);background:var(--bg-tertiary);color:var(--text-secondary);cursor:pointer;transition:all .15s'
        chip.addEventListener('click', function(){ input.value = text; form.dispatchEvent(new Event('submit')) })
        chipsDiv.appendChild(chip)
      })
      messages.appendChild(chipsDiv); messages.scrollTop = messages.scrollHeight
    }

    function scrollToBottom() { messages.scrollTop = messages.scrollHeight }

    function saveMessages() {
      var msgs = []; messages.querySelectorAll('[data-msg-role]').forEach(function(el) {
        msgs.push({ role: el.getAttribute('data-msg-role'), content: el.getAttribute('data-msg-text') })
      })
      if (msgs.length > 50) msgs = msgs.slice(-50)
      localStorage.setItem(storageKey, JSON.stringify(msgs))
    }

    function loadMessages() {
      messages.innerHTML = ''
      var saved = localStorage.getItem(storageKey)
      if (saved) {
        try {
          JSON.parse(saved).forEach(function(m) {
            var isUser = m.role === 'user'
            var div = document.createElement('div'); div.className = 'flex items-start gap-2.5 ' + (isUser ? 'flex-row-reverse' : ''); div.setAttribute('data-msg-role', m.role); div.setAttribute('data-msg-text', m.content)
            var av = document.createElement('div'); av.textContent = isUser ? userName.charAt(0).toUpperCase() : avatar
            av.style.cssText = 'width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0;'+(isUser?'background:'+accent+';color:white':'background:var(--bg-tertiary);color:var(--text)')
            var bubble = document.createElement('div'); bubble.style.cssText = 'border-radius:16px;padding:.75rem 1rem;line-height:1.5;font-size:13px;max-width:85%;'+(isUser?'background:'+accent+';color:white;border-top-right-radius:4px':'background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);border-top-left-radius:4px')
            if (isUser) bubble.textContent = m.content; else bubble.innerHTML = renderMarkdown(m.content)
            div.appendChild(av); div.appendChild(bubble); messages.appendChild(div)
          })
          scrollToBottom()
          return
        } catch(_) {}
      }
      addWelcome()
    }

    form.addEventListener('submit', async function(e) {
      e.preventDefault()
      var text = input.value.trim(); if (!text) return
      input.value = ''
      setSending(true)
      toggle.style.pointerEvents = 'none'

      addMessage(text, 'user')
      typing.classList.remove('hidden'); scrollToBottom()

      // Context is built server-side from userId — no client fetches needed
      var bubble = document.createElement('div'); bubble.className = 'flex-1'; bubble.id = 'streaming-bubble'; bubble.setAttribute('data-msg-role','assistant')
      var div = document.createElement('div'); div.className = 'flex items-start gap-2.5'
      var av = document.createElement('div'); av.textContent = avatar; av.style.cssText = 'width:28px;height:28px;border-radius:50%;background:var(--bg-tertiary);color:var(--text);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0'
      div.appendChild(av); div.appendChild(bubble); messages.appendChild(div)
      typing.classList.add('hidden')

      try {
        var res = await fetch(apiUrl + endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ message: text }),
        })
        if (!res.ok) { bubble.innerHTML = '<span style="color:var(--danger)">Error del asistente.</span>'; setSending(false); return }
        var reader = res.body.getReader(), decoder = new TextDecoder(), buffer = '', fullText = ''
        while (true) {
          var result = await reader.read(); if (result.done) break
          buffer += decoder.decode(result.value, { stream: true })
          var lines = buffer.split('\n'); buffer = lines.pop() || ''
          for (var i = 0; i < lines.length; i++) {
            var line = lines[i]
            if (line.startsWith('data: ')) {
              var data = line.slice(6); if (data === '[DONE]') continue
              try {
                var parsed = JSON.parse(data)
                if (parsed.token) { fullText += parsed.token; bubble.innerHTML = renderMarkdown(fullText); scrollToBottom() }
                else if (parsed.tool_status) {
                  if (statusBar) statusBar.textContent = parsed.tool_status
                  else { typing.classList.remove('hidden'); var tb = typing.querySelector('.tool-status'); if(tb) tb.textContent = parsed.tool_status }
                }
                else if (parsed.error) { bubble.innerHTML = '<span style="color:var(--danger)">'+parsed.error+'</span>'; if(statusBar) statusBar.textContent = '' }
              } catch(_) {}
            }
          }
        }
        if (statusBar) statusBar.textContent = ''
        typing.classList.add('hidden')
        if (fullText) { div.setAttribute('data-msg-role','assistant'); div.setAttribute('data-msg-text',fullText); saveMessages() }
        else bubble.innerHTML = '<span style="color:var(--text-tertiary)">Sin respuesta. Reformula tu consulta.</span>'
      } catch(_) { bubble.innerHTML = '<span style="color:var(--danger)">Error de conexión.</span>'; typing.classList.add('hidden') }
      setSending(false)
      toggle.style.pointerEvents = 'auto'
    })

    function setSending(v) {
      var btn = document.getElementById('chat-send'); btn.disabled = v
      if (sendIcon) { sendIcon.style.display = v ? 'none' : ''; sendIcon.classList.toggle('hidden', v) }
      if (spinner) { spinner.style.display = v ? '' : 'none'; spinner.classList.toggle('hidden', !v) }
    }

    function addMessage(content, msgRole) {
      var isUser = msgRole === 'user'
      var div = document.createElement('div'); div.className = 'flex items-start gap-2.5 ' + (isUser ? 'flex-row-reverse' : ''); div.setAttribute('data-msg-role', msgRole); div.setAttribute('data-msg-text', content)
      var av = document.createElement('div'); av.textContent = isUser ? userName.charAt(0).toUpperCase() : avatar
      av.style.cssText = 'width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0;'+(isUser?'background:'+accent+';color:white':'background:var(--bg-tertiary);color:var(--text)')
      var bubble = document.createElement('div'); bubble.style.cssText = 'border-radius:16px;padding:.75rem 1rem;line-height:1.5;font-size:13px;max-width:85%;'+(isUser?'background:'+accent+';color:white;border-top-right-radius:4px':'background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);border-top-left-radius:4px')
      if (isUser) bubble.textContent = content; else bubble.innerHTML = renderMarkdown(content)
      div.appendChild(av); div.appendChild(bubble); messages.appendChild(div); scrollToBottom(); saveMessages()
    }
  })()
</script>
