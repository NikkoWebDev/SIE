---
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000'
const wsUrl = apiUrl.replace(/^http/, 'ws') + '/ws'
---

<div id="risk-alert-slot" class="fixed top-4 right-4 z-[60] flex flex-col gap-2 w-full max-w-xs sm:max-w-sm pointer-events-none" style="top:max(1rem,env(safe-area-inset-top));right:max(1rem,env(safe-area-inset-right))"></div>

<script define:vars={{ wsUrl }}>
  (function () {
    var container = document.getElementById('risk-alert-slot')
    if (!container) return
    var ws = null, reconnectTimer = null, delay = 1000, maxDelay = 30000
    var destroyed = false
    var audioCtx = null
    var hasUserGesture = false

    // Track user interaction for audio eligibility
    function onUserGesture() { hasUserGesture = true }
    document.addEventListener('click', onUserGesture, { once: true })
    document.addEventListener('keydown', onUserGesture, { once: true })

    function connect() {
      if (destroyed) return
      var token = localStorage.getItem('ws_access_token')
      if (!token) { scheduleReconnect(); return }
      try { ws = new WebSocket(wsUrl + '?token=' + encodeURIComponent(token)) } catch(e) { scheduleReconnect(); return }
      ws.onopen = function() { delay = 1000 }
      ws.onmessage = function(e) {
        try {
          var msg = JSON.parse(e.data)
          if (msg.type === 'RISK_ALERT') { showRiskAlert(msg); playAlertSound() }
        } catch(_) {}
      }
      ws.onclose = function() { ws = null; scheduleReconnect() }
      ws.onerror = function() { ws && ws.close() }
    }

    function scheduleReconnect() {
      if (destroyed) return
      if (reconnectTimer) clearTimeout(reconnectTimer)
      reconnectTimer = setTimeout(function() {
        delay = Math.min(delay * 1.5, maxDelay)
        connect()
      }, delay)
    }

    function showRiskAlert(msg) {
      var el = document.createElement('div')
      el.className = 'pointer-events-auto rounded-xl border border-brand-danger/30 bg-white dark:bg-surface-dark-elevated shadow-xl p-3 sm:p-4 flex items-start gap-3 sm:gap-4 animate-toast-slide-in'
      el.style.animation = 'toastSlideIn 0.4s cubic-bezier(0.34,1.56,0.64,1) both'
      el.innerHTML =
        '<div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-brand-danger/10 flex items-center justify-center shrink-0">' +
        '<svg class="h-5 w-5 text-brand-danger" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>' +
        '</div>' +
        '<div class="flex-1 min-w-0">' +
        '<p class="text-xs sm:text-sm font-bold text-brand-danger truncate">' + window.escapeHtml(msg.msg || 'Alerta académica') + '</p>' +
        '<p class="text-[10px] sm:text-xs text-text-tertiary mt-0.5">Estudiante: ' + window.escapeHtml(msg.student_id || '') + ' · Nota: ' + window.escapeHtml(String(msg.score || '--')) + '</p>' +
        '</div>' +
        '<button class="shrink-0 rounded-lg p-1 text-text-tertiary hover:text-brand-danger hover:bg-brand-danger/10 transition-colors text-sm" onclick="this.parentElement.remove()">&times;</button>'
      container.appendChild(el)

      var autoDismiss = setTimeout(function() {
        if (el.parentNode) { el.style.opacity = '0'; el.style.transform = 'translateX(100%)'; setTimeout(function(){ el.remove() }, 300) }
      }, 8000)

      el.querySelector('button').addEventListener('click', function() {
        clearTimeout(autoDismiss)
        el.style.opacity = '0'
        el.style.transform = 'translateX(100%)'
        setTimeout(function() { el.remove() }, 300)
      })
    }

    function playAlertSound() {
      if (!hasUserGesture) return // Browser requires user gesture for AudioContext
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)()
        if (audioCtx.state === 'suspended') audioCtx.resume()
        var osc = audioCtx.createOscillator()
        var gain = audioCtx.createGain()
        osc.connect(gain); gain.connect(audioCtx.destination)
        osc.type = 'sine'
        osc.frequency.setValueAtTime(523, audioCtx.currentTime)
        osc.frequency.setValueAtTime(784, audioCtx.currentTime + 0.08)
        gain.gain.setValueAtTime(0.12, audioCtx.currentTime)
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.35)
        osc.start(audioCtx.currentTime); osc.stop(audioCtx.currentTime + 0.35)
      } catch(_) {}
    }

    // ── Cleanup on unload ──
    window.addEventListener('beforeunload', function() {
      destroyed = true
      if (reconnectTimer) clearTimeout(reconnectTimer)
      if (ws) { ws.onclose = null; ws.close(); ws = null }
      if (audioCtx) { audioCtx.close().catch(function(){ /* cleanup — ignore errors on unload */ }); audioCtx = null }
    })

    // ── Listen for storage changes (logout clears localStorage) ──
    window.addEventListener('storage', function(e) {
      if (e.key === 'ws_access_token' && !e.newValue) {
        destroyed = true
        if (reconnectTimer) clearTimeout(reconnectTimer)
        if (ws) { ws.onclose = null; ws.close(); ws = null }
      }
    })

    document.addEventListener('DOMContentLoaded', connect)
    if (document.readyState !== 'loading') connect()
  })()
</script>
