---
const { title, description, image, url } = Astro.props

const siteTitle = title || 'Vyntra Academic'
const siteDesc = description || 'Plataforma académica del Colegio Técnico Ciudad del Sol — Sogamoso, Boyacá, Colombia'
const siteImage = image || 'https://vyntraacademic.netlify.app/og-image.png'
const siteUrl = url || 'https://vyntraacademic.netlify.app'
---

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={siteDesc} />
<meta property="og:image" content={siteImage} />
<meta property="og:url" content={siteUrl} />
<meta property="og:locale" content="es_CO" />
<meta property="og:site_name" content="Vyntra Academic" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={siteTitle} />
<meta name="twitter:description" content={siteDesc} />
<meta name="twitter:image" content={siteImage} />

<!-- Schema.org School -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "School",
  "name": "Colegio Técnico Ciudad del Sol",
  "url": "https://colegiociudaddelsol.edu.co",
  "description": "Institución educativa técnica en Sogamoso, Boyacá, Colombia",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Sogamoso",
    "addressRegion": "Boyacá",
    "addressCountry": "CO"
  },
})} />

<!-- Canonical -->
<link rel="canonical" href={siteUrl} />

<!-- Additional meta -->
<meta name="application-name" content="Vyntra Academic" />
<meta name="theme-color" content="#800000" />
