---
export interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'gold' | 'danger'
  size?: 'sm' | 'md' | 'lg'
  href?: string
  type?: 'button' | 'submit' | 'reset'
  disabled?: boolean
  class?: string
  wide?: boolean
  loading?: boolean
  ariaLabel?: string
  id?: string
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  class: extraClass = '',
  wide = false,
  loading = false,
  ariaLabel,
  id,
} = Astro.props

const base = 'inline-flex items-center justify-center gap-2 font-semibold transition-all duration-300 ease-spring active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold relative overflow-hidden'

const sizes = {
  sm: 'px-3 py-1.5 text-xs rounded-lg',
  md: 'px-5 py-2.5 text-sm rounded-[10px]',
  lg: 'px-8 py-3.5 text-base rounded-xl',
}

const variants = {
  primary: 'bg-gradient-to-br from-brand-maroon to-brand-maroon-light text-white hover:shadow-glow-maroon hover:-translate-y-0.5',
  secondary: 'bg-solar-100 dark:bg-solar-shadow/10 text-text dark:text-text border border-brand-maroon/10 dark:border-brand-gold/10 hover:bg-solar-200 dark:hover:bg-solar-shadow/20',
  ghost: 'text-text-secondary hover:text-text hover:bg-brand-maroon/5 dark:hover:bg-brand-gold/5',
  gold: 'bg-gradient-to-br from-brand-gold to-brand-amber text-solar-shadow font-bold hover:shadow-glow hover:-translate-y-0.5',
  danger: 'bg-brand-danger/10 text-brand-danger hover:bg-brand-danger/20 border border-brand-danger/20',
}

const styles = `${base} ${sizes[size]} ${variants[variant]} ${wide ? 'w-full' : ''} ${disabled || loading ? 'opacity-50 pointer-events-none cursor-not-allowed' : ''} ${extraClass}`
---

{href ? (
  <a href={href} class={styles} aria-label={ariaLabel}>
    <slot />
  </a>
) : (
  <button type={type} class={styles} disabled={disabled || loading} aria-label={ariaLabel} id={id}>
    {loading && (
      <span class="h-4 w-4 border-2 border-current/30 border-t-current rounded-full animate-spin-slow shrink-0"></span>
    )}
    <slot />
  </button>
)}
