---
export interface Props {
  variant?: 'maroon' | 'gold' | 'green' | 'red' | 'blue' | 'amber' | 'neutral'
  size?: 'xs' | 'sm' | 'md'
  class?: string
}

const {
  variant = 'maroon',
  size = 'sm',
  class: extraClass = '',
} = Astro.props

const variants: Record<string, string> = {
  maroon: 'bg-brand-maroon/10 text-brand-maroon dark:bg-brand-maroon/20 dark:text-brand-gold-light',
  gold: 'bg-brand-gold/15 text-brand-gold-dark dark:text-brand-gold-light',
  green: 'bg-success/15 text-success',
  red: 'bg-brand-danger/15 text-brand-danger',
  blue: 'bg-brand-info/15 text-brand-info',
  amber: 'bg-brand-amber/15 text-brand-amber',
  neutral: 'bg-solar-100 dark:bg-solar-shadow/10 text-text-secondary dark:text-text-secondary',
}

const sizes: Record<string, string> = {
  xs: 'px-2 py-0.5 text-[10px]',
  sm: 'px-2.5 py-1 text-xs',
  md: 'px-3 py-1.5 text-sm',
}
---

<span class={`inline-flex items-center gap-1 rounded-full font-semibold tracking-wide uppercase ${variants[variant]} ${sizes[size]} ${extraClass}`}>
  <slot />
</span>
