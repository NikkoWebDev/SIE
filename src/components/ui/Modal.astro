---
export interface Props {
  id?: string
  open?: boolean
  title?: string
  size?: 'sm' | 'md' | 'lg'
  class?: string
  closeOnBackdrop?: boolean
}

const {
  id = 'modal-overlay',
  open = false,
  title = '',
  size = 'md',
  class: extraClass = '',
  closeOnBackdrop = true,
} = Astro.props

const sizes = {
  sm: 'max-w-sm',
  md: 'max-w-md sm:max-w-lg',
  lg: 'max-w-lg sm:max-w-2xl',
}
---

<div id={id} class={`modal-overlay ${open ? 'active' : ''} fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-black/40 backdrop-blur-sm transition-opacity duration-300 ${extraClass}`} role="dialog" aria-modal="true" aria-label={title}>
  <div class={`${sizes[size]} w-full sm:w-[95%] mx-auto bg-[var(--bg-card)] dark:bg-surface-dark-elevated border border-border rounded-2xl sm:rounded-2xl rounded-b-none shadow-modal dark:shadow-modal-dark p-6 max-h-[85vh] overflow-y-auto transform transition-all duration-300 animate-scale-in`}>
    {title && (
      <div class="flex items-center justify-between mb-5">
        <h2 class="font-bold text-lg text-brand-maroon dark:text-brand-gold-light">{title}</h2>
        <button class="p-1.5 rounded-lg hover:bg-brand-gold/10 transition-colors text-text-tertiary hover:text-text" onclick={`document.getElementById('${id}').classList.remove('active')`} aria-label="Cerrar">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    )}
    <slot />
    <div class="flex justify-end gap-3 mt-5 pt-4 border-t border-border">
      <slot name="footer" />
    </div>
  </div>
</div>
