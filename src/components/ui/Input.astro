---
export interface Props {
  id?: string
  name?: string
  type?: string
  placeholder?: string
  value?: string
  required?: boolean
  disabled?: boolean
  autocomplete?: string
  class?: string
  classWrap?: string
  min?: string | number
  max?: string | number
  step?: string | number
  inputMode?: string
  pattern?: string
  rows?: number
  ariaLabel?: string
}

const {
  id,
  name,
  type = 'text',
  placeholder = '',
  value,
  required = false,
  disabled = false,
  autocomplete,
  class: extraClass = '',
  classWrap = '',
  min,
  max,
  step,
  inputMode,
  pattern,
  rows,
  ariaLabel,
} = Astro.props

const isTextarea = type === 'textarea'
const inputClass = `w-full bg-[var(--input-bg)] border border-[var(--input-border)] rounded-lg text-text placeholder:text-text-tertiary/60 transition-all duration-200 outline-none disabled:opacity-50 disabled:cursor-not-allowed ${
  isTextarea ? 'px-4 py-3 resize-y' : 'px-4 py-2.5 text-sm'
} focus:border-brand-maroon dark:focus:border-brand-gold focus:shadow-[0_0_0_3px_var(--input-focus-ring)] ${extraClass}`
---

<div class={classWrap}>
  {isTextarea ? (
    <textarea
      id={id} name={name}
      placeholder={placeholder}
      required={required}
      disabled={disabled}
      class={inputClass}
      aria-label={ariaLabel}
      rows={rows || 3}
    >{value || ''}</textarea>
  ) : type === 'select' ? (
    <select
      id={id} name={name}
      required={required}
      disabled={disabled}
      class={inputClass}
      aria-label={ariaLabel}
    >
      <slot />
    </select>
  ) : (
    <input
      id={id} name={name}
      type={type}
      placeholder={placeholder}
      value={value}
      required={required}
      disabled={disabled}
      autocomplete={autocomplete}
      class={inputClass}
      inputMode={inputMode}
      pattern={pattern}
      min={min}
      max={max}
      step={step}
      aria-label={ariaLabel}
    />
  )}
</div>
