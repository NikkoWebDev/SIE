---
export interface Props {
  hover?: boolean
  variant?: 'default' | 'accent' | 'gold' | 'danger'
  class?: string
  padding?: 'sm' | 'md' | 'lg'
  id?: string
}

const {
  hover = true,
  variant = 'default',
  class: extraClass = '',
  padding = 'md',
  id,
} = Astro.props

const borders = {
  default: 'border border-border hover:border-border-hover',
  accent: 'border border-brand-maroon/15 hover:border-brand-maroon/30 dark:border-brand-gold/10 dark:hover:border-brand-gold/25',
  gold: 'border border-brand-gold/30 hover:border-brand-gold/60',
  danger: 'border border-brand-danger/20 hover:border-brand-danger/40',
}

const paddings = {
  sm: 'p-3',
  md: 'p-5 md:p-6',
  lg: 'p-6 md:p-8',
}

const bg = variant === 'danger'
  ? 'bg-brand-danger/5 dark:bg-brand-danger/5'
  : 'bg-[var(--bg-card)] dark:bg-surface-dark-card'

const shadow = variant === 'danger'
  ? 'shadow-sm'
  : 'shadow-card dark:shadow-card-dark'

const hoverStyle = hover
  ? 'hover:shadow-card-hover dark:hover:shadow-card-dark-hover hover:-translate-y-1 transition-all duration-300 ease-out'
  : ''
---

<div class={`relative rounded-xl overflow-hidden ${borders[variant]} ${paddings[padding]} ${bg} ${shadow} ${hoverStyle} ${extraClass}`} id={id}>
  <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-brand-maroon to-brand-gold opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
  <div class="absolute bottom-0 right-0 w-10 h-10 bg-gradient-to-bl from-brand-gold/5 to-transparent rounded-tl-xl pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
  <slot />
</div>
