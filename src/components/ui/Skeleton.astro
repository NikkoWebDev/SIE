---
export interface Props {
  variant?: 'text' | 'card' | 'circle' | 'bar'
  width?: string
  height?: string
  class?: string
}

const {
  variant = 'text',
  width,
  height,
  class: extraClass = '',
} = Astro.props

const base = 'skeleton-shimmer rounded-lg'
---

{variant === 'text' && (
  <div class={`${base} ${width || 'w-3/4'} ${height || 'h-4'} ${extraClass}`} aria-hidden="true"></div>
)}
{variant === 'card' && (
  <div class={`${base} ${width || 'w-full'} ${height || 'h-28'} ${extraClass}`} aria-hidden="true"></div>
)}
{variant === 'circle' && (
  <div class={`${base} rounded-full ${width || 'w-10'} ${height || 'h-10'} ${extraClass}`} aria-hidden="true"></div>
)}
{variant === 'bar' && (
  <div class={`${base} ${width || 'w-full'} ${height || 'h-2.5'} ${extraClass}`} aria-hidden="true"></div>
)}
