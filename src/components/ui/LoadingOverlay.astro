---
export interface Props {
  show?: boolean
  label?: string
}

const { show = false, label = 'Cargando' } = Astro.props
---

<div id="loading-overlay" class={`${show ? 'flex' : 'hidden'} fixed inset-0 z-50 items-center justify-center bg-black/40 backdrop-blur-sm`} role="alert" aria-busy="true">
  <div class="flex flex-col items-center gap-4 px-8 py-6 bg-[var(--bg-card)] dark:bg-surface-dark-elevated border border-border rounded-2xl shadow-modal dark:shadow-modal-dark animate-scale-in">
    <div class="h-8 w-8 border-2 border-brand-maroon/20 border-t-brand-maroon dark:border-brand-gold/20 dark:border-t-brand-gold rounded-full animate-spin-slow"></div>
    <span class="font-semibold text-sm text-text-secondary tracking-wide uppercase">{label}</span>
  </div>
</div>
