---
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000'
---

<div id="ai-admin-root" class="fixed bottom-6 right-6 z-50" data-api-url={apiUrl}>
  <button id="ai-admin-toggle"
    class="flex h-14 w-14 items-center justify-center rounded-full bg-brand-gold text-white shadow-2xl shadow-brand-gold/20 transition-all duration-300 hover:scale-105 hover:shadow-brand-gold/30 active:scale-95"
    aria-label="Abrir Asistente Administrativo">
    <svg id="admin-icon-chat" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
    <svg id="admin-icon-close" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>

  <div id="ai-admin-panel"
    class="absolute bottom-16 right-0 w-[380px] sm:w-[440px] h-[560px] rounded-2xl border border-white/10 bg-black/90 backdrop-blur-2xl shadow-2xl flex flex-col overflow-hidden origin-bottom-right transition-all duration-300 opacity-0 scale-95 pointer-events-none">
    <div class="flex items-center gap-3 border-b border-white/10 bg-gradient-to-r from-amber-700 to-amber-700/90 px-5 py-4 shrink-0">
      <div class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10">
        <svg class="h-5 w-5 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
      <div class="flex-1 min-w-0">
        <h3 class="text-sm font-semibold text-white">Asistente Administrativo · VYNTRA</h3>
        <p class="text-xs text-amber-300/70 truncate">Gestión financiera y reportes estratégicos</p>
      </div>
      <span class="flex items-center gap-1.5 text-[10px] text-amber-400">
        <span class="h-1.5 w-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        En línea
      </span>
    </div>

    <div id="admin-messages" class="flex-1 overflow-y-auto p-4 space-y-4 text-sm bg-gray-950">
      <div class="flex items-start gap-3 animate-slide-up">
        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-amber-500/20 text-xs font-bold text-amber-400">A</div>
        <div class="rounded-2xl rounded-tl-sm bg-white/5 border border-white/10 px-4 py-3 text-gray-300 leading-relaxed">
          <p>Bienvenido. Soy el <strong class="text-amber-400">Asistente Administrativo VYNTRA</strong>. Puedo ayudarte con el análisis financiero del colegio, reportes de morosidad, estados de pago y toma de decisiones estratégicas. ¿En qué puedo ayudarte hoy?</p>
        </div>
      </div>
    </div>

    <div id="admin-typing" class="hidden px-4 pb-2">
      <div class="flex items-start gap-3">
        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-amber-500/20 text-xs font-bold text-amber-400">A</div>
        <div class="rounded-2xl bg-white/5 border border-white/10 px-4 py-3">
          <div class="flex gap-1.5">
            <span class="h-2 w-2 rounded-full bg-amber-400/60 animate-bounce" style="animation-delay:0ms"></span>
            <span class="h-2 w-2 rounded-full bg-amber-400/60 animate-bounce" style="animation-delay:150ms"></span>
            <span class="h-2 w-2 rounded-full bg-amber-400/60 animate-bounce" style="animation-delay:300ms"></span>
          </div>
        </div>
      </div>
    </div>

    <div class="border-t border-white/10 bg-black/50 px-4 py-3 shrink-0">
      <form id="admin-form" class="flex gap-2">
        <input
          id="admin-input"
          type="text"
          placeholder="Consulta financiera, reporte o análisis..."
          class="flex-1 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm text-gray-200 placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-amber-700/40 focus:border-amber-700/60 transition-all"
        />
        <button
          id="admin-send"
          type="submit"
          class="flex items-center justify-center rounded-xl bg-amber-700 px-4 py-2.5 text-white transition-all hover:bg-amber-700/80 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed shrink-0"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
        </button>
      </form>
    </div>
  </div>
</div>

<script define:vars={{ apiUrl }}>
  (function () {
    var root = document.getElementById('ai-admin-root')
    var toggle = document.getElementById('ai-admin-toggle')
    var panel = document.getElementById('ai-admin-panel')
    var chatIcon = document.getElementById('admin-icon-chat')
    var closeIcon = document.getElementById('admin-icon-close')
    var messages = document.getElementById('admin-messages')
    var form = document.getElementById('admin-form')
    var input = document.getElementById('admin-input')
    var sendBtn = document.getElementById('admin-send')
    var typing = document.getElementById('admin-typing')

    var isOpen = false
    var token = localStorage.getItem('access_token')
    var userId = localStorage.getItem('userId')
    var adminName = localStorage.getItem('userName') || 'Administrador'

    toggle.addEventListener('click', function () {
      isOpen = !isOpen
      panel.classList.toggle('opacity-0', !isOpen)
      panel.classList.toggle('scale-95', !isOpen)
      panel.classList.toggle('pointer-events-none', !isOpen)
      panel.classList.toggle('opacity-100', isOpen)
      panel.classList.toggle('scale-100', isOpen)
      panel.classList.toggle('pointer-events-auto', isOpen)
      chatIcon.classList.toggle('hidden', isOpen)
      closeIcon.classList.toggle('hidden', !isOpen)
      if (isOpen) scrollToBottom()
    })

    function scrollToBottom() {
      messages.scrollTop = messages.scrollHeight
    }

    function addMessage(content, role) {
      var div = document.createElement('div')
      div.className = 'flex items-start gap-3 ' + (role === 'user' ? 'flex-row-reverse' : '') + ' animate-slide-up'
      var avatar = document.createElement('div')
      avatar.className = 'flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-bold ' +
        (role === 'user' ? 'bg-amber-700 text-white' : 'bg-amber-500/20 text-amber-400')
      avatar.textContent = role === 'user' ? 'A' : 'V'
      var bubble = document.createElement('div')
      bubble.className = 'rounded-2xl px-4 py-3 leading-relaxed max-w-[85%] ' +
        (role === 'user'
          ? 'rounded-tr-sm bg-amber-700 text-white'
          : 'rounded-tl-sm bg-white/5 border border-white/10 text-gray-300')
      bubble.textContent = content
      div.appendChild(avatar)
      div.appendChild(bubble)
      messages.appendChild(div)
      scrollToBottom()
      return bubble
    }

    function addStreamingMessage() {
      var div = document.createElement('div')
      div.className = 'flex items-start gap-3 animate-slide-up'
      var avatar = document.createElement('div')
      avatar.className = 'flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-amber-500/20 text-xs font-bold text-amber-400'
      avatar.textContent = 'V'
      var bubbleContainer = document.createElement('div')
      bubbleContainer.className = 'rounded-2xl rounded-tl-sm bg-white/5 border border-white/10 px-4 py-3 text-gray-300 leading-relaxed'
      bubbleContainer.id = 'admin-streaming-bubble'
      div.appendChild(avatar)
      div.appendChild(bubbleContainer)
      messages.appendChild(div)
      scrollToBottom()
      return bubbleContainer
    }

    function renderMarkdown(text) {
      var html = text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/\*\*(.+?)\*\*/g, '<strong class="text-amber-400">$1</strong>')
        .replace(/\*(.+?)\*/g, '<em>$1</em>')
        .replace(/`(.+?)`/g, '<code class="bg-amber-700/20 text-amber-300 px-1 py-0.5 rounded text-xs font-mono">$1</code>')
        .replace(/\n/g, '<br>')
      return html
    }

    async function buildContext() {
      var ctx = 'Nombre del administrador: ' + adminName + '. '
      try {
        var statsRes = await fetch(apiUrl + '/api/admin/stats', {
          headers: { 'Authorization': 'Bearer ' + token }
        })
        if (statsRes.ok) {
          var stats = await statsRes.json()
          if (stats) {
            ctx += 'Total estudiantes: ' + (stats.total_students || stats.total || 'desconocido') + '. '
            ctx += 'Estudiantes al día: ' + (stats.paid || stats.al_dia || 'desconocido') + '. '
            ctx += 'Estudiantes en mora: ' + (stats.unpaid || stats.en_mora || 'desconocido') + '. '
          }
        }
      } catch (_) {}
      try {
        var studentsRes = await fetch(apiUrl + '/api/admin/students', {
          headers: { 'Authorization': 'Bearer ' + token }
        })
        if (studentsRes.ok) {
          var students = await studentsRes.json()
          if (students && students.length > 0) {
            var paid = students.filter(function (s) { return s.is_paid !== false }).length
            var unpaid = students.filter(function (s) { return s.is_paid === false }).length
            ctx += 'Cobertura de pagos: ' + paid + ' al día, ' + unpaid + ' en mora. '
          }
        }
      } catch (_) {}
      return ctx
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault()
      var text = input.value.trim()
      if (!text) return
      input.value = ''
      sendBtn.disabled = true
      addMessage(text, 'user')
      typing.classList.remove('hidden')
      scrollToBottom()

      var context = await buildContext()
      var bubble = addStreamingMessage()
      typing.classList.add('hidden')

      try {
        var res = await fetch(apiUrl + '/api/ai/admin-assistant', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
          body: JSON.stringify({ message: text, context: context }),
        })
        if (!res.ok) {
          bubble.innerHTML = '<span class="text-brand-danger">Error al conectar con el asistente.</span>'
          sendBtn.disabled = false
          return
        }
        var reader = res.body.getReader()
        var decoder = new TextDecoder()
        var buffer = ''
        var fullText = ''
        while (true) {
          var result = await reader.read()
          if (result.done) break
          buffer += decoder.decode(result.value, { stream: true })
          var lines = buffer.split('\n')
          buffer = lines.pop() || ''
          for (var i = 0; i < lines.length; i++) {
            var line = lines[i]
            if (line.startsWith('data: ')) {
              var data = line.slice(6)
              if (data === '[DONE]') continue
              try {
                var parsed = JSON.parse(data)
                if (parsed.token) {
                  fullText += parsed.token
                  bubble.innerHTML = renderMarkdown(fullText)
                  scrollToBottom()
                } else if (parsed.error) {
                  bubble.innerHTML = '<span class="text-brand-danger">' + parsed.error + '</span>'
                }
              } catch (_) {}
            }
          }
        }
        if (!fullText) {
          bubble.innerHTML = '<span class="text-gray-500">El asistente no generó respuesta. Intenta reformular tu consulta.</span>'
        }
      } catch (_) {
        bubble.innerHTML = '<span class="text-brand-danger">Error de conexión. Verifica tu red e intenta de nuevo.</span>'
      }
      sendBtn.disabled = false
    })
  })()
</script>
