const cfg = configs[role]
---

<aside
  id={`vyntra-sidebar-${role}`}
  class={`sidebar-${role} fixed left-0 top-0 z-40 h-full w-60 bg-[var(--bg)] dark:bg-surface-dark border-r border-border transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-out overflow-y-auto overflow-x-hidden flex flex-col ${extraClass || ''}`}
  role="navigation"
  aria-label="Navegación principal"
>
  <div class="flex items-center gap-2.5 px-5 py-5 border-b border-border shrink-0">
    <div class={`w-8 h-8 rounded-lg ${cfg.accent} text-white flex items-center justify-center text-xs font-extrabold shrink-0`}>V</div>
    <span class="text-sm font-bold tracking-tight">VYNTRA</span>
    <span class="ml-auto text-[10px] font-bold uppercase tracking-widest text-text-tertiary">{cfg.label}</span>
  </div>

  <nav class="flex-1 overflow-y-auto py-3 px-2.5 space-y-0.5" aria-label="Secciones">
    {cfg.sections.map(s => (
      <button
        data-section-id={s.id}
        class={`sidebar-link w-full flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium transition-all duration-200 text-text-secondary hover:text-text hover:bg-brand-maroon/5 dark:hover:bg-brand-gold/5 ${activeSection === s.id ? 'active bg-brand-maroon/8 dark:bg-brand-gold/10 text-brand-maroon dark:text-brand-gold-light font-semibold border-l-[3px] border-brand-maroon dark:border-brand-gold' : 'border-l-[3px] border-transparent'}`}
        onclick={`window.dispatchEvent(new CustomEvent('vyntra:navigate', { detail: { section: '${s.id}' }}))`}
      >
        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={s.icon}/>
        </svg>
        {s.label}
      </button>
    ))}
  </nav>

  <div class="shrink-0 border-t border-border p-3">
    <div class="flex items-center gap-2.5 px-2 py-2 rounded-lg bg-brand-maroon/5 dark:bg-brand-gold/5">
      <div class={`w-7 h-7 rounded-full ${cfg.accent} text-white flex items-center justify-center text-[11px] font-bold shrink-0`}>{userName.charAt(0).toUpperCase() || (role === 'admin' ? 'A' : role === 'teacher' ? 'D' : 'V')}</div>
      <div class="min-w-0 flex-1">
        <div class="text-[11px] font-semibold truncate" id={`sidebar-username-${role}`}>{userName || 'Usuario'}</div>
        <div class="text-[10px] text-text-tertiary" id={`sidebar-metadata-${role}`}>{userGrade || ''}</div>
      </div>
    </div>
  </div>

  <div class="shrink-0 border-t border-border px-3 py-2 flex gap-1">
    <button id={`theme-toggle-${role}`} class="flex items-center gap-2 w-full px-2.5 py-1.5 rounded-lg text-[11px] font-medium text-text-secondary hover:text-text hover:bg-brand-gold/10 transition-colors" aria-label="Cambiar tema visual">
      <svg class="h-3.5 w-3.5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
      <svg class="h-3.5 w-3.5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
      <span id={`theme-label-${role}`} class="dark:hidden">Modo oscuro</span>
      <span id={`theme-label-${role}-light`} class="hidden dark:inline">Modo claro</span>
    </button>
    <button onclick="localStorage.clear();window.location.href='/'" class="flex items-center justify-center w-9 h-8 rounded-lg text-text-tertiary hover:text-brand-danger hover:bg-brand-danger/10 transition-colors text-xs" title="Salir">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9"/></svg>
    </button>
  </div>
</aside>

<div id={`sidebar-overlay-${role}`} class="fixed inset-0 z-30 bg-black/40 backdrop-blur-sm hidden lg:!hidden" aria-hidden="true"></div>

<script define:vars={{ role }}>
  document.addEventListener('DOMContentLoaded', () => {
    const sidebar = document.getElementById('vyntra-sidebar-' + role)
    window.addEventListener('vyntra:navigate', (e) => {
      const section = (e).detail.section
      if (!section) return
      sidebar?.querySelectorAll('[data-section-id]').forEach(btn => {
        const sid = btn.getAttribute('data-section-id')
        const isActive = sid === section
        btn.classList.toggle('active', isActive)
        btn.classList.toggle('bg-brand-maroon/8', isActive)
        btn.classList.toggle('dark:bg-brand-gold/10', isActive)
        btn.classList.toggle('text-brand-maroon', isActive)
        btn.classList.toggle('dark:text-brand-gold-light', isActive)
        btn.classList.toggle('font-semibold', isActive)
        btn.classList.toggle('border-transparent', !isActive)
        btn.classList.toggle('border-l-brand-maroon', isActive)
        btn.classList.toggle('dark:border-l-brand-gold', isActive)
        if (isActive) btn.setAttribute('aria-current', 'page')
        else btn.removeAttribute('aria-current')
      })
    })
  })
</script>
