---
export interface Props {
  size?: number
  animated?: boolean
  class?: string
}

const { size = 64, animated = false, class: className = '' } = Astro.props
const uid = `logo-${crypto.randomUUID().slice(0, 8)}`
---

<svg
  class={className + (animated ? ' animate-logo-breathe' : '')}
  width={size}
  height={size * (206/256)}
  viewBox="0 0 256 206"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-label="VYNTRA Solaris"
  role="img"
>
  <defs>
    <linearGradient id={`${uid}-sol-grad`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#F5A623" />
      <stop offset="60%" stop-color="#FFD166" />
      <stop offset="100%" stop-color="#C47F0A" />
    </linearGradient>
    <linearGradient id={`${uid}-book-grad`} x1="0" y1="1" x2="1" y2="0">
      <stop offset="0%" stop-color="#6B1A1A" />
      <stop offset="100%" stop-color="#8B2A2A" />
    </linearGradient>
    <radialGradient id={`${uid}-sol-glow`} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0%" stop-color="#F5A623" stop-opacity="0.3" />
      <stop offset="100%" stop-color="#F5A623" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- Outer glow ring -->
  <circle cx="128" cy="112" r="96" fill={`url(#${uid}-sol-glow)`} />

  <!-- Solar corona rays (8 minimalist rays alternating sizes) -->
  {[0, 45, 90, 135, 180, 225, 270, 315].map((angle, i) => (
    <line
      x1={128 + 52 * Math.cos(angle * Math.PI / 180)}
      y1={112 + 52 * Math.sin(angle * Math.PI / 180)}
      x2={128 + (i % 2 === 0 ? 75 : 68) * Math.cos(angle * Math.PI / 180)}
      y2={112 + (i % 2 === 0 ? 75 : 68) * Math.sin(angle * Math.PI / 180)}
      stroke={`url(#${uid}-sol-grad)`}
      stroke-width="1.5"
      stroke-linecap="round"
      opacity="0.4"
    />
  ))}

  <!-- Book (base, below sun) -->
  <g transform="translate(128, 188)">
    <!-- Book spine -->
    <rect x="-30" y="-12" width="60" height="24" rx="3" fill={`url(#${uid}-book-grad)`} />
    <!-- Left page -->
    <path d="M-2 -12 L-30 -6 L-30 12 L-2 12 Z" fill="#FFFBF0" opacity="0.15" />
    <!-- Right page -->
    <path d="M2 -12 L30 -6 L30 12 L2 12 Z" fill="#FFFBF0" opacity="0.2" />
    <!-- Center fold line -->
    <line x1="0" y1="-12" x2="0" y2="12" stroke="#6B1A1A" stroke-width="1" opacity="0.5" />
    <!-- Bookmark ribbon dropping from center -->
    <path d="M-3 12 L0 20 L3 12 Z" fill={`url(#${uid}-sol-grad)`} opacity="0.85" />
  </g>

  <!-- Sun circle (center) -->
  <circle cx="128" cy="112" r="38" fill={`url(#${uid}-sol-grad)`} />
  <!-- Sun inner highlight -->
  <circle cx="128" cy="112" r="28" fill="#FFD166" opacity="0.35" />
  <!-- Sun core -->
  <circle cx="128" cy="112" r="14" fill="#FFFBF0" opacity="0.55" />

  <!-- V monogram (inside sun core) -->
  <text x="128" y="119" text-anchor="middle" font-family="Fraunces, serif" font-weight="900" font-size="18" fill="#6B1A1A" opacity="0.65">V</text>
</svg>
