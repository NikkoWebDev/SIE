---
export interface Props {
  studentId: string
  isPaid: boolean
  nombre: string
  grado: string
}
const { studentId, isPaid, nombre, grado } = Astro.props
const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://backend-colegio-hdx7.onrender.com'
---
<div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-4 flex items-center gap-3 transition-all hover:shadow-sm" data-student-row={studentId}>
  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-maroon/10 dark:bg-brand-maroon/20 text-sm font-bold text-brand-maroon dark:text-brand-gold">
    {nombre.charAt(0).toUpperCase()}
  </div>
  <div class="flex-1 min-w-0">
    <p class="text-sm font-medium text-gray-900 dark:text-white truncate">{nombre}</p>
    <p class="text-xs text-gray-400 truncate">ID: {studentId} · {grado}</p>
  </div>
  <div class="flex items-center gap-2 shrink-0">
    <span class={"text-[10px] font-bold uppercase tracking-wider " + (isPaid ? 'text-brand-green' : 'text-brand-danger')}>
      {isPaid ? 'Pagado' : 'En mora'}
    </span>
    <label class="relative inline-flex h-6 w-11 cursor-pointer items-center">
      <input type="checkbox" class="peer sr-only" checked={isPaid} data-student={studentId} data-endpoint={apiUrl + '/api/admin/students/' + encodeURIComponent(studentId) + '/financial'} />
      <span class="absolute inset-0 rounded-full bg-gray-300 dark:bg-gray-700 peer-checked:bg-brand-green transition-colors duration-300"></span>
      <span class="absolute left-0.5 h-5 w-5 rounded-full bg-white shadow-sm transition-all duration-300 peer-checked:translate-x-5"></span>
    </label>
  </div>
</div>
<script define:vars={{ apiUrl }}>
  document.querySelectorAll('[data-student-row] input[type=checkbox]').forEach(function (cb) {
    cb.addEventListener('change', async function () {
      var studentId = cb.getAttribute('data-student')
      var endpoint = apiUrl + '/api/admin/students/' + encodeURIComponent(studentId) + '/financial'
      var token = localStorage.getItem('auth_token')
      var newStatus = cb.checked
      try {
        var res = await fetch(endpoint, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
          body: JSON.stringify({ is_paid: newStatus }),
        })
        if (!res.ok) throw new Error()
        localStorage.setItem('is_paid', String(newStatus))
        var span = cb.closest('[data-student-row]').querySelector('span.font-bold')
        if (span) {
          span.textContent = newStatus ? 'Pagado' : 'En mora'
          span.className = 'text-[10px] font-bold uppercase tracking-wider ' + (newStatus ? 'text-brand-green' : 'text-brand-danger')
        }
      } catch (_) {
        cb.checked = !newStatus
      }
    })
  })
</script>
