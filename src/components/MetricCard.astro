---
export interface Props {
  label: string
  value: number
}
const { label, value } = Astro.props
const colorClass = value >= 4.0 ? 'text-[#00FF66]' : value >= 3.5 ? 'text-[#FFE600]' : 'text-[#FF0055]'
const barColor = value >= 4.0 ? 'bg-[#00FF66]' : value >= 3.5 ? 'bg-[#FFE600]' : 'bg-[#FF0055]'
---
<div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 transition-all hover:shadow-md animate-slide-up">
  <div class="flex items-center justify-between mb-3">
    <span class="text-sm font-medium text-gray-700 dark:text-gray-300">{label}</span>
    <span class={"text-lg font-bold " + colorClass}>{value.toFixed(1)}</span>
  </div>
  <div class="h-2.5 rounded-full bg-gray-200 dark:bg-gray-700 overflow-hidden">
    <div class={"h-full rounded-full transition-all duration-1000 ease-out " + barColor} style={`width: ${(value / 5) * 100}%`}></div>
  </div>
</div>
